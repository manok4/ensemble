#!/usr/bin/env bash
# sync-shared — push canonical files from shared/ into the skills that read them.
#
# EN12. Every skill directory is self-contained: it holds its own copy of every
# reference, template and script it reads, so a skill folder works wherever it
# lands. shared/ is the single edit point and is a BUILD INPUT — never installed,
# never read at runtime.
#
# Usage:
#   scripts/sync-shared              write the copies
#   scripts/sync-shared --check      verify only; write nothing (what CI runs)
#   scripts/sync-shared --root DIR   operate on DIR instead of the repo root
#
# Exit: 0 clean · 1 drift or violation · 2 usage/config error.
#
# Copies are byte-for-byte with mode bits preserved and NOTHING injected.
# Generated-ness is recorded only in shared/manifest.json. An injected header
# would break byte parity by construction, and above a shebang it would stop a
# script executing at all. The do-not-edit warning therefore lives INSIDE the
# canonical file in shared/, where it travels as part of the bytes.

set -u

ROOT=""
MANIFEST=""
MODE="write"
QUIET="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE="check"; shift ;;
    --root) ROOT="$2"; shift 2 ;;
    --manifest) MANIFEST="$2"; shift 2 ;;
    --quiet) QUIET="true"; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "sync-shared: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$ROOT" ]; then
  ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
  [ -n "$ROOT" ] || ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"
fi
[ -d "$ROOT" ] || { echo "sync-shared: no such root: $ROOT" >&2; exit 2; }
[ -n "$MANIFEST" ] || MANIFEST="$ROOT/shared/manifest.json"

command -v jq >/dev/null 2>&1 || { echo "sync-shared: jq is required" >&2; exit 2; }

if [ ! -f "$MANIFEST" ]; then
  # Not an error: before U2 lands there is nothing to sync.
  [ "$QUIET" = "true" ] || echo "sync-shared: no manifest at $MANIFEST — nothing to do"
  exit 0
fi
jq -e . "$MANIFEST" >/dev/null 2>&1 || { echo "sync-shared: $MANIFEST is not valid JSON" >&2; exit 2; }

VIOLATIONS=0
say()   { [ "$QUIET" = "true" ] || echo "$*"; }
viol()  { echo "  ✗ $*" >&2; VIOLATIONS=$((VIOLATIONS + 1)); }

# Siblings a bash script pulls in by sourcing, e.g.  . "$_epi_dir/ensemble-cli-smoke"
# Only the basename is taken: the script self-locates, so the variable is noise.
_siblings() {
  grep -oE '^[[:space:]]*(\.|source)[[:space:]]+"?\$[A-Za-z_][A-Za-z0-9_]*/[A-Za-z0-9._-]+"?' "$1" 2>/dev/null \
    | sed -E 's#.*/([A-Za-z0-9._-]+)"?$#\1#' | sort -u
}

# A script plus everything it sources, transitively. Prints basenames.
#
# Callers use this in a command substitution, so anything it raises with viol()
# would increment VIOLATIONS in a SUBSHELL and be discarded — the parent would
# print the error and still exit 0. Missing siblings are therefore recorded to a
# file the parent reads afterwards, via _closure_faults.
_closure() {
  local dir="$1" name="$2" seen="$3"
  case " $seen " in *" $name "*) return 0 ;; esac
  echo "$name"; seen="$seen $name"
  local sib
  for sib in $(_siblings "$dir/$name"); do
    if [ ! -f "$dir/$sib" ]; then
      echo "closure: $name sources '$sib', absent from $(basename "$dir")/" >> "$CLOSURE_FAULTS"
      continue
    fi
    _closure "$dir" "$sib" "$seen"
  done
}

CLOSURE_FAULTS="$(mktemp)"
trap 'rm -f "$CLOSURE_FAULTS"' EXIT INT TERM HUP

# Raise anything _closure recorded, in the PARENT shell where it counts.
_drain_closure_faults() {
  [ -s "$CLOSURE_FAULTS" ] || return 0
  while IFS= read -r f; do viol "$f"; done < <(sort -u "$CLOSURE_FAULTS")
  : > "$CLOSURE_FAULTS"
}

# One source→destination copy. Compares in check mode, writes otherwise.
place() {
  local src="$1" dst="$2" skill="$3"
  if [ ! -f "$src" ]; then viol "manifest names a missing source: ${src#$ROOT/}"; return; fi
  if [ "$MODE" = "check" ]; then
    if [ ! -f "$dst" ]; then
      viol "missing generated file: ${dst#$ROOT/} (run scripts/sync-shared)"
    elif ! cmp -s "$src" "$dst"; then
      viol "drift: ${dst#$ROOT/} differs from ${src#$ROOT/}"
      viol "       do not edit the generated copy — change ${src#$ROOT/}, then run scripts/sync-shared"
    else
      # Symmetric: an ADDED executable bit is drift too. The documented promise
      # is that a copy matches its source, not merely that it is runnable.
      src_x=no; dst_x=no
      [ -x "$src" ] && src_x=yes
      [ -x "$dst" ] && dst_x=yes
      [ "$src_x" = "$dst_x" ] || viol "mode drift: ${dst#$ROOT/} executable=$dst_x, source is $src_x (run scripts/sync-shared)"
    fi
  else
    mkdir -p "$(dirname "$dst")"
    cp -p "$src" "$dst" || viol "could not write ${dst#$ROOT/}"
  fi
  [ -z "$skill" ] || GRANTED="$GRANTED
$skill|$(basename "$src")"
}

GRANTED=""

# Publish entries: a generated copy OUTSIDE skills/, for consumers that read at
# install time rather than at runtime. The plugin manifests need a directory
# that exists in an installed plugin, and pointing them at shared/ would make
# the build input part of the shipped artifact. A published directory is a build
# OUTPUT: generated from shared/, committed, and safe for a manifest to name.
while IFS='|' read -r source dest; do
  [ -n "${source:-}" ] || continue
  place "$ROOT/shared/$source" "$ROOT/${dest}$(basename "$source")" ""
done < <(jq -r '.publish[]? | "\(.source)|\(.dest)"' "$MANIFEST")

while IFS='|' read -r source dest closure skill; do
  [ -n "${source:-}" ] || continue
  skill_dir="$ROOT/skills/$skill"
  if [ ! -d "$skill_dir" ]; then
    viol "manifest grants '$source' to '$skill', which is not a skill directory"
    continue
  fi
  src_dir="$(dirname "$ROOT/shared/$source")"
  base="$(basename "$source")"
  if [ "$closure" = "true" ]; then
    for member in $(_closure "$src_dir" "$base" ""); do
      place "$src_dir/$member" "$skill_dir/${dest}${member}" "$skill"
    done
  else
    place "$ROOT/shared/$source" "$skill_dir/${dest}${base}" "$skill"
  fi
done < <(jq -r '.entries[] | "\(.source)|\(.dest)|\(.closure // false)|\(.skills[])"' "$MANIFEST")

# --- checks that only make sense once the tree is in its target shape ---
if [ "$MODE" = "check" ]; then
  for skill_dir in "$ROOT"/skills/*/; do
    [ -d "$skill_dir" ] || continue
    skill="$(basename "$skill_dir")"

    # Every bare-relative asset path a skill names must resolve inside it.
    #
    # This was gated on the skill not mentioning ENSEMBLE_ROOT, so the check
    # went live per skill as it migrated. The gate searched the WHOLE skill
    # directory including generated copies, so one copied file mentioning the
    # variable would have silently disabled the check for that skill. The
  # migration finished in U8 — no skill mentions it any more — so the gate is
  # gone rather than narrowed: a conditional nobody needs is a trap waiting
  # for the condition to come back.
    # references/templates/agents only. `scripts/` is deliberately excluded:
    # skills legitimately name repo-level scripts (en-setup points at
    # `scripts/check-health` in the user's project), and a bundled script
    # resolving correctly is proven by executing it in U6's smoke test, which
    # is a stronger check than asserting the file exists.
    while IFS= read -r ref; do
      [ -n "$ref" ] || continue
      [ -e "$skill_dir$ref" ] || viol "$skill names \`$ref\` but no such file in skills/$skill/"
    done < <(grep -rhoE '`(references|templates|agents)/[A-Za-z0-9._/-]+`' "$skill_dir" 2>/dev/null \
               | tr -d '`' | sort -u)

    # A grant nobody reads is dead weight; fail so the manifest cannot rot.
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in "$skill|"*) ;; *) continue ;; esac
      name="${line#*|}"
      # Match the filename OR the stem: a skill names an agent as
      # `repo-research`, not `repo-research.md`, so filename-only matching
      # would report every agent grant as unused.
      stem="${name%.*}"
      if ! grep -rqF "$name" "$skill_dir" 2>/dev/null \
         && ! grep -rqF "$stem" "$skill_dir" 2>/dev/null; then
        viol "manifest grants '$name' to $skill, but $skill never names it"
      fi
    done < <(printf '%s\n' "$GRANTED" | sort -u)
  done
fi

_drain_closure_faults

# Advisory: shared files no manifest entry grants to anyone.
if [ "$MODE" = "check" ]; then
  granted_sources="$(jq -r '(.entries[]?.source), (.publish[]?.source)' "$MANIFEST" | sort -u)"
  orphans=""
  while IFS= read -r f; do
    rel="${f#$ROOT/shared/}"
    printf '%s\n' "$granted_sources" | grep -qxF "$rel" || orphans="$orphans $rel"
  done < <(find "$ROOT/shared" -type f ! -name 'manifest.json' ! -name 'README.md')
  [ -z "$orphans" ] || say "sync-shared: note — granted to nobody:$orphans"
fi

if [ "$VIOLATIONS" -gt 0 ]; then
  echo "sync-shared: $VIOLATIONS problem(s)" >&2
  exit 1
fi
say "sync-shared: clean ($MODE)"
exit 0
