#!/usr/bin/env bash
# setup — machine-level install for Ensemble.
# Detects which host CLIs are present (~/.claude/, ~/.codex/), then symlinks or copies
# skills and agents into each detected host's directory.
#
# Usage: ./setup [--host claude|codex|both|auto] [--symlink|--copy] [--verify-only] [--quiet]

set -eu

SOURCE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST_PREF="auto"
COPY_MODE="symlink"
VERIFY_ONLY="false"
QUIET="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --host) HOST_PREF="$2"; shift 2 ;;
    --symlink) COPY_MODE="symlink"; shift ;;
    --copy) COPY_MODE="copy"; shift ;;
    --verify-only) VERIFY_ONLY="true"; shift ;;
    --quiet) QUIET="true"; shift ;;
    -h|--help)
      cat <<EOF
Usage: ./setup [--host claude|codex|both|auto] [--symlink|--copy] [--verify-only] [--quiet]

  --host          Override host detection (default: auto)
  --symlink       Force symlink (default on macOS/Linux)
  --copy          Force copy (default on Windows or when symlink unavailable)
  --verify-only   Run dependency + install checks without making changes
  --quiet         Suppress non-error output
EOF
      exit 0
      ;;
    *) echo "Unknown flag: $1" >&2; exit 2 ;;
  esac
done

log() {
  [ "$QUIET" = "true" ] || echo "$@"
}

err() {
  echo "ERROR: $*" >&2
  exit 2
}

# Detect platform — Windows-style env (Git Bash, WSL) prefers copy mode by default
case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*) [ "$COPY_MODE" = "symlink" ] && COPY_MODE="copy" ;;
esac

# Detect host CLIs
HAS_CLAUDE_CLI=false; command -v claude >/dev/null 2>&1 && HAS_CLAUDE_CLI=true
HAS_CODEX_CLI=false;  command -v codex  >/dev/null 2>&1 && HAS_CODEX_CLI=true
HAS_CLAUDE_DIR=false; [ -d "$HOME/.claude" ] && HAS_CLAUDE_DIR=true
HAS_CODEX_DIR=false;  [ -d "$HOME/.codex" ]  && HAS_CODEX_DIR=true

# Resolve host preference
case "$HOST_PREF" in
  auto)
    INSTALL_CLAUDE=$($HAS_CLAUDE_DIR && echo true || echo false)
    INSTALL_CODEX=$($HAS_CODEX_DIR && echo true || echo false)
    if [ "$INSTALL_CLAUDE" = "false" ] && [ "$INSTALL_CODEX" = "false" ]; then
      # In --verify-only mode, fall through with a warning so dependency checks
      # still run. CI environments and bare installers commonly hit this.
      if [ "$VERIFY_ONLY" = "true" ]; then
        log "  ⚠ No host CLI directories found (~/.claude or ~/.codex)."
        log "    Verify-only mode continues to check dependencies; install will be a no-op."
      else
        err "No host CLI directories found (~/.claude or ~/.codex). Install at least one CLI first."
      fi
    fi
    ;;
  claude) INSTALL_CLAUDE=true; INSTALL_CODEX=false ;;
  codex)  INSTALL_CLAUDE=false; INSTALL_CODEX=true ;;
  both)   INSTALL_CLAUDE=true; INSTALL_CODEX=true ;;
  *) err "Invalid --host value: $HOST_PREF (use claude, codex, both, auto)" ;;
esac

log "Ensemble installer"
log "  Source:        $SOURCE_DIR"
log "  Mode:          $COPY_MODE"
log "  Install Claude: $INSTALL_CLAUDE"
log "  Install Codex:  $INSTALL_CODEX"
log ""

# Verify dependencies
log "Checking dependencies..."
command -v git >/dev/null 2>&1 && log "  git: ✓" || err "git is required"
command -v gh  >/dev/null 2>&1 && log "  gh: ✓"  || log "  gh: ⚠ (optional but recommended for /en-ship)"
command -v jq  >/dev/null 2>&1 && log "  jq: ✓"  || log "  jq: ⚠ (optional but recommended for config parsing)"
log ""

# Single-agent fallback notice
if $HAS_CLAUDE_CLI && $HAS_CODEX_CLI; then
  log "Both Claude Code and Codex CLIs detected. Full cross-agent peer review available."
elif $HAS_CLAUDE_CLI || $HAS_CODEX_CLI; then
  ONE=$($HAS_CLAUDE_CLI && echo claude || echo codex)
  OTHER=$($HAS_CLAUDE_CLI && echo codex || echo claude)
  log "Only $ONE CLI detected."
  log "Ensemble will run cross-review as single-agent fallback (fresh instance of $ONE)."
  log "For full cross-agent peer review, install $OTHER as well — it's not required, but recommended."
  log ""
else
  log "Neither claude nor codex CLI detected on PATH."
  log "Skills and agents will be installed in directories detected (~/.claude/, ~/.codex/),"
  log "but you'll need to install at least one CLI to actually use them."
  log ""
fi

# Shared-tree parity. Each skill directory carries its own copy of every
# reference, script and agent it reads, generated from shared/ by
# scripts/sync-shared. If someone edited shared/ without re-running the sync,
# the copies are stale — and installing them would hand every host a mixture of
# old and new, silently. Refuse instead: the fix is one command, and a wrong
# install is far more expensive to notice than a failed one.
if [ -x "$SOURCE_DIR/scripts/sync-shared" ]; then
  if ! "$SOURCE_DIR/scripts/sync-shared" --root "$SOURCE_DIR" --check --quiet >/dev/null 2>&1; then
    log ""
    log "✗ The skill copies are out of sync with shared/."
    "$SOURCE_DIR/scripts/sync-shared" --root "$SOURCE_DIR" --check 2>&1 | sed 's/^/    /' | head -12
    log ""
    log "  Run:  scripts/sync-shared"
    log "  Then re-run ./setup. Nothing has been installed."
    exit 1
  fi
  log "Shared-tree parity: clean"
fi

if [ "$VERIFY_ONLY" = "true" ]; then
  log "--verify-only: stopping after checks. No files written."
  exit 0
fi

install_into() {
  local target_root="$1"  # e.g., $HOME/.claude
  local label="$2"

  log "Installing into $target_root ($label)..."
  mkdir -p "$target_root/skills" "$target_root/agents"

  # Per-target manifest tracks what this install owns (one path per line).
  # Lets us cleanly remove Ensemble's prior install on re-run without touching
  # any unrelated user-installed skills or agents.
  local manifest_dir="$HOME/.ensemble"
  mkdir -p "$manifest_dir"
  local target_slug
  target_slug="$(basename "$target_root")"  # ".claude" -> "claude" after stripping leading dot below
  target_slug="${target_slug#.}"
  local manifest_file="$manifest_dir/install-manifest-$target_slug.txt"

  # Sweep the prior install. Every path the manifest names was written by an
  # earlier Ensemble run, so mode is irrelevant to whether we may remove it.
  #
  # This used to require the CURRENT run to be in copy mode before deleting a
  # real directory, which asks the wrong question: what matters is what was
  # installed, not what is being installed now. Re-running with --symlink after
  # a --copy install therefore left every copied directory in place, the
  # "already exists, not ours" guard skipped them, and the user got a silent
  # no-op that looked like a successful reinstall.
  if [ -f "$manifest_file" ]; then
    while IFS= read -r prior_path; do
      [ -n "$prior_path" ] || continue
      # Refuse to walk outside the directories this installer owns, so a
      # corrupted or hand-edited manifest cannot turn into an arbitrary rm -rf.
      case "$prior_path" in
        "$target_root"/skills/*|"$target_root"/agents/*) ;;
        *) log "  ⚠ manifest lists a path outside $target_root/{skills,agents}; ignoring: $prior_path"
           continue ;;
      esac
      if [ -L "$prior_path" ]; then
        rm -f "$prior_path"
      elif [ -e "$prior_path" ]; then
        rm -rf "$prior_path"
      fi
    done < "$manifest_file"
  fi

  # Record the new install to a temp file and move it into place at the end.
  # Truncating up front meant a run that swept and then skipped everything left
  # an EMPTY manifest, orphaning paths no later run would ever clean up. Keeping
  # the old manifest until the new one is complete means a failed run still
  # leaves something that can sweep.
  local manifest_tmp
  manifest_tmp="$(mktemp "$manifest_dir/.install-manifest-$target_slug.XXXXXX")"

  # Skills: one symlink (or copy) per skill folder, placed directly under
  # ~/.<host>/skills/<skill-name>/. Hosts discover skills as <skills-root>/<skill>/SKILL.md;
  # nesting under .../ensemble/ would hide them from discovery.
  local skill_count=0
  for skill_path in "$SOURCE_DIR/skills"/*/; do
    [ -d "$skill_path" ] || continue
    local skill_name
    skill_name="$(basename "$skill_path")"
    local dst="$target_root/skills/$skill_name"

    if [ -e "$dst" ] || [ -L "$dst" ]; then
      log "  ⚠ $dst already exists (not from a prior Ensemble install); skipping. Rename or remove it manually to install."
      continue
    fi

    if [ "$COPY_MODE" = "copy" ]; then
      cp -R "$skill_path" "$dst"
    else
      ln -s "${skill_path%/}" "$dst"
    fi
    echo "$dst" >> "$manifest_tmp"
    skill_count=$((skill_count + 1))
  done
  log "  Installed $skill_count skill(s) into $target_root/skills/ ($COPY_MODE)"

  # Agents: published from the SKILLS that carry them, not from a central
  # directory. Hosts resolve subagent_type from a flat registry, so a skill
  # directory installed on its own would otherwise dispatch an agent that is
  # installed nowhere — the bundled copies would be present and never read.
  # Publishing from skills/*/agents/ makes installing one skill publish exactly
  # that skill's agents. The union is collision-free because every copy is
  # byte-identical to its source and scripts/sync-shared --check enforces it,
  # so two skills publishing repo-research.md write the same bytes and the
  # result does not depend on install order.
  local agent_count=0
  for agent_file in "$SOURCE_DIR"/skills/*/agents/*.md; do
    [ -f "$agent_file" ] || continue
    local agent_name
    agent_name="$(basename "$agent_file")"
    local dst="$target_root/agents/$agent_name"

    if [ -e "$dst" ] || [ -L "$dst" ]; then
      # Already published by an earlier skill this run: identical bytes, so this
      # is the expected union case, not a conflict. Anything else is a foreign
      # file and is left alone.
      if grep -qxF "$dst" "$manifest_tmp" 2>/dev/null; then
        continue
      fi
      log "  ⚠ $dst already exists (not from a prior Ensemble install); skipping."
      continue
    fi

    if [ "$COPY_MODE" = "copy" ]; then
      cp "$agent_file" "$dst"
    else
      ln -s "$agent_file" "$dst"
    fi
    echo "$dst" >> "$manifest_tmp"
    agent_count=$((agent_count + 1))
  done
  log "  Installed $agent_count agent(s) into $target_root/agents/ ($COPY_MODE)"

  # Publish the manifest only now that the install is complete.
  mv "$manifest_tmp" "$manifest_file"

  log ""
}


[ "$INSTALL_CLAUDE" = "true" ] && install_into "$HOME/.claude" "Claude Code"
[ "$INSTALL_CODEX"  = "true" ] && install_into "$HOME/.codex"  "Codex"

# Ensure ~/.ensemble/config.json exists AND carries the current default keys.
# EN11: this previously ran only when the file was ABSENT, so any machine that
# had already run setup never received keys added in later releases. It now
# MERGES missing keys into an existing file. User values always win.
CONFIG_DIR="$HOME/.ensemble"
CONFIG_FILE="$CONFIG_DIR/config.json"
mkdir -p "$CONFIG_DIR"

# `null` means "unset, ladder governs" — bin/ensemble-config-get treats null as
# absent, so shipping the keys present-but-null keeps them discoverable in the
# file without shadowing a lower precedence layer.
config_defaults() {
  cat <<'EOF'
{
  "peer_mode_override": "auto",
  "peer_reject_behavior": "pause",
  "peer_timeout_seconds": 600,
  "skip_peer_below_lines": 50,
  "skip_peer_on_lightweight": true,
  "default_branch_fallback": "main",
  "learnings_cross_project": false,
  "review_peer_model_alias": null,
  "review_peer_effort_override": null
}
EOF
}

if [ ! -f "$CONFIG_FILE" ]; then
  config_defaults > "$CONFIG_FILE"
  log "Created $CONFIG_FILE with defaults"
elif ! command -v jq >/dev/null 2>&1; then
  log "  ⚠ jq not found; leaving $CONFIG_FILE unchanged."
  log "    Add these keys by hand if absent: review_peer_model_alias, review_peer_effort_override"
else
  # Merge defaults into the existing file: defaults first, existing second, so
  # `.[0] * .[1]` lets every user value (and any unknown user-added key) win.
  # Atomicity requires ALL of: a temp file in the SAME directory as the
  # destination (a cross-filesystem mv is not atomic), jq output validated as a
  # non-empty object BEFORE it replaces anything, mv only after that validation,
  # and the original left untouched on every failure path.
  cfg_tmp=""
  # The trap is the guarantee, not the explicit rm: an interrupt or unexpected
  # exit between mktemp and mv would otherwise strand a .config.json.* artifact
  # despite the documented no-stray-temp contract.
  cleanup_cfg_tmp() { [ -z "${cfg_tmp:-}" ] || rm -f "$cfg_tmp"; }
  if cfg_tmp=$(mktemp "$CONFIG_DIR/.config.json.XXXXXX" 2>/dev/null); then
    trap cleanup_cfg_tmp EXIT INT TERM HUP
    if config_defaults | jq -s '.[0] * .[1]' - "$CONFIG_FILE" > "$cfg_tmp" 2>/dev/null \
       && [ -s "$cfg_tmp" ] \
       && jq -e 'type == "object" and (keys | length) > 0' "$cfg_tmp" >/dev/null 2>&1; then
      if mv "$cfg_tmp" "$CONFIG_FILE" 2>/dev/null; then
        cfg_tmp=""
        log "  Config: $CONFIG_FILE has all current keys"
      else
        log "  ⚠ Could not replace $CONFIG_FILE; left unchanged."
      fi
    else
      log "  ⚠ Could not merge defaults into $CONFIG_FILE (unreadable, malformed, or not a JSON object); left unchanged."
    fi
    cleanup_cfg_tmp
    cfg_tmp=""
    trap - EXIT INT TERM HUP
  fi
fi

# Smoke-test CLI flags if CLIs are present. The probe + failure classifier live
# in a shared, sourceable helper (EN10) so the drift test exercises the REAL
# classifier. On failure it distinguishes flag drift from an un-authenticated
# CLI (a fresh machine is not a flag mismatch).
# shellcheck source=shared/bin/ensemble-cli-smoke
. "$SOURCE_DIR/shared/bin/ensemble-cli-smoke"
if [ "$QUIET" != "true" ]; then
  log "CLI smoke test (verifies references/cli-wrappers.md matches your installed CLI)..."
  # claude -p supports --max-turns; codex exec does not (single-shot) — EN10.
  $HAS_CLAUDE_CLI && ensemble_smoke_probe "Claude CLI" claude -p --output-format json --max-turns 1 "ping"
  $HAS_CODEX_CLI && ensemble_smoke_probe "Codex CLI" codex exec --json "ping"
  log ""
fi

log "Done. Next steps:"
log "  1. Open a project in your host CLI"
log "  2. Run /en-setup to bootstrap Ensemble for that project"
