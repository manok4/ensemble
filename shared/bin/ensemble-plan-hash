#!/usr/bin/env bash
# ensemble-plan-hash — the single implementation of `peer_review_plan_hash`.
#
# /en-plan writes this value at promotion; /en-build adopts it as the build's
# baseline and re-computes at every phase boundary, refusing to advance on
# mismatch (skills/en-build/SKILL.md steps 4a and 215).
#
# It exists because the contract was previously prose only
# (docs/scope-aware-slicing-spec.md:374). Two agents each canonicalizing from
# that prose cannot be expected to agree — and no model can compute sha256 in
# the first place, so each run would shell out with its own ad-hoc
# canonicalization. A hash whose producer and consumer disagree does not detect
# tampering; it just refuses a legitimate build at the first phase boundary and
# blames the user for editing the plan. One implementation, called by both.
#
# Usage:
#   ensemble-plan-hash <plan-path>          # print the hash
#   ensemble-plan-hash --canon <plan-path>  # print the canonical form (debugging)
#
# Covered (immutable plan inputs): per unit, in U-ID order as written —
#   Goal, Files, Approach, Risk, Category, Gated, Dependencies
# plus plan-level `depth` and `data_scale`.
#
# Excluded (mutable, managed by /en-build): the iteration log, per-unit status,
# and peer_review_resolutions. Editing any of those must NOT change the hash.

set -u

CANON_ONLY="false"
PLAN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --canon) CANON_ONLY="true"; shift ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "ensemble-plan-hash: unknown flag: $1" >&2; exit 2 ;;
    *) PLAN="$1"; shift ;;
  esac
done

if [ -z "$PLAN" ]; then
  echo "ensemble-plan-hash: a plan path is required" >&2
  exit 2
fi
if [ ! -f "$PLAN" ]; then
  echo "ensemble-plan-hash: no such plan: $PLAN" >&2
  exit 2
fi

# Canonicalization, kept deliberately dull so it is reproducible by inspection:
#   - one line per unit: <U-ID>|goal|files|approach|risk|category|gated|deps
#   - field values have runs of whitespace collapsed to one space and are trimmed
#   - a field absent from a unit contributes an empty string, never a skipped field
#   - units appear in the order they occur in the file
#   - a final line: <depth>|<data_scale>
# Whitespace collapsing is what lets a reflow of a hashed field not read as a
# semantic edit; anything beyond that is a real change and must move the hash.
_canon() {
  awk '
    function flush(   i) {
      if (uid == "") return
      printf "%s|%s|%s|%s|%s|%s|%s|%s\n", uid, f["Goal"], f["Files"], f["Approach"], \
             f["Risk"], f["Category"], f["Gated"], f["Dependencies"]
      uid = ""
      for (i in f) delete f[i]
    }
    function val(line,   v) {
      sub(/^- \*\*[A-Za-z ]+:\*\*[[:space:]]*/, "", line)
      gsub(/[[:space:]]+/, " ", line)
      gsub(/^ | $/, "", line)
      return line
    }
    # Frontmatter: first two --- delimited lines.
    /^---[[:space:]]*$/ { dashes++; next }
    dashes == 1 && /^depth:/      { depth = val_fm($0, "depth"); next }
    dashes == 1 && /^data_scale:/ { scale = val_fm($0, "data_scale"); next }
    function val_fm(line, key,   v) {
      sub("^" key ":[[:space:]]*", "", line)
      gsub(/[[:space:]]+/, " ", line); gsub(/^ | $/, "", line)
      return line
    }
    /^### U[0-9]+\./ {
      flush()
      match($0, /U[0-9]+/); uid = substr($0, RSTART, RLENGTH)
      next
    }
    # A level-2 heading ends the units section, so trailing prose that happens to
    # use the same bullet labels (the plan template prescribes "- **Risk:** ... "
    # under "## Decisions, assumptions & risks") cannot bleed into the last unit.
    /^## / { flush(); next }
    uid != "" && /^- \*\*(Goal|Files|Approach|Risk|Category|Gated|Dependencies):\*\*/ {
      match($0, /\*\*[A-Za-z]+:/)
      key = substr($0, RSTART + 2, RLENGTH - 3)
      if (!(key in f)) f[key] = val($0)   # first occurrence wins
      next
    }
    END { flush(); printf "%s|%s\n", depth, scale }
  ' "$PLAN"
}

if [ "$CANON_ONLY" = "true" ]; then
  _canon
  exit 0
fi

if command -v shasum >/dev/null 2>&1; then
  _canon | shasum -a 256 | awk '{print $1}'
elif command -v sha256sum >/dev/null 2>&1; then
  _canon | sha256sum | awk '{print $1}'
else
  echo "ensemble-plan-hash: need shasum or sha256sum on PATH" >&2
  exit 3
fi
