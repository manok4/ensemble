#!/usr/bin/env bash
# ensemble-build-peer-prompt — assemble the Outside Voice prompt from args.
#
# Skills shell out to this instead of constructing the prompt by reasoning,
# which is several times slower in agent-tool-call terms. The prompt template
# is the slim version from references/outside-voice.md.
#
# Usage:
#   ensemble-build-peer-prompt \
#     --artifact-type <code|plan|markdown artifact|mixed> \
#     --project-context <one-line> \
#     --goal <one-line> \
#     --artifact-file <path>           # OR --artifact-stdin (read from stdin)
#     [--peer-mode <cross-agent|single-agent-fallback>]   # default: cross-agent
#     [--iteration-context-file <path>]                   # optional re-review context
#
# Output: the assembled prompt to stdout. Exit 0 on success.
#
# IMPORTANT — invocation pattern:
#   Pipe stdout DIRECTLY into the peer subprocess via stdin. Do NOT capture
#   into a shell variable and re-pass via argv — that hits ARG_MAX on large
#   artifacts and produces silent hangs in the peer subprocess (observed in
#   the field). Wrap the peer in `timeout` and capture stderr for diagnosis.
#
#   Auth contract: Ensemble peer review uses the host user's Claude
#   subscription (OAuth / claude.ai / keychain). Do NOT use Claude's --bare
#   flag — it bypasses OAuth/keychain and reads only ANTHROPIC_API_KEY,
#   producing "Not logged in · Please run /login" on subscription-only
#   hosts. We trade some startup overhead for working subscription auth.
#
#   Canonical (Claude as peer):
#     # Resolve a timeout binary (BSD macOS doesn't ship one; coreutils
#     # provides gtimeout via Homebrew). Fail fast if neither — running
#     # peer review unwrapped re-enables the silent-hang failure from PR #9.
#     ENSEMBLE_TIMEOUT_BIN=$(command -v timeout || command -v gtimeout) || {
#       echo "ERROR: peer review requires 'timeout' or 'gtimeout' on PATH" >&2
#       echo "  Install on macOS: brew install coreutils" >&2
#       exit 1
#     }
#
#     ENSEMBLE_PEER_REVIEW=true ensemble-build-peer-prompt ... \
#       | "$ENSEMBLE_TIMEOUT_BIN" "${peer_timeout_seconds:-600}" \
#           claude -p --output-format json --max-turns 1 \
#             --strict-mcp-config \
#             --mcp-config '{"mcpServers":{}}' \
#             --disable-slash-commands \
#             --no-session-persistence \
#             --setting-sources project \
#             --tools '' \
#           > /tmp/peer-response.json 2>/tmp/peer-stderr.log
#
#   Required on PATH:
#     - timeout OR gtimeout (GNU coreutils). macOS: brew install coreutils.
#       Linux distros typically ship coreutils by default. Without it,
#       peer review fails fast with the install instruction — never runs
#       unwrapped.
#
#   Notes:
#     - --mcp-config takes inline JSON; the schema requires the
#       mcpServers key, so `{"mcpServers":{}}` is the minimum valid
#       empty form. Plain `{}` fails schema validation.
#     - --setting-sources project (NOT user): user-level config often
#       carries the LSP plugin which fires a tool call and consumes
#       --max-turns 1 before producing JSON output.
#     - --tools '' is load-bearing: disables ALL built-in tools so
#       the peer can't make tool calls regardless of settings, AND
#       enforces D30 (peer reports, never acts) mechanically.
#
#   These flags suppress what we can WITHOUT --bare. Hooks, LSP load,
#   plugin sync, CLAUDE.md auto-discovery still run on startup but
#   cannot fire tool calls. See references/outside-voice.md for the
#   full rationale.
#
#   ANTI-PATTERNS (do not use):
#     prompt=$(ensemble-build-peer-prompt ...)
#     claude -p ... "$prompt"      # ← ARG_MAX hazard, silent hangs
#     ... | claude --bare -p ...   # ← bypasses subscription auth
#     ... | timeout 600 claude ... # ← bare `timeout` fails on macOS
#                                  #    without coreutils (use the
#                                  #    $ENSEMBLE_TIMEOUT_BIN resolution)
#     ... | claude -p ...          # ← dropping timeout silently
#                                  #    re-enables the PR #9 hang regression

set -u

ARTIFACT_TYPE=""
PROJECT_CONTEXT=""
GOAL=""
ARTIFACT_FILE=""
ARTIFACT_STDIN="false"
PEER_MODE="cross-agent"
ITERATION_CONTEXT_FILE=""

usage() {
  sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --artifact-type)            ARTIFACT_TYPE="$2"; shift 2 ;;
    --project-context)          PROJECT_CONTEXT="$2"; shift 2 ;;
    --goal)                     GOAL="$2"; shift 2 ;;
    --artifact-file)            ARTIFACT_FILE="$2"; shift 2 ;;
    --artifact-stdin)           ARTIFACT_STDIN="true"; shift ;;
    --peer-mode)                PEER_MODE="$2"; shift 2 ;;
    --iteration-context-file)   ITERATION_CONTEXT_FILE="$2"; shift 2 ;;
    -h|--help)                  usage ;;
    *) echo "unknown flag: $1" >&2; usage ;;
  esac
done

# Validate required args
[ -z "$ARTIFACT_TYPE" ]    && { echo "missing --artifact-type" >&2; exit 2; }
[ -z "$PROJECT_CONTEXT" ]  && { echo "missing --project-context" >&2; exit 2; }
[ -z "$GOAL" ]             && { echo "missing --goal" >&2; exit 2; }
if [ -z "$ARTIFACT_FILE" ] && [ "$ARTIFACT_STDIN" != "true" ]; then
  echo "missing --artifact-file or --artifact-stdin" >&2; exit 2
fi
case "$PEER_MODE" in
  cross-agent|single-agent-fallback) ;;
  *) echo "invalid --peer-mode: $PEER_MODE (use cross-agent or single-agent-fallback)" >&2; exit 2 ;;
esac

# Resolve ARTIFACT_BODY
if [ "$ARTIFACT_STDIN" = "true" ]; then
  ARTIFACT_BODY=$(cat)
else
  if [ ! -f "$ARTIFACT_FILE" ]; then
    echo "artifact file not found: $ARTIFACT_FILE" >&2; exit 2
  fi
  ARTIFACT_BODY=$(cat "$ARTIFACT_FILE")
fi

# Conditional: single-agent fallback note
if [ "$PEER_MODE" = "single-agent-fallback" ]; then
  SINGLE_AGENT_NOTE="(Single-agent fallback: you're a fresh instance of the same model that wrote this. Be aggressive — bias toward finding problems the original instance rationalized away.)"
else
  SINGLE_AGENT_NOTE=""
fi

# Conditional: plan-specific review dimensions
if [ "$ARTIFACT_TYPE" = "plan" ]; then
  PLAN_REVIEW_DIMENSIONS="
Plan review dimensions: does the plan build the right thing, and is it safe to run?

A. Does it achieve the goal? Read GOAL, then the units. Flag work the goal needs that no unit covers, and units that serve no stated goal.
B. Unit decomposition. Flag units too large to review or commit atomically, units that should have been split (auth/payments/migrations always stand alone), and independent concerns fused into one unit.
C. Test scenarios. Every feature-bearing unit needs real scenarios with concrete inputs and expected outcomes across happy path, edge cases and error paths — not \"tests pass\". A feature unit with none, or with vague ones, is P1.
D. risk: correctness. Cross-check against each unit's approach (DROP/TRUNCATE/mass-DELETE → destructive; backfills over large row counts → high). Misclassified destructive units are P0/P1.
E. Dependency-vs-phase violations (a low-risk unit depending on a higher-risk one).
F. gated: correctness. gated is for production-state-changing units only (customer-facing flag flips, production backfills, real-side-effect 3rd-party APIs, API contract breaks, production config changes). Flag gated:true on an internal/UI rename, refactor, test addition, or new code behind an off flag — over-gating trains users to autopilot through prompts and erodes signal value. Equally flag missing gated:true on units that DO change production state.
G. Stated assumptions. Flag anything the plan bets on without saying so, especially claims that something does not already exist.

Do NOT flag: prose style, heading format, markdown formatting, unit ID numbering, or wording preferences. This is a plan, not a document review."
else
  PLAN_REVIEW_DIMENSIONS=""
fi

# Optional: previous-review-context section for re-review iterations
ITERATION_CONTEXT=""
if [ -n "$ITERATION_CONTEXT_FILE" ]; then
  if [ ! -f "$ITERATION_CONTEXT_FILE" ]; then
    echo "iteration context file not found: $ITERATION_CONTEXT_FILE" >&2; exit 2
  fi
  ITERATION_CONTEXT=$(cat "$ITERATION_CONTEXT_FILE")
fi

# Location hint and u_id field are artifact-type aware: a plan's findings anchor
# to units (en-build dispatches per-unit off u_id), code anchors to file:line.
if [ "$ARTIFACT_TYPE" = "plan" ]; then
  LOCATION_HINT='Use the unit id (e.g. "U3") when the finding is about a unit, the section name for plan-level issues, or "global".'
  U_ID_FIELD='  u_id            "U<N>" when the finding is about a specific unit, else null.
                  The host dispatches per-unit off this field, so set it
                  whenever the finding belongs to a unit.'
else
  LOCATION_HINT='Use "<file>:<line>" for code, the section name for docs, or "global".'
  U_ID_FIELD=""
fi

# Emit the prompt
cat <<PROMPT_EOF
Peer review of a $ARTIFACT_TYPE. You are the REPORTER, not the fixer:
read the artifact, return structured JSON findings only. Do NOT edit files,
run commands, make commits, or take any action. The host applies findings.
$SINGLE_AGENT_NOTE

PROJECT: $PROJECT_CONTEXT
GOAL: $GOAL
$PLAN_REVIEW_DIMENSIONS
ARTIFACT:
---
$ARTIFACT_BODY
---
$( [ -n "$ITERATION_CONTEXT" ] && printf '\n## Previous review context\n\nFindings you raised on an earlier pass, and what the host did with each:\n\n%s\n' "$ITERATION_CONTEXT" )

SEVERITY — use these, do not invent your own:
  P0 blocking: data loss, security hole, broken core flow, unmigrated API break
  P1 must change before work proceeds: logic bug, missing required test, uncovered requirement
  P2 fix soon: missing edge-case test, naming inconsistency, minor gap
  P3 advisory: preference, cosmetic, "consider X later"
P0/P1 trigger another review round. Grading a preference P1 wastes one.

Return a single JSON object. Required keys:
verdict ("approve"|"revise"|"reject"), peer_mode (echo "$PEER_MODE"),
summary (2-3 sentences), findings[].

Each finding requires:
  finding_id      "<pass>-<index>", e.g. "1-3". Re-raising something from
                  "## Previous review context"? reuse ITS id.
  severity        P0|P1|P2|P3 (above)   confidence  1-10   title  short
  location        $LOCATION_HINT
  why_it_matters  1-2 sentences
  suggested_fix   what the host should change — describe, never apply
$( [ -n "$U_ID_FIELD" ] && printf '%s\n' "$U_ID_FIELD" )Also return coverage: {"reviewed": "...", "not_reviewed": "..."} — say plainly
if you did not get through it all. A partial review reported as complete is
worse than a short one.

Rules:
- Critique only; suppress confidence<5 unless severity P0.
- Output JSON only — no prose, no markdown fences, outside the JSON object.
- Never re-flag anything "## Previous review context" marks applied, deferred
  or disagreed, without new evidence; to dispute a resolution, say so once
  and reuse its finding_id.
- "verdict: approve" with empty findings[] is right when the artifact is
  solid. Do not manufacture findings to look thorough.
PROMPT_EOF
