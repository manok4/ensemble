#!/usr/bin/env bash
# Runs under bash, as every bundled script is invoked (`bash "$SKILL_DIR/scripts/x"`),
# and re-execs itself under python3. Python reads the next line as a no-op string.
"exec" "python3" "$0" "$@"
# ensemble-test-ledger-verify — refuse a test-audit ledger that does not justify itself.
#
# /en-test-audit deletes tests. The ledger (references/ledger-format.md) is where
# each deletion is justified, and this is the only thing that reads it before the
# commit: the skill commits on exit 0 and on nothing else. It does not trust an
# agent's "I recorded the evidence"; it reads the file, and with --tree the repo.
#
# Usage:
#   ensemble-test-ledger-verify <ledger.md> [--tree]
#
# Without --tree: frontmatter, the ledger table, the rules each mark carries, and
# for every F and C row a caught receipt from ensemble-mutation-check that
# matches its patch; in campaign mode, the Product defects table.
# With --tree, against `baseline_sha` and the working tree as well:
#   - every path the ledger names is inside the repository;
#   - every named declaration existed at baseline in a supported form, and every
#     whole-file row's file did;
#   - every declaration removed since baseline, in a file the ledger names or a
#     changed test file, has a D or C row; an R or F row's test is still there;
#   - a keeper is present in the tree;
#   - campaign: every test file under scope is in exactly one lane and every
#     declaration in it has a row, and after a rebaseline every declaration main
#     added or changed has a `reconciled:` row.
#
# Exit codes:
#   0  valid, silent
#   1  violations, one line each on stdout: `ledger: <test cell>: <rule>`
#   2  unreadable or malformed ledger, or bad arguments (reason on stderr)

import collections, fnmatch, functools, hashlib, json, os, re, subprocess, sys

COLUMNS = ["Test", "Mark", "Keeper or contract", "Evidence", "Mutation"]
PRESERVATION = {"cross-agent", "single-agent-fallback", "skipped-by-flag"}
MARKS = ("R", "F", "C", "D")
DELETION_MARKS = ("C", "D")   # rows whose test must be gone, backed by evidence
PROVEN_MARKS = ("F", "C")     # rows that need a caught mutation

# Supported declaration forms (references/ledger-format.md). Call forms need an
# opening parenthesis and must not be the tail of a longer name or a method call,
# so `x.test("a")`, `submit("a")` and the shell builtin `test "$x"` are not tests.
_QUOTED = r"""(["'`])(.+?)\2"""
DECL_FORMS = [
    re.compile(r"(?<![\w.$])(it|test|describe|context|specify)(?:\.(?:only|skip|todo|concurrent))?\s*\(\s*" + _QUOTED),
    re.compile(r"(?<![\w.$])(t)\.Run\s*\(\s*" + _QUOTED),
    re.compile(r"(?<![\w.$-])(pass)\s+" + _QUOTED),            # shell suites: ... && pass "name"
    re.compile(r"^\s*(@test)\s+" + _QUOTED),                 # bats
]
DECL_DEFS = re.compile(r"^\s*(?:async\s+)?(?:def\s+(test_\w+)|func\s+(Test\w+))")
COMMENT = re.compile(r"^\s*(#|//|\*|/\*|--|;)")
SHA = re.compile(r"^[0-9a-fA-F]{4,64}$")


def die(msg):
    print(f"ensemble-test-ledger-verify: {msg}", file=sys.stderr)
    sys.exit(2)


def parse(path):
    try:
        text = open(path, encoding="utf-8").read()
    except OSError as e:
        die(f"cannot read {path}: {e.strerror}")
    lines = text.splitlines()
    fm = {}
    if lines and lines[0].strip() == "---":
        for i, ln in enumerate(lines[1:], 1):
            if ln.strip() == "---":
                lines = lines[i + 1:]
                break
            m = re.match(r"^([A-Za-z_]+):\s*(.*?)\s*(#.*)?$", ln)
            if m:
                fm[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    sections, cur = {}, None
    for ln in lines:
        if ln.startswith("## "):
            cur = ln[3:].strip()
            sections.setdefault(cur, [])
        elif cur is not None and ln.lstrip().startswith("|"):
            sections[cur].append(ln.strip())
    return fm, sections


def cells(row):
    parts = row.strip().strip("|").split("|")
    return [c.strip().strip("`").strip() for c in parts]


def table(rows, name, width, header=None):
    """Header, separator, then data rows of exactly `width` cells."""
    if not rows:
        return []
    head = cells(rows[0])
    if header and head != header:
        die(f"## {name}: header must be | {' | '.join(header)} |, found | {' | '.join(head)} |")
    out = []
    for r in rows[1:]:
        c = cells(r)
        if all(re.fullmatch(r":?-+:?", x or "-") for x in c):
            continue
        if len(c) != width:
            die(f"## {name}: row has {len(c)} cells, expected {width} (a '|' inside a cell?): {c[0]}")
        out.append(c)
    return out


def git(top, *args):
    r = subprocess.run(["git", "-C", top, *args], capture_output=True, text=True)
    return r.returncode, r.stdout


def blob_id(data):
    """The id `git hash-object` gives these bytes."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def declarations(text):
    """[(name, block)] for every declaration in a supported form, in order.

    A declaration's block runs from its line to the line before the next one; it is
    what a rebaseline compares to tell whether main changed a test.
    """
    found = []
    lines = (text or "").splitlines()
    for i, ln in enumerate(lines):
        if COMMENT.match(ln):
            continue
        for rx in DECL_FORMS:
            found += [(i, m.group(3)) for m in rx.finditer(ln)]
        m = DECL_DEFS.match(ln)
        if m:
            found.append((i, m.group(1) or m.group(2)))
    found.sort(key=lambda x: x[0])
    out = []
    for k, (i, name) in enumerate(found):
        end = found[k + 1][0] if k + 1 < len(found) else len(lines)
        out.append((name, "\n".join(lines[i:end])))
    return out


def names(decls):
    return collections.Counter(n for n, _ in decls)


def split_test(cell):
    return tuple(cell.split("::", 1)) if "::" in cell else (cell, None)


def main(argv):
    args = [a for a in argv if a != "--tree"]
    tree = "--tree" in argv
    if len(args) != 1 or args[0].startswith("-"):
        die("usage: ensemble-test-ledger-verify <ledger.md> [--tree]")
    ledger = args[0]
    fm, sec = parse(ledger)
    if "Ledger" not in sec:
        die("no '## Ledger' table")
    rows = table(sec["Ledger"], "Ledger", 5, COLUMNS)
    ldir = os.path.dirname(os.path.abspath(ledger))

    v = []
    def bad(test, rule):
        v.append(f"ledger: {test}: {rule}")

    for key in ("type", "mode", "scope", "baseline_sha"):
        if not fm.get(key):
            bad("frontmatter", f"{key} is required")
    if fm.get("type") and fm["type"] != "test-audit":
        bad("frontmatter", "type must be test-audit")
    mode = fm.get("mode", "")
    if mode and mode not in ("batch", "campaign"):
        bad("frontmatter", "mode must be batch or campaign")
    if fm.get("preservation_review") not in PRESERVATION:
        bad("frontmatter", "preservation_review must be one of " + ", ".join(sorted(PRESERVATION)))
    if not fm.get("test_glob"):
        bad("frontmatter", "test_glob is required: it is how a deletion in a file the ledger never mentions is found")

    keeper_re = re.compile(r"^[^:\s][^:]*::.+$")
    blank = lambda s: s in ("", "-")
    for test, mark, keeper, evidence, mutation in rows:
        if not test:
            bad("(empty)", "Test cell is empty")
            continue
        if mark not in MARKS:
            bad(test, f"mark '{mark}' is not one of R, F, C, D")
            continue
        if mark in ("R", "F") and blank(keeper):
            bad(test, f"{mark} row must name the contract it guards")
        if mark == "C" and not keeper_re.match(keeper):
            bad(test, "C row needs a keeper as <path>::<name>, not none: or a bare path")
        if mark == "D" and not (keeper_re.match(keeper) or re.match(r"^none:\s*\S", keeper)):
            bad(test, "D row needs a keeper <path>::<name> or 'none: <reason>'")
        if mark in DELETION_MARKS and blank(evidence):
            bad(test, f"{mark} row needs evidence: the proof that remains")
        if mark in PROVEN_MARKS and blank(mutation):
            bad(test, f"{mark} row needs a mutation the keeper catches")
        if not blank(mutation):
            check_mutation(test, os.path.join(ldir, mutation), mutation, bad)

    if mode == "campaign":
        for defect, commit, control in table(sec.get("Product defects", []), "Product defects", 3,
                                             ["Defect", "Fix commit", "Control evidence"]):
            if not commit:
                bad(defect or "(defect)", "product defect needs its fix commit")
            if not control:
                bad(defect or "(defect)", "product defect needs control evidence (the reverted fix going red)")

    if tree:
        v += check_tree(ldir, fm, sec, rows, mode, ledger)

    for line in v:
        print(line)
    return 1 if v else 0


def check_mutation(test, path, cell, bad):
    """The diff exists, and ensemble-mutation-check left a caught receipt for exactly it."""
    if not os.path.isfile(path):
        bad(test, f"mutation {cell} does not exist")
        return
    try:
        receipt = json.load(open(path + ".caught", encoding="utf-8"))
    except (OSError, ValueError):
        bad(test, f"mutation {cell} has no caught receipt; run ensemble-mutation-check on it")
        return
    patch_id = blob_id(open(path, "rb").read())
    if receipt.get("result") != "caught" or receipt.get("patch") != patch_id:
        bad(test, f"mutation {cell}: the receipt is not a caught run of this patch (edited after the check?)")


def check_tree(ldir, fm, sec, rows, mode, ledger_path):
    v = []
    def bad(test, rule):
        v.append(f"ledger: {test}: {rule}")
    rc, top = git(ldir, "rev-parse", "--show-toplevel")
    if rc != 0:
        die("--tree needs the ledger inside a git repository")
    top = os.path.realpath(top.strip())

    def commit(key):
        """A frontmatter revision resolved to a commit id, never handed to git raw."""
        raw = fm.get(key, "")
        if not SHA.match(raw):
            die(f"{key} must be a commit SHA, found {raw!r}")
        rc, out = git(top, "rev-parse", "--verify", "--quiet", "--end-of-options", f"{raw}^{{commit}}")
        if rc != 0:
            die(f"{key} {raw} is not a commit in this repository")
        return out.strip()
    base = commit("baseline_sha")

    def inside(p):
        full = os.path.realpath(os.path.join(top, p))
        return full == top or full.startswith(top + os.sep)

    @functools.lru_cache(maxsize=None)
    def at(sha, p):
        rc, out = git(top, "show", f"{sha}:{p}")
        return out if rc == 0 else None

    @functools.lru_cache(maxsize=None)
    def base_decls(p):
        return declarations(at(base, p))

    @functools.lru_cache(maxsize=None)
    def tree_decls(p):
        full = os.path.join(top, p)
        text = open(full, encoding="utf-8", errors="replace").read() if os.path.isfile(full) else None
        return declarations(text)

    scope = fm.get("scope", ".") or "."
    pathspec = "." if scope == "." else scope
    glob = fm.get("test_glob", "")
    is_test = lambda f: bool(glob) and (fnmatch.fnmatch(os.path.basename(f), glob) or fnmatch.fnmatch(f, glob))

    # --- what is verified is what will be committed ------------------------------
    # The commit carries the ledger, its diffs and their receipts; a fresh clone
    # can only re-verify the audit if those are staged exactly as checked here.
    evidence = [os.path.abspath(ledger_path)]
    for _, mark, _, _, mutation in rows:
        if mark in MARKS and mutation not in ("", "-"):
            m = os.path.abspath(os.path.join(ldir, mutation))
            evidence += [m, m + ".caught"]
    for e in dict.fromkeys(evidence):
        if not os.path.exists(e) or not os.path.realpath(e).startswith(top + os.sep):
            continue                                   # reported by the checks below
        rel = os.path.relpath(os.path.realpath(e), top)
        staged = git(top, "ls-files", "--error-unmatch", "--", rel)[0] == 0
        if not staged or git(top, "diff", "--quiet", "--", rel)[0] != 0:
            bad(rel, "not staged as verified: stage the ledger, its diffs and their receipts before the commit")

    # --- every path the ledger names stays inside the repository ---------------
    ok_rows = []
    for row in rows:
        test, mark, keeper, _, mutation = row
        if mark not in MARKS or not test:
            continue
        paths = [split_test(test)[0]] + ([keeper.split("::", 1)[0]] if "::" in keeper else [])
        outside = [p for p in paths if not inside(p)]
        if mutation not in ("", "-") and not os.path.realpath(os.path.join(ldir, mutation)).startswith(top + os.sep):
            outside.append(mutation)
        if outside:
            bad(test, f"path outside the repository: {', '.join(outside)}")
            continue
        ok_rows.append(row)

    by_file = collections.defaultdict(list)
    for row in ok_rows:
        by_file[split_test(row[0])[0]].append(row)

    # --- each row against baseline and tree -------------------------------------
    for test, mark, keeper, _, _ in ok_rows:
        path, name = split_test(test)
        if name is None:
            if at(base, path) is None:
                bad(test, f"file not found at baseline {base[:12]}")
            elif mark in DELETION_MARKS and os.path.exists(os.path.join(top, path)):
                bad(test, f"{mark} row, but the file is still in the tree")
            elif mark not in DELETION_MARKS and not os.path.exists(os.path.join(top, path)):
                bad(test, f"{mark} row, but the file is gone from the tree")
        else:
            if names(base_decls(path))[name] == 0:
                bad(test, f"declaration not found at baseline {base[:12]} (typo, or an unsupported form: use a whole-file row)")
            elif mark not in DELETION_MARKS and names(tree_decls(path))[name] == 0:
                bad(test, f"{mark} row, but the declaration is gone from the tree")
        if mark in DELETION_MARKS and "::" in keeper:
            kp, kn = keeper.split("::", 1)
            if names(tree_decls(kp))[kn] == 0:
                bad(test, f"keeper {keeper} is not in the tree")

    # --- every removal is a D or C row -------------------------------------------
    rc, changed = git(top, "diff", "--name-only", base, "--", pathspec)
    if rc != 0:
        die(f"cannot diff baseline {base[:12]} against the working tree")
    candidates = set(by_file) | {f for f in changed.splitlines() if is_test(f) and at(base, f) is not None}
    for f in sorted(candidates):
        file_rows = by_file.get(f, [])
        if any(r[1] in DELETION_MARKS and "::" not in r[0] for r in file_rows):
            continue                                   # the whole file is a D/C row
        removed = names(base_decls(f)) - names(tree_decls(f))
        if any("::" not in r[0] for r in file_rows):  # a whole-file R/F row
            if removed:
                bad(f, f"whole-file {file_rows[0][1]} row, but declarations were removed: {', '.join(sorted(removed))}")
            continue
        claimed = collections.Counter(split_test(r[0])[1] for r in file_rows if r[1] in DELETION_MARKS)
        for n, k in sorted(removed.items()):
            if claimed[n] < k:
                bad(f"{f}::{n}", "declaration removed since baseline without a D or C row")
        for n, k in sorted(claimed.items()):
            if removed[n] < k:
                bad(f"{f}::{n}", f"{k} D/C row(s), but {k - removed[n]} of those declaration(s) are still in the tree")

    if mode != "campaign":
        return v

    # --- campaign: lanes and full coverage ------------------------------------------
    rc, listing = git(top, "ls-tree", "-r", "--name-only", base, "--", pathspec)
    if rc != 0:
        die(f"cannot list {pathspec} at baseline {base[:12]}")
    files = [f for f in listing.splitlines() if is_test(f)]

    lanes = {}
    for lane, flist in table(sec.get("Lanes", []), "Lanes", 2, ["Lane", "Files"]):
        for f in (x.strip().strip("`") for x in flist.split(",")):
            if f:
                lanes.setdefault(f, []).append(lane)
    named = {r[0] for r in ok_rows if "::" in r[0]}
    for f in files:
        n = len(lanes.get(f, []))
        if n == 0:
            bad(f, "test file is in no lane")
        elif n > 1:
            bad(f, f"test file is in {n} lanes: {', '.join(lanes[f])}")
        if f not in by_file:
            bad(f, "test file has no ledger row")
            continue
        if any("::" not in r[0] for r in by_file[f]):
            continue
        for d in sorted(names(base_decls(f))):
            if f"{f}::{d}" not in named:
                bad(f"{f}::{d}", "declaration has no ledger row (full coverage)")

    # --- campaign: rebaseline, judged per declaration --------------------------------
    if fm.get("rebaselined_from"):
        old = commit("rebaselined_from")
        rc, moved = git(top, "diff", "--name-only", old, base, "--", pathspec)
        if rc != 0:
            die(f"rebaselined_from {old[:12]} cannot be compared with {base[:12]}")
        for f in moved.splitlines():
            if f not in files:
                continue
            reconciled = [r for r in by_file.get(f, []) if r[3].startswith("reconciled:")]
            if any("::" not in r[0] for r in reconciled):
                continue                               # the whole file was judged again
            judged = {split_test(r[0])[1] for r in reconciled}
            before = collections.defaultdict(list)
            for n, block in declarations(at(old, f)):
                before[n].append(block)
            after = collections.defaultdict(list)
            for n, block in base_decls(f):
                after[n].append(block)
            for n in sorted(after):
                if after[n] != before.get(n) and n not in judged:
                    bad(f"{f}::{n}", f"main added or changed this since {old[:12]}; it needs a reconciled: row")
    return v


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
