#!/usr/bin/env bash
# ensemble-test-audit-review-artifact — the one file the preservation review reads.
#
# The peer is asked whether a deleted or consolidated test took the only proof
# of some contract with it. It can answer that only with the ledger's claims
# and the staged change in front of it together, and ensemble-build-peer-prompt
# takes a single --artifact-file. This writes that file: the ledger, then the
# staged diff, each under its own heading. It reads the index and never
# changes it.
#
# Usage:
#   ensemble-test-audit-review-artifact <ledger.md> [--out <path>]
#
# Prints the path it wrote (a new temp file unless --out is given).
#
# Exit codes:
#   0  written
#   2  no ledger, nothing staged, or bad arguments (reason on stderr)

set -u

die() { printf 'ensemble-test-audit-review-artifact: %s\n' "$*" >&2; exit 2; }

LEDGER=""; OUTFILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --out) [ $# -ge 2 ] || die "--out needs a path"; OUTFILE="$2"; shift 2 ;;
    -h|--help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown argument: $1" ;;
    *) [ -z "$LEDGER" ] || die "one ledger only"; LEDGER="$1"; shift ;;
  esac
done
[ -n "$LEDGER" ] || die "usage: ensemble-test-audit-review-artifact <ledger.md> [--out <path>]"
[ -f "$LEDGER" ] || die "ledger $LEDGER does not exist"
git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
git diff --cached --quiet && die "nothing is staged; stage the batch and the ledger first"

[ -n "$OUTFILE" ] || OUTFILE=$(mktemp "${TMPDIR:-/tmp}/en-test-audit-review.XXXXXX")
{
  printf '# Test-audit batch under review\n\n'
  printf '## Ledger file\n\n'
  printf 'Path: %s\n\n' "$LEDGER"
  cat "$LEDGER"
  printf '\n## Staged diff\n\n'
  printf '```diff\n'
  git diff --cached --no-color --no-ext-diff
  printf '```\n'
} > "$OUTFILE" || die "cannot write $OUTFILE"
printf '%s\n' "$OUTFILE"
