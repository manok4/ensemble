#!/usr/bin/env bash
# ensemble-config-get — shared, fail-soft config reader (EN11).
#
# Resolves ONE flat key across Ensemble's config layers, first hit wins:
#   1. <repo>/.ensemble/config.local.yaml   (per-project)
#   2. ~/.ensemble/config.json              (per-machine)
#   3. --default <value>
#   4. empty
#
# Owning the cascade here means consumers never re-implement layering.
#
# Usage:
#   ensemble-config-get <key> [--default <value>] [--allowed <v1,v2,...>]
#                             [--repo-root <dir>] [--home <dir>]
#
# Keys are FLAT (review_peer_effort_override, not review.peer.effort_override),
# matching every existing key in config.json and the `jq -r '.<key>'` read
# pattern in bin/ensemble-detect-host.
#
# FAIL-SOFT BY CONSTRUCTION: a missing file, unreadable file, malformed
# JSON/YAML, absent jq, null/empty value, or a value outside --allowed all
# fall through to the next layer. This never exits non-zero for a config
# problem — a bad config must never take down a review.

set -u

KEY=""
DEFAULT=""
ALLOWED=""
REPO_ROOT="."
HOME_DIR="${HOME:-}"

usage() {
  echo "usage: ensemble-config-get <key> [--default <value>] [--allowed <v1,v2,...>] [--repo-root <dir>] [--home <dir>]" >&2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --default)   [ $# -ge 2 ] || { usage; exit 2; }; DEFAULT="$2"; shift 2 ;;
    --allowed)   [ $# -ge 2 ] || { usage; exit 2; }; ALLOWED="$2"; shift 2 ;;
    --repo-root) [ $# -ge 2 ] || { usage; exit 2; }; REPO_ROOT="$2"; shift 2 ;;
    --home)      [ $# -ge 2 ] || { usage; exit 2; }; HOME_DIR="$2"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    -*)          usage; exit 2 ;;
    *)           [ -z "$KEY" ] || { usage; exit 2; }; KEY="$1"; shift ;;
  esac
done

[ -n "$KEY" ] || { usage; exit 2; }

# --- validity -------------------------------------------------------------
# A value counts as ABSENT when it is empty, whitespace-only, the literal
# JSON null, or (with --allowed) outside the allowed set. Absent values fall
# through to the next layer rather than shadowing it — this is what lets
# `setup` ship the keys present-but-unset without masking the ladder, and
# what stops a typo like `turbo` from ever reaching a CLI.
is_valid() {
  case "$1" in
    ''|'null') return 1 ;;
  esac
  case "$1" in
    *[![:space:]]*) ;;
    *) return 1 ;;          # whitespace-only
  esac
  [ -n "$ALLOWED" ] || return 0
  # Comma-delimited membership without touching IFS: wrapping both sides in
  # commas makes the substring test exact (",lo," does not match ",low,").
  case ",$ALLOWED," in
    *",$1,"*) return 0 ;;
  esac
  return 1
}

# --- layer 1: repo YAML ---------------------------------------------------
# Supported grammar is deliberately NARROW (a hand-rolled parser cannot do
# general YAML safely): exactly one TOP-LEVEL, NON-INDENTED `key: value` line
# whose value is a plain or quoted scalar. Indented occurrences, nested
# lookalikes under a parent, block/flow collections, and duplicate keys are
# all treated as ABSENT. Unrelated nested sections (e.g. en-sweep's `sweep:`
# block) are ignored.
yaml_raw() {
  [ -r "$1" ] || return 0
  awk -v key="$KEY" '
    /^[[:space:]]/ { next }                 # indented: not top level
    /^[[:space:]]*#/ { next }               # comment line
    {
      i = index($0, ":")
      if (i == 0) next
      k = substr($0, 1, i - 1)
      if (k != key) next
      n++
      val = substr($0, i + 1)
    }
    END { if (n == 1) print val }           # duplicate key -> absent
  ' "$1" 2>/dev/null
}

# Strip an unquoted trailing comment, strip surrounding quotes, trim space.
# A `#` INSIDE quotes is literal; an unquoted " #" starts a comment.
yaml_clean() {
  printf '%s' "$1" | awk '
    {
      s = $0
      sub(/^[[:space:]]+/, "", s)
      if (s ~ /^"/) {
        rest = substr(s, 2); i = index(rest, "\"")
        if (i == 0) { print ""; exit }      # unterminated quote -> absent
        print substr(rest, 1, i - 1); exit
      }
      if (s ~ /^'"'"'/) {
        rest = substr(s, 2); i = index(rest, "'"'"'")
        if (i == 0) { print ""; exit }
        print substr(rest, 1, i - 1); exit
      }
      i = index(s, " #")
      if (i > 0) s = substr(s, 1, i - 1)
      sub(/[[:space:]]+$/, "", s)
      print s
    }'
}

REPO_FILE="$REPO_ROOT/.ensemble/config.local.yaml"
if [ -f "$REPO_FILE" ]; then
  raw=$(yaml_raw "$REPO_FILE")
  if [ -n "$raw" ]; then
    val=$(yaml_clean "$raw")
    # A collection value (block or flow) is outside the supported grammar.
    case "$val" in
      '['*|'{'*) val="" ;;
    esac
    if is_valid "$val"; then printf '%s\n' "$val"; exit 0; fi
  fi
fi

# --- layer 2: global JSON -------------------------------------------------
# Non-object roots, malformed JSON, and absent jq all fall through.
GLOBAL_FILE="$HOME_DIR/.ensemble/config.json"
if [ -n "$HOME_DIR" ] && [ -r "$GLOBAL_FILE" ] && command -v jq >/dev/null 2>&1; then
  # `// empty` would discard a literal `false` as well as null, because jq's
  # alternative operator treats both as "empty". A boolean key set to false
  # (e.g. skip_peer_on_lightweight) must resolve to "false", not fall through
  # to the next layer. Test membership explicitly and drop only null.
  val=$(jq -r --arg k "$KEY" '
          if type == "object" and has($k)
          then (.[$k] | if . == null then empty else . end)
          else empty end
        ' "$GLOBAL_FILE" 2>/dev/null) || val=""
  if is_valid "$val"; then printf '%s\n' "$val"; exit 0; fi
fi

# --- layer 3: caller default ---------------------------------------------
if [ -n "$DEFAULT" ]; then printf '%s\n' "$DEFAULT"; exit 0; fi

# --- layer 4: empty -------------------------------------------------------
exit 0
