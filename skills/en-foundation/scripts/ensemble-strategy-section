#!/bin/sh
# ensemble-strategy-section: print a repo's Strategy section, or its ST-IDs.
#
# The one definition of where the Strategy section is. Every consumer (peer
# prompt, plan intake, sweep, setup health) reads the section through this
# script, so they agree on its boundary. ensemble-lint embeds the same
# recognition; tests/strategy/consumers-agree.test.sh keeps the two in step.
#
# Usage:
#   ensemble-strategy-section [--ids] [<foundation-path>]
#
# <foundation-path> defaults to docs/foundation.md under the current directory.
#
# Recognition
#   fences    a ``` or ~~~ run opens a block that only a run of the same
#             character, at least as long, closes (CommonMark); a trailing CR
#             is ignored, so CRLF files read the same
#   heading   the first line, outside fenced code, matching (case-insensitive)
#             ^##[[:space:]]+([0-9]+\.[[:space:]]+)?Strategy[[:space:]]*$
#   boundary  up to the line before the next # or ## heading outside fenced
#             code, or end of file
#   marker    the section counts only when a line, outside fenced code, reads
#             exactly <!-- strategy: author-approved YYYY-MM-DD -->
#   ids       --ids prints each ST<N> declared by a ^### ST<N>. line inside the
#             section, one per line, in file order
#
# Output
#   the section verbatim, or the ST-IDs with --ids; nothing when the file is
#   missing, has no Strategy heading, or the heading carries no marker
#
# Exit codes
#   0  found or absent (absence is empty stdout, never an error)
#   2  bad usage
#   3  more than one Strategy heading (message on stderr, nothing on stdout)

set -u

usage() { sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; }

ids=0
path=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ids) ids=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "ensemble-strategy-section: unknown flag $1" >&2; exit 2 ;;
    *)
      [ -z "$path" ] || { echo "ensemble-strategy-section: one path at most" >&2; exit 2; }
      path="$1" ;;
  esac
  shift
done
if [ $# -gt 0 ]; then
  [ -z "$path" ] && [ $# -eq 1 ] || { echo "ensemble-strategy-section: one path at most" >&2; exit 2; }
  path="$1"
fi
[ -n "$path" ] || path="docs/foundation.md"
[ -f "$path" ] || exit 0

awk -v ids="$ids" -v path="$path" '
  { sub(/\r$/, ""); line[NR] = $0 }
  END {
    fch = ""; heads = 0; start = 0
    for (i = 1; i <= NR; i++) {
      l = line[i]
      # A fence closes only on a run of its own character at least as long
      # as the one that opened it, so a fenced example of a fence stays code.
      if (fch != "") {
        code[i] = 1; t = l; sub(/^ ? ? ?/, "", t); n = 0
        while (substr(t, n + 1, 1) == fch) n++
        if (n >= flen && substr(t, n + 1) ~ /^[ \t]*$/) fch = ""
        continue
      }
      if (match(l, /^ ? ? ?(```+|~~~+)/)) {
        t = substr(l, RSTART, RLENGTH); sub(/^ */, "", t)
        fch = substr(t, 1, 1); flen = length(t); code[i] = 1; continue
      }
      if (tolower(l) ~ /^##[ \t]+([0-9]+\.[ \t]+)?strategy[ \t]*$/) {
        heads++; if (!start) start = i
      }
    }
    if (heads > 1) {
      print "ensemble-strategy-section: more than one Strategy section in " path > "/dev/stderr"
      exit 3
    }
    if (!start) exit 0
    stop = NR
    for (i = start + 1; i <= NR; i++)
      if (!code[i] && line[i] ~ /^##?[ \t]/) { stop = i - 1; break }
    marked = 0
    for (i = start + 1; i <= stop; i++)
      if (!code[i] && line[i] ~ /^<!-- strategy: author-approved [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] -->$/) { marked = 1; break }
    if (!marked) exit 0
    for (i = start; i <= stop; i++) {
      if (!ids) { print line[i]; continue }
      if (!code[i] && line[i] ~ /^### ST[0-9]+\./) {
        id = line[i]; sub(/^### /, "", id); sub(/\..*$/, "", id); print id
      }
    }
  }
' "$path"
