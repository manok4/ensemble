#!/usr/bin/env bash
# ensemble-run-metrics — record what a run can observe (EN16 U11, D106).
#
# One JSONL file per run under $(git rev-parse --git-dir)/ensemble/runs/, next
# to the verification receipt: never committed, no .gitignore entry, gone with
# the clone. Events are what the skill can see: agent dispatches with the model
# the resolver chose, peer passes with the peer_decision and token counts when
# the CLI reports them, lint runs, and findings per severity per pass.
# Compaction count and dollar cost are not observable from inside a run and
# are not recorded.
#
# /en-build records the same way: a unit or phase is two events (`"event":"start"`
# then `"event":"end"`), which is what turns commit timestamps into per-unit
# durations without a transcript to reconstruct.
#
# KEYED ON THE SKILL, not the plan. `--plan` required a plan_id, which only
# /en-build and /en-plan have, so the other fourteen skills could not record at
# all. The plan is optional context now.
#
# ONE JSON OBJECT PER LINE, appended. The previous format rewrote the whole
# document through jq under a lock, which cost O(n) per event and, worse, DROPPED
# the event when the lock was busy for five seconds — and /en-review dispatches
# seven personas at once. An append needs no lock, and a partial write costs one
# line rather than the file.
#
# Usage:
#   ensemble-run-metrics start  --skill <name> [--plan <id>] [--run-id <id>]  -> prints the file path
#   ensemble-run-metrics event  <file> --kind <dispatch|peer|lint|findings|unit|phase|suite|review|note> --json '<object>'
#   ensemble-run-metrics finish <file>
#   ensemble-run-metrics summary <file>   -> "N dispatches, M peer passes, K lint runs"
#
# NEVER BLOCKS A RUN. Outside a git repo, without jq, or on a malformed
# payload it prints one stderr line and exits 0; `start` then prints nothing,
# and every later call with an empty file argument is a no-op.

set -u

note() { printf 'ensemble-run-metrics: %s\n' "$*" >&2; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in start|event|finish|summary) ;; -h|--help|"") sed -n '2,20p' "$0" >&2; exit 0 ;; *) note "unknown command: $cmd"; exit 0 ;; esac

command -v jq >/dev/null 2>&1 || { note "jq not found; metrics disabled for this run"; exit 0; }

if [ "$cmd" = "start" ]; then
  plan="" run_id="" skill=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --skill)  [ $# -ge 2 ] || { note "--skill needs a value"; exit 0; };  skill="$2"; shift 2 ;;
      --plan)   [ $# -ge 2 ] || { note "--plan needs a value"; exit 0; };   plan="$2"; shift 2 ;;
      --run-id) [ $# -ge 2 ] || { note "--run-id needs a value"; exit 0; }; run_id="$2"; shift 2 ;;
      *) note "unknown flag for start: $1"; exit 0 ;;
    esac
  done
  [ -n "$skill" ] || { note "start needs --skill <name>"; exit 0; }
  case "$skill" in *[!a-z0-9-]*) note "--skill must be [a-z0-9-]+ (got '$skill'); metrics disabled"; exit 0 ;; esac
  # Absolute: `--git-dir` answers `.git` from the top level, and later calls
  # come from wherever the skill happens to be when it records an event.
  git_dir=$(git rev-parse --absolute-git-dir 2>/dev/null) \
    || git_dir=$(d=$(git rev-parse --git-dir 2>/dev/null) && cd "$d" 2>/dev/null && pwd) \
    || { note "not inside a git repository; metrics disabled"; exit 0; }
  dir="$git_dir/ensemble/runs"
  mkdir -p "$dir" 2>/dev/null || { note "cannot create $dir; metrics disabled"; exit 0; }
  # Exclusive creation: two runs started in the same second must not share a
  # file, and a caller-supplied --run-id must never truncate an existing run.
  [ -n "$run_id" ] || run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  file="$dir/$skill-$run_id.jsonl"
  if ! ( set -C; : > "$file" ) 2>/dev/null; then
    [ -n "$run_id" ] && note "metrics file already exists: $file; metrics disabled for this run"; exit 0
  fi
  if jq -nc --arg s "$skill" --arg p "$plan" --arg r "$run_id" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{kind:"start", skill:$s, plan_id:(if $p == "" then null else $p end), run_id:$r, at:$t}' > "$file" 2>/dev/null; then
    printf '%s\n' "$file"
  else
    note "cannot write $file; metrics disabled"; rm -f "$file"
  fi
  exit 0
fi

file="${1:-}"; [ $# -gt 0 ] && shift
[ -n "$file" ] || exit 0                      # metrics were disabled at start: silent no-op
[ -f "$file" ] || { note "no such metrics file: $file"; exit 0; }

# One line, appended. No lock: a single write() of a short line is atomic enough
# for concurrent appenders on every filesystem this runs on, and the failure it
# replaces was worse — the old lock DROPPED an event after five seconds of
# contention, which is the case /en-review's seven parallel personas produce.
_append() {  # <compact json line>
  printf '%s\n' "$1" >> "$file" 2>/dev/null || note "cannot append to $file; event dropped"
}

case "$cmd" in
  event)
    kind="" payload=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --kind) [ $# -ge 2 ] || { note "--kind needs a value"; exit 0; }; kind="$2"; shift 2 ;;
        --json) [ $# -ge 2 ] || { note "--json needs a value"; exit 0; }; payload="$2"; shift 2 ;;
        *) note "unknown flag for event: $1"; exit 0 ;;
      esac
    done
    case "$kind" in dispatch|peer|lint|findings|unit|phase|suite|review|note) ;; *) note "event --kind must be dispatch|peer|lint|findings|unit|phase|suite|review|note (got '$kind')"; exit 0 ;; esac
    if ! printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1; then
      note "event --json must be a JSON object; file unchanged"; exit 0
    fi
    line=$(jq -nc --arg k "$kind" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson p "$payload" \
      '{kind:$k, at:$t} + $p' 2>/dev/null) || { note "cannot encode event; file unchanged"; exit 0; }
    _append "$line"
    ;;
  finish)
    _append "$(jq -nc --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{kind:"finish", at:$t}')"
    ;;
  summary)
    # The three original counts are always present, so a caller can match on
    # them; a build's counts are appended only when it recorded any.
    jq -rs '[
      ([.[] | select(.kind=="dispatch")] | length | tostring) + " dispatches",
      ([.[] | select(.kind=="peer")]     | length | tostring) + " peer passes",
      ([.[] | select(.kind=="lint")]     | length | tostring) + " lint runs"
    ] as $base
    | [ ([.[] | select(.kind=="unit"  and .event=="end")] | length),
        ([.[] | select(.kind=="phase" and .event=="end")] | length),
        ([.[] | select(.kind=="suite")] | length) ] as $b
    | $base
      + (if $b[0] > 0 then [($b[0]|tostring) + " units"]      else [] end)
      + (if $b[1] > 0 then [($b[1]|tostring) + " phases"]     else [] end)
      + (if $b[2] > 0 then [($b[2]|tostring) + " suite runs"] else [] end)
    | join(", ")' "$file" 2>/dev/null || note "cannot summarise $file"
    ;;
esac
exit 0
