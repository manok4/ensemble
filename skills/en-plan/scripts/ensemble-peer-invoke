#!/usr/bin/env bash
# ensemble-peer-invoke — peer invocation with classified, bounded fail-soft (EN11).
#
# Sourced by /en-review (step 9) AND by tests/lint/en-review-peer-default.test.sh,
# so the test drives the REAL state machine. The retry contract lives here as
# EXECUTABLE code rather than skill prose, because a prose invariant cannot be
# behaviorally tested (D41): assertions on text can prove the words "retry once"
# appear, never that exactly one retry happened.
#
# Pure functions, no top-level side effects, safe to source under `set -eu`.
#
# Usage (all flags optional unless noted):
#   ensemble_peer_invoke --peer-cmd <cmd> --peer-format <fmt> [--peer-turns <t>]
#                        [--peer-model <frag>] [--peer-effort <frag>]
#                        --prompt-file <path> [--out-file <path>]
#                        [--peer-mode <mode>] [--effort <tier>]
#                        [--model-alias <alias>] [--reason-on <reason>]
#                        [--access none|read-tree] [--schema <file>]
#
# Prints ONE peer_decision JSON object (references/peer-contract.md) on
# stdout. The peer's own stdout goes to --out-file, unwrapped to the peer's
# findings object when the CLI returned a transport envelope.
#
# Detached form (D81), for a peer that may run for minutes: no tool call has
# to stay open for its lifetime, and host personas can run alongside it.
#   ensemble_peer_start  --job-dir <dir> <every ensemble_peer_invoke flag>
#                        -> prints <dir>; returns at once
#   ensemble_peer_wait   <dir> [--max-secs <n>]  -> prints running|done; 0 done, 3 running
#   ensemble_peer_result <dir>  -> prints the decision; returns the invoke's exit code
#   ensemble_peer_reap   <dir>  -> kills a still-running peer and records peer-failed:timeout

# Locate and load the shared classifier (reused from EN10, never duplicated).
#
# BASH_SOURCE is bash-only. Consumers `source` this file (it exports a function,
# so they must), and on macOS the sourcing shell is often zsh -- which leaves
# BASH_SOURCE unset and, under `set -u`, aborted the sibling loads while
# ensemble_peer_invoke still returned a well-formed
# {"peer":"off","reason":"peer-failed:retry-exhausted"}. A broken helper was
# therefore indistinguishable from a real peer failure, silently disabling peer
# review. zsh sets $0 to the sourced file, bash does not, so the fallback covers
# sourced and executed under both shells.
_epi_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=$SKILL_DIR/scripts/ensemble-cli-smoke
. "$_epi_dir/ensemble-cli-smoke"
# shellcheck source=$SKILL_DIR/scripts/ensemble-extract-json
. "$_epi_dir/ensemble-extract-json"

# Split a flag fragment into argv under a CONTROLLED IFS with globbing off.
# Relying on the caller's ambient IFS is not safe: a shell with a non-default
# IFS would pass a whole fragment as one argument and the CLI would reject it.
_epi_push() {
  local _frag="$1" _w
  [ -n "$_frag" ] || return 0
  local IFS=' '
  set -f
  for _w in $_frag; do _epi_argv+=("$_w"); done
  set +f
}

# Decide which fragment a flag rejection is about.
#   $1 = stderr text
# prints: effort | model | "" (ambiguous)
_epi_attribute() {
  if printf '%s' "${1:-}" | grep -qiE 'model_reasoning_effort|--effort'; then
    echo effort; return 0
  fi
  if printf '%s' "${1:-}" | grep -qiE '\-\-model|(^|[[:space:]])-m([[:space:]]|$)'; then
    echo model; return 0
  fi
  echo ""
}

# --- Isolation for the peer subprocess, in two access modes -------------------
# The peer is a reporter (D30): it never writes. Every Claude peer gets no MCP
# servers, no skills, no session state and no user-level settings (a loaded
# LSP once spent the single --max-turns on a tool call before any JSON came
# back). What differs is whether it may READ the tree (D81):
#   none       --tools '' and the caller's turn cap (one turn). For a document
#              review, or a lite code review: the artifact is the whole input.
#   read-tree  --tools Read,Grep,Glob, --permission-mode dontAsk so a denied
#              tool fails fast instead of waiting for an answer, and a turn cap
#              of ENSEMBLE_PEER_MAX_TURNS (25) so the peer can open the caller
#              of a changed function and the test beside it. A turn is one
#              model-to-tool round trip inside the peer; the host sees one
#              report either way. No Bash, Edit, Write, Agent, web or MCP.
# `codex exec` gets `-s read-only` in both modes and none of the Claude flags.
# Flags are keyed on the command, never on the host.
# ENSEMBLE_PEER_ISOLATION=off disables the set for one session (debugging).
_EPI_ISOLATION_BASE=(--strict-mcp-config --mcp-config '{"mcpServers":{}}'
                     --disable-slash-commands --no-session-persistence
                     --setting-sources project)
_EPI_ACCESS_NONE=(--tools '')
_EPI_ACCESS_READ_TREE=(--tools Read,Grep,Glob --permission-mode dontAsk)
_EPI_CODEX_SANDBOX=(-s read-only)

_epi_is_claude() { case "${1%% *}" in claude|*/claude) return 0 ;; esac; return 1; }
_epi_is_codex()  { case "${1%% *}" in codex|*/codex)   return 0 ;; esac; return 1; }

_epi_isolation_applies() {  # $1=peer_cmd
  [ "${ENSEMBLE_PEER_ISOLATION:-on}" != "off" ] || return 1
  _epi_is_claude "$1" || _epi_is_codex "$1"
}

# Push the isolation set for this command and access mode, plus the schema
# flag when a schema was given. One place, so attempt 1 and the retry agree.
#   $1=peer_cmd $2=access $3=schema_file
_epi_push_isolation() {
  if _epi_is_claude "$1"; then
    _epi_argv+=("${_EPI_ISOLATION_BASE[@]}")
    if [ "$2" = "read-tree" ]; then
      _epi_argv+=("${_EPI_ACCESS_READ_TREE[@]}" --max-turns "${ENSEMBLE_PEER_MAX_TURNS:-25}")
    else
      _epi_argv+=("${_EPI_ACCESS_NONE[@]}")
    fi
    [ -z "$3" ] || _epi_argv+=(--json-schema "$(cat "$3")")
  elif _epi_is_codex "$1"; then
    _epi_argv+=("${_EPI_CODEX_SANDBOX[@]}")
    [ -z "$3" ] || _epi_argv+=(--output-schema "$3")
  fi
}

# A rejection of one of the isolation flags, as opposed to the model or effort
# fragment. Anchored on the rejection phrasing so a usage dump that merely
# lists --tools is not mistaken for one.
_epi_is_isolation_rejection() {  # $1=stderr
  printf '%s' "${1:-}" | grep -qiE "(unexpected|unrecognized|unknown|invalid) (argument|option)[^[:cntrl:]]*(strict-mcp-config|mcp-config|disable-slash-commands|no-session-persistence|setting-sources|--tools|permission-mode|json-schema|output-schema|--sandbox|'-s')"
}

# Escape a value for embedding in a JSON string. Without this a configured
# alias containing a quote, backslash, or control character would emit invalid
# JSON and silently defeat the structured contract (EN11-CR-003).
_epi_json_escape() {
  printf '%s' "${1:-}" \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\r/\\r/g' \
    | tr -d '\000-\010\013\014\016-\037' \
    | awk 'NR>1{printf "\\n"} {printf "%s", $0}'
}

# Emit the peer_decision object. Values come from the caller's resolved state,
# so this helper never re-derives policy.
_epi_decision() {  # $1=peer $2=reason $3=peer_mode $4=effort $5=model_alias [$6=elapsed_s] [$7=model_actual]
  # Emitting a decision IS the terminal event, so the marker is cleared here
  # rather than at each exit path. Clearing per-path meant an exit added later
  # would leave a false orphan behind, and a false orphan is worse than none: it
  # reports an interruption that never happened.
  [ -n "${_epi_marker_out:-}" ] && _epi_marker_clear "$_epi_marker_out"
  _epi_marker_out=""
  local _alias
  if [ -n "${5:-}" ]; then _alias="\"$(_epi_json_escape "$5")\""; else _alias="null"; fi
  local _el; if [ -n "${6:-}" ]; then _el="$6"; else _el="null"; fi
  local _actual
  if [ -n "${7:-}" ]; then _actual="\"$(_epi_json_escape "$7")\""; else _actual="null"; fi
  printf '{"peer":"%s","reason":"%s","peer_mode":"%s","effort":"%s","model_alias":%s,"elapsed_s":%s,"model_actual":%s}\n' \
    "$(_epi_json_escape "$1")" "$(_epi_json_escape "$2")" \
    "$(_epi_json_escape "${3:-off}")" "$(_epi_json_escape "${4:-medium}")" "$_alias" "$_el" "$_actual"
}

# Recover the JSON envelope from a response wrapped in fences or prose. Applied
# to every successful peer call so all four peer-invoking skills get it without
# each re-implementing it. On failure the file is left byte-for-byte untouched:
# the caller's existing "retry once with valid JSON only" is still the fallback
# for genuinely broken responses, and must not be pre-empted by a partial write.
_epi_normalize_out() {
  local _f="${1:-}" _clean
  [ -n "$_f" ] && [ "$_f" != "/dev/null" ] && [ -s "$_f" ] || return 0
  _epi_unwrap_envelope "$_f"
  _clean=$(ensemble_extract_json "$_f") || return 0
  printf '%s' "$_clean" > "$_f"
}

# `claude -p --output-format json` returns a transport envelope
# {"type":"result","result":"<text>","structured_output":{...},"modelUsage":{...}}.
# The findings are the structured_output when a schema was given, else the
# result text; the served model is the modelUsage key (canonicalModel when
# present), which becomes the decision's model_actual so a degraded or
# fallback run records what actually served it (D81). Leaves anything that is
# not that envelope untouched, so codex streams and plain JSON pass through.
_epi_model_actual=""
_epi_unwrap_envelope() {  # $1=out_file
  local _f="$1" _res
  command -v python3 >/dev/null 2>&1 || return 0
  _res=$(python3 - "$_f" <<'PY' 2>/dev/null
import json, sys
p = sys.argv[1]
try:
    d = json.load(open(p, encoding="utf-8"))
except Exception:
    sys.exit(0)
if not isinstance(d, dict) or d.get("type") != "result":
    sys.exit(0)
mu = d.get("modelUsage") or {}
actual = ""
for k, v in mu.items():
    actual = (v or {}).get("canonicalModel") or k
    break
so = d.get("structured_output")
body = json.dumps(so) if isinstance(so, dict) else (d.get("result") or "")
open(p, "w", encoding="utf-8").write(body)
print(actual)
PY
) || true
  _epi_model_actual="${_res:-}"
}

# --- run marker: make a killed host call visible -----------------------------
# `timeout` bounds a peer that runs too long, and exit 124 is reported. It cannot
# help when the HOST's tool call dies — context exhaustion, Ctrl-C, a truncated
# call. The subprocess dies with it and nothing is written, so the next step sees
# an absent or stale output file and cannot tell "the peer was never asked" from
# "the peer answered nothing".
#
# A marker written before the call and cleared after turns that silence into
# evidence. This is deliberately not a job runner: no polling, no job roots, no
# process supervision. The ceiling still does the bounding; the marker only makes
# a death visible to the next invocation.
_epi_marker_path() {
  [ -n "${1:-}" ] && [ "$1" != "/dev/null" ] || return 1
  printf '%s.run' "$1"
}

_epi_marker_write() {  # $1=out_file $2=peer_cmd $3=peer_mode
  local _m; _m=$(_epi_marker_path "${1:-}") || return 0
  printf '{"started":"%s","peer_cmd":"%s","peer_mode":"%s","host_pid":%s}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(_epi_json_escape "${2:-}")" \
    "$(_epi_json_escape "${3:-}")" "$$" > "$_m" 2>/dev/null || true
}

_epi_marker_clear() {
  local _m; _m=$(_epi_marker_path "${1:-}") || return 0
  rm -f "$_m" 2>/dev/null || true
}

# Public: report an orphaned marker from a previous run, if one is present.
# A caller checks this BEFORE invoking, so an interrupted review is surfaced
# rather than silently retried over a stale output file.
ensemble_peer_orphaned_run() {  # $1=out_file
  local _m; _m=$(_epi_marker_path "${1:-}") || return 1
  [ -f "$_m" ] || return 1
  cat "$_m" 2>/dev/null
}

# Resolve a timeout wrapper once. Same convention as references/outside-voice.md.
_epi_timeout_bin() {
  command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true
}

ensemble_peer_invoke() {
  local peer_cmd="" peer_format="" peer_turns="" peer_model="" peer_effort=""
  local prompt_file="" out_file="/dev/null" peer_mode="cross-agent"
  local effort="medium" model_alias="" reason_on="default-on"
  local access="none" schema_file="" timeout_secs=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --peer-cmd)     peer_cmd="$2";     shift 2 ;;
      --peer-format)  peer_format="$2";  shift 2 ;;
      --peer-turns)   peer_turns="$2";   shift 2 ;;
      --peer-model)   peer_model="$2";   shift 2 ;;
      --peer-effort)  peer_effort="$2";  shift 2 ;;
      --prompt-file)  prompt_file="$2";  shift 2 ;;
      --out-file)     out_file="$2";     shift 2 ;;
      --peer-mode)    peer_mode="$2";    shift 2 ;;
      --effort)       effort="$2";       shift 2 ;;
      --model-alias)  model_alias="$2";  shift 2 ;;
      --reason-on)    reason_on="$2";    shift 2 ;;
      --timeout)      timeout_secs="$2"; shift 2 ;;
      --access)       access="$2";       shift 2 ;;
      --schema)       schema_file="$2";  shift 2 ;;
      *) echo "ensemble_peer_invoke: unknown flag $1" >&2; return 2 ;;
    esac
  done

  if [ -z "$peer_cmd" ] || [ -z "$prompt_file" ]; then
    echo "ensemble_peer_invoke: --peer-cmd and --prompt-file are required" >&2
    return 2
  fi
  case "$access" in none|read-tree) ;; *) echo "ensemble_peer_invoke: --access must be none or read-tree" >&2; return 2 ;; esac
  if [ -n "$schema_file" ] && [ ! -f "$schema_file" ]; then
    echo "ensemble_peer_invoke: --schema file not found: $schema_file" >&2; return 2
  fi
  # A one-shot peer answers in minutes; a peer reading the tree may take
  # longer, so its ceiling is doubled. peer_timeout_seconds still overrides
  # both, and --timeout overrides everything.
  if [ -z "$timeout_secs" ]; then
    if [ -n "${peer_timeout_seconds:-}" ]; then timeout_secs="$peer_timeout_seconds"
    elif [ "$access" = "read-tree" ]; then timeout_secs=1200
    else timeout_secs=600; fi
  fi
  # In read-tree the access mode owns the Claude turn cap; the caller's
  # --max-turns 1 would defeat the reads it was granted.
  if [ "$access" = "read-tree" ] && _epi_is_claude "$peer_cmd" && _epi_isolation_applies "$peer_cmd"; then
    peer_turns=""
  fi
  _epi_model_actual=""

  # A stuck peer must not block a default-on review forever (EN11-CR-002).
  # `timeout` exits 124 when it fires, which maps to the published
  # peer-failed:timeout reason.
  local _tb; _tb=$(_epi_timeout_bin)
  # outside-voice.md promised a fail-fast here for years while this helper ran
  # the peer unwrapped. Refusing would turn a missing coreutils into a skipped
  # review on every macOS host without it, so the call proceeds, bounded only
  # by the run marker; but it says so, once, where the operator can see it.
  [ -n "$_tb" ] || echo "ensemble-peer-invoke: neither 'timeout' nor 'gtimeout' on PATH; the peer runs unbounded (macOS: brew install coreutils)" >&2

  # --- attempt 1 ---------------------------------------------------------
  # Marker first: if this tool call is killed mid-flight, the marker is the only
  # trace that a peer was ever asked. Cleared by _epi_decision on every exit.
  _epi_marker_write "$out_file" "$peer_cmd" "$peer_mode"
  _epi_marker_out="$out_file"
  local _t0; _t0=$(date +%s)
  local _epi_argv=() _err _rc _class _iso_on=0
  [ -z "$_tb" ] || [ -z "$timeout_secs" ] || _epi_argv+=("$_tb" "$timeout_secs")
  _epi_push "$peer_cmd"; _epi_push "$peer_format"; _epi_push "$peer_turns"
  if _epi_isolation_applies "$peer_cmd"; then _epi_push_isolation "$peer_cmd" "$access" "$schema_file"; _iso_on=1; fi
  _epi_push "$peer_model"; _epi_push "$peer_effort"

  # The `if err=$(...)` form captures a non-zero exit WITHOUT tripping the
  # caller's `set -e` (a bare `err=$(...); rc=$?` would abort under errexit).
  if _err=$("${_epi_argv[@]}" < "$prompt_file" 2>&1 >"$out_file"); then
    _epi_normalize_out "$out_file"
    _epi_decision "on" "$reason_on" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))" "$_epi_model_actual"
    return 0
  else
    _rc=$?
  fi

  if [ "$_rc" -eq 124 ]; then
    _epi_decision "off" "peer-failed:timeout" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"
    return 1
  fi

  _class=$(ensemble_smoke_classify "$_err" "$_rc")

  case "$_class" in
    auth)    _epi_decision "off" "peer-failed:auth"    "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"; return 1 ;;
    unknown) _epi_decision "off" "peer-failed:unknown" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"; return 1 ;;
  esac

  # --- flagdrift: ONE bounded retry, dropping ONLY the rejected fragment ---
  local _target _dropped
  if [ "$_iso_on" -eq 1 ] && _epi_is_isolation_rejection "$_err"; then
    # An isolation flag the installed CLI no longer knows. Drop the whole
    # isolation set (it is one fragment for this purpose) and keep the model
    # and effort fragments; the review still runs, and the decision says so.
    _target="isolation"
  else
    _target=$(_epi_attribute "$_err")
  fi

  # An attributed-but-empty fragment cannot be the cause; prefer a fragment
  # that is actually present. Ambiguous attribution drops the model fragment
  # first (Codex never sets it, so it is the likelier culprit on Claude).
  if [ "$_target" = "effort" ] && [ -z "$peer_effort" ]; then _target=""; fi
  if [ "$_target" = "model" ]  && [ -z "$peer_model"  ]; then _target=""; fi
  if [ -z "$_target" ]; then
    if   [ -n "$peer_model" ];  then _target="model"
    elif [ -n "$peer_effort" ]; then _target="effort"
    else
      # Neither fragment is set, so no retry could change the outcome.
      _epi_decision "off" "peer-failed:retry-exhausted" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"
      return 1
    fi
  fi

  _epi_argv=()
  [ -z "$_tb" ] || [ -z "$timeout_secs" ] || _epi_argv+=("$_tb" "$timeout_secs")
  _epi_push "$peer_cmd"; _epi_push "$peer_format"; _epi_push "$peer_turns"
  # Drop ONLY the rejected fragment; the others are retained deliberately.
  case "$_target" in
    isolation)
      _dropped="dropped-isolation-fragment"
      _epi_push "$peer_model"; _epi_push "$peer_effort" ;;
    model)
      _dropped="dropped-model-fragment"
      [ "$_iso_on" -eq 0 ] || _epi_push_isolation "$peer_cmd" "$access" "$schema_file"
      _epi_push "$peer_effort" ;;
    *)
      _dropped="dropped-effort-fragment"
      [ "$_iso_on" -eq 0 ] || _epi_push_isolation "$peer_cmd" "$access" "$schema_file"
      _epi_push "$peer_model" ;;
  esac

  # Capture the retry's exit code in an `else`, exactly as attempt 1 does. A
  # bare `$?` after a completed `if` reads the IF STATEMENT's status (always 0
  # when no branch ran), which would make the 124 check dead code and misreport
  # a timed-out retry as retry-exhausted.
  if _err=$("${_epi_argv[@]}" < "$prompt_file" 2>&1 >"$out_file"); then
    _epi_normalize_out "$out_file"
    _epi_decision "degraded" "$_dropped" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))" "$_epi_model_actual"
    return 0
  else
    _rc=$?
  fi
  if [ "$_rc" -eq 124 ]; then
    _epi_decision "off" "peer-failed:timeout" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"
    return 1
  fi

  _epi_decision "off" "peer-failed:retry-exhausted" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))"
  return 1
}

# --- detached form (D81) --------------------------------------------------------
# A read-tree peer can run for minutes. Holding a host tool call open for that
# long is how a pass silently vanishes when the harness kills the call, and it
# serialises the peer behind nothing. So: start it in its own process with every
# descriptor on a file, return the job dir, and let the host collect later in
# bounded slices. Durable state is the job dir; a missing exit file means the
# peer is still running (or died with the host, which the run marker records).
#   <dir>/decision.json  the peer_decision the invoke printed
#   <dir>/exit           the invoke's exit code; its presence means terminal
#   <dir>/pid            the detached process id
#   <dir>/started        epoch seconds at start
ensemble_peer_start() {
  local job_dir=""
  local -a rest=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --job-dir) job_dir="$2"; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$job_dir" ] || { echo "ensemble_peer_start: --job-dir is required" >&2; return 2; }
  mkdir -p "$job_dir" || return 2
  rm -f "$job_dir/exit" "$job_dir/decision.json" "$job_dir/stderr"
  date +%s > "$job_dir/started"
  (
    trap '' HUP
    set +e
    ensemble_peer_invoke "${rest[@]}" > "$job_dir/decision.json" 2> "$job_dir/stderr"
    printf '%s\n' "$?" > "$job_dir/exit.tmp" && mv -f "$job_dir/exit.tmp" "$job_dir/exit"
  ) </dev/null >/dev/null 2>&1 &
  printf '%s\n' "$!" > "$job_dir/pid"
  disown "$!" 2>/dev/null || true
  printf '%s\n' "$job_dir"
}

ensemble_peer_wait() {  # <dir> [--max-secs <n>]
  local job_dir="${1:-}"; shift || true
  local max_secs=60
  while [ $# -gt 0 ]; do
    case "$1" in --max-secs) max_secs="$2"; shift 2 ;; *) shift ;; esac
  done
  [ -d "$job_dir" ] || { echo "ensemble_peer_wait: no such job dir: $job_dir" >&2; return 2; }
  local _t0; _t0=$(date +%s)
  while [ ! -f "$job_dir/exit" ]; do
    if [ $(( $(date +%s) - _t0 )) -ge "$max_secs" ]; then echo running; return 3; fi
    sleep 1
  done
  echo done; return 0
}

ensemble_peer_result() {  # <dir> -> prints decision.json; returns the invoke's exit
  local job_dir="${1:-}"
  [ -f "$job_dir/exit" ] || { echo "ensemble_peer_result: job not terminal: $job_dir" >&2; return 3; }
  cat "$job_dir/decision.json" 2>/dev/null
  return "$(cat "$job_dir/exit")"
}

ensemble_peer_reap() {  # <dir> [--peer-mode m] [--effort t] [--model-alias a]
  local job_dir="${1:-}"; shift || true
  local peer_mode="cross-agent" effort="medium" model_alias=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --peer-mode) peer_mode="$2"; shift 2 ;;
      --effort) effort="$2"; shift 2 ;;
      --model-alias) model_alias="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  [ -d "$job_dir" ] || { echo "ensemble_peer_reap: no such job dir: $job_dir" >&2; return 2; }
  [ -f "$job_dir/exit" ] && return 0   # already terminal: a safe no-op
  local _pid; _pid=$(cat "$job_dir/pid" 2>/dev/null || true)
  if [ -n "$_pid" ]; then
    # Children first (the CLI under `timeout`), then the subshell itself.
    pkill -TERM -P "$_pid" 2>/dev/null || true
    kill -TERM "$_pid" 2>/dev/null || true
    sleep 1
    pkill -KILL -P "$_pid" 2>/dev/null || true
    kill -KILL "$_pid" 2>/dev/null || true
  fi
  local _t0; _t0=$(cat "$job_dir/started" 2>/dev/null || date +%s)
  _epi_decision "off" "peer-failed:timeout" "$peer_mode" "$effort" "$model_alias" "$(( $(date +%s) - _t0 ))" > "$job_dir/decision.json"
  printf '1\n' > "$job_dir/exit"
  return 0
}
