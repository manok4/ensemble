#!/bin/sh
# ensemble-review-history — review comments from merged PRs, one JSON line each
# (EN22). Feeds /en-sweep's recurrence scan, which looks for the same correction
# made in two or more PRs.
#
# Usage:
#   ensemble-review-history --since <YYYY-MM-DD> [--repo <owner/name>] [--limit <n>]
#
# Output, one line per review-thread comment:
#   {"pr":118,"path":"...","author":"...","bot":false,"body":"...","resolved":true}
#
# Bounds: the newest <limit> merged PRs (default 50), 50 threads per PR and 20
# comments per thread. A sweep window is weeks, not years; the bounds keep one
# call to one GraphQL request.
#
# Exit codes:
#   0  printed at least one PR's comments
#   3  no PR merged since the date; stdout is empty
#   2  usage error
#   1  gh or jq missing, or gh failed; stderr names the cause. Never a quiet 0.

set -eu

die() { code="$1"; shift; echo "ensemble-review-history: $*" >&2; exit "$code"; }

SINCE=""; REPO=""; LIMIT=50
while [ $# -gt 0 ]; do
  case "$1" in
    --since|--repo|--limit)
      [ $# -ge 2 ] || die 2 "$1 needs a value"
      case "$1" in --since) SINCE="$2" ;; --repo) REPO="$2" ;; --limit) LIMIT="$2" ;; esac
      shift 2 ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die 2 "unknown argument: $1" ;;
  esac
done

printf '%s' "$SINCE" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' || die 2 "--since must be YYYY-MM-DD"
case "$LIMIT" in ''|*[!0-9]*) die 2 "--limit must be a number" ;; esac

command -v gh >/dev/null 2>&1 || die 1 "gh not found"
command -v jq >/dev/null 2>&1 || die 1 "jq not found"

if [ -z "$REPO" ]; then
  REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) \
    || die 1 "gh repo view failed; pass --repo <owner/name>"
fi

QUERY='query($q: String!, $n: Int!) {
  search(query: $q, type: ISSUE, first: $n) {
    nodes { ... on PullRequest {
      number
      reviewThreads(first: 50) { nodes {
        isResolved
        comments(first: 20) { nodes { path body author { login __typename } } }
      } }
    } }
  }
}'

RAW=$(gh api graphql -f query="$QUERY" -F n="$LIMIT" \
        -f q="repo:$REPO is:pr is:merged merged:>=$SINCE" 2>&1) \
  || die 1 "gh api graphql failed: $RAW"

COUNT=$(printf '%s' "$RAW" | jq '.data.search.nodes | length' 2>/dev/null) \
  || die 1 "gh returned output jq could not parse"
[ "$COUNT" -gt 0 ] || exit 3

printf '%s' "$RAW" | jq -c '
  .data.search.nodes[]
  | .number as $pr
  | .reviewThreads.nodes[]
  | .isResolved as $resolved
  | .comments.nodes[]
  | (.author.login // "ghost") as $who
  | {pr: $pr, path: .path, author: $who,
     bot: ((.author.__typename // "") == "Bot" or ($who | endswith("[bot]"))),
     body: .body, resolved: $resolved}'
