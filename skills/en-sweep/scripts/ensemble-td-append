#!/bin/sh
# ensemble-td-append: the one writer of routed tech-debt entries (EN22).
#
# Appends one entry under `## Open` in docs/plans/tech-debt-tracker.md, taking
# the next TD number after the highest in the file, with the routing fields from
# references/enforcement-layers.md. Refuses an L1 or L2 entry without a concrete
# check, refuses L5 (a learning, not debt), refuses any value containing a line
# break (it could forge headings and escape `## Open`), and refuses a second open
# entry with the same rule key, so a correction seen twice is filed once.
#
# Usage:
#   ensemble-td-append --tracker <path> --title <t> --source <s> --severity P0-P3
#       --confidence 1-10 --location <l> --why <w> --fix <f>
#       --enforce-at "L1 structure|L2 static|L3 rules|L4 skill" (or L1-L4)
#       [--check "<path>: <rule>"] --rule-key <kebab-slug, 64 chars max>
#   ensemble-td-append --list-keys --tracker <path>
#
# Exit codes:
#   0  appended; prints the new TD-ID
#   4  duplicate rule key; prints the existing TD-ID, writes nothing
#   2  usage or validation error, writes nothing
#   1  tracker missing or has no `## Open` section, writes nothing

set -eu

die() { code="$1"; shift; echo "ensemble-td-append: $*" >&2; exit "$code"; }

TRACKER=""; TITLE=""; SOURCE=""; SEVERITY=""; CONFIDENCE=""; LOCATION=""
WHY=""; FIX=""; LAYER=""; CHECK=""; KEY=""; LIST="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --list-keys) LIST="true"; shift ;;
    --tracker|--title|--source|--severity|--confidence|--location|--why|--fix|--enforce-at|--check|--rule-key)
      [ $# -ge 2 ] || die 2 "$1 needs a value"
      case "$2" in *"
"*|*"$(printf '\r')"*) die 2 "$1 must be a single line" ;; esac
      case "$1" in
        --tracker) TRACKER="$2" ;; --title) TITLE="$2" ;; --source) SOURCE="$2" ;;
        --severity) SEVERITY="$2" ;; --confidence) CONFIDENCE="$2" ;;
        --location) LOCATION="$2" ;; --why) WHY="$2" ;; --fix) FIX="$2" ;;
        --enforce-at) LAYER="$2" ;; --check) CHECK="$2" ;; --rule-key) KEY="$2" ;;
      esac
      shift 2 ;;
    -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die 2 "unknown argument: $1" ;;
  esac
done

[ -n "$TRACKER" ] || die 2 "--tracker is required"
[ -f "$TRACKER" ] || die 1 "tracker not found: $TRACKER"
grep -q '^## Open[[:space:]]*$' "$TRACKER" || die 1 "no '## Open' section in $TRACKER"

# Open entries as: id <TAB> key-or-dash <TAB> title
open_entries() {
  awk '
    function flush() { if (id != "") printf "%s\t%s\t%s\n", id, (key == "" ? "-" : key), title; id=""; key=""; title="" }
    /^## / { flush(); open = ($0 ~ /^## Open[[:space:]]*$/); next }
    open && /^### TD[0-9]+\. / { flush(); id=$2; sub(/\.$/, "", id); title=$0; sub(/^### TD[0-9]+\. /, "", title); next }
    open && id != "" && /\*\*Rule key:\*\*/ { v=$0; sub(/.*\*\*Rule key:\*\*[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v); key=v }
    END { flush() }
  ' "$TRACKER"
}

if [ "$LIST" = "true" ]; then
  open_entries
  exit 0
fi

for pair in "title:$TITLE" "source:$SOURCE" "severity:$SEVERITY" "confidence:$CONFIDENCE" \
            "location:$LOCATION" "why:$WHY" "fix:$FIX" "enforce-at:$LAYER" "rule-key:$KEY"; do
  [ -n "${pair#*:}" ] || die 2 "--${pair%%:*} is required"
done

case "$SEVERITY" in P0|P1|P2|P3) ;; *) die 2 "--severity must be P0-P3" ;; esac
case "$CONFIDENCE" in [1-9]|10) ;; *) die 2 "--confidence must be 1-10" ;; esac

case "$LAYER" in
  L1|"L1 structure") LAYER_LABEL="L1 structure" ;;
  L2|"L2 static") LAYER_LABEL="L2 static" ;;
  L3|"L3 rules") LAYER_LABEL="L3 rules" ;;
  L4|"L4 skill") LAYER_LABEL="L4 skill" ;;
  L5|"L5 prose") die 2 "L5 routes to a learning, not the tracker" ;;
  *) die 2 "--enforce-at must be one of: L1 structure, L2 static, L3 rules, L4 skill" ;;
esac

# The same concrete-check rule bin/ensemble-lint's td.enforce-layer applies.
CHECK="${CHECK#\`}"; CHECK="${CHECK%\`}"
case "$LAYER_LABEL" in
  L1*|L2*)
    printf '%s' "$CHECK" | grep -qE '^[A-Za-z0-9_./-]+:[[:space:]]+[^[:space:]]' \
      || die 2 "${LAYER_LABEL%% *} needs --check \"<path>: <rule or assertion>\" with both parts" ;;
esac

KEY=$(printf '%s' "$KEY" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-//' -e 's/-$//')
[ -n "$KEY" ] || die 2 "--rule-key has no letters or digits"
[ "${#KEY}" -le 64 ] || die 2 "--rule-key is longer than 64 characters; name the correction in a shorter slug"

existing=$(open_entries | awk -F '\t' -v k="$KEY" '$2 == k { print $1; exit }')
if [ -n "$existing" ]; then
  echo "$existing"
  exit 4
fi

last=$(grep -oE '^### TD[0-9]+\.' "$TRACKER" | grep -oE '[0-9]+' | sort -n | tail -1)
NEXT="TD$(( ${last:-0} + 1 ))"
TODAY=$(date +%Y-%m-%d)

# Scratch files live beside the tracker under unpredictable names, and the
# result is copied into the tracker so its owner and mode are kept.
DIR=$(dirname "$TRACKER")
ENTRY_FILE=$(mktemp "$DIR/.td-append-entry.XXXXXX")
OUT_FILE=$(mktemp "$DIR/.td-append-out.XXXXXX")
trap 'rm -f "$ENTRY_FILE" "$OUT_FILE"' EXIT
{
  printf '### %s. %s\n\n' "$NEXT" "$TITLE"
  printf -- '- **Source:** %s\n' "$SOURCE"
  printf -- '- **Severity:** %s\n' "$SEVERITY"
  printf -- '- **Confidence:** %s/10\n' "$CONFIDENCE"
  printf -- '- **Location:** %s\n' "$LOCATION"
  printf -- '- **Why it matters:** %s\n' "$WHY"
  printf -- '- **Suggested fix:** %s\n' "$FIX"
  printf -- '- **Enforce at:** %s\n' "$LAYER_LABEL"
  [ -n "$CHECK" ] && printf -- '- **Proposed check:** %s\n' "$CHECK"
  printf -- '- **Rule key:** %s\n' "$KEY"
  printf -- '- **Logged:** %s\n' "$TODAY"
} > "$ENTRY_FILE"

# Insert at the end of the Open section: before the next `## ` heading, or at EOF.
awk -v entry="$ENTRY_FILE" '
  function put() { while ((getline l < entry) > 0) print l; close(entry); print ""; done=1 }
  /^## / && open && !done { put() }
  /^## / { open = ($0 ~ /^## Open[[:space:]]*$/) }
  { print }
  END { if (open && !done) { print ""; put() } }
' "$TRACKER" > "$OUT_FILE"
cat "$OUT_FILE" > "$TRACKER"

echo "$NEXT"
