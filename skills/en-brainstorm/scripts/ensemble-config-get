#!/usr/bin/env bash
# ensemble-config-get — shared, fail-soft config reader (EN11).
#
# Resolves ONE flat key across Ensemble's config layers, first hit wins:
#   1. <repo>/.ensemble/config.local.yaml   (per-project)
#   2. ~/.ensemble/config.json              (per-machine)
#   3. --default <value>
#   4. empty
#
# Owning the cascade here means consumers never re-implement layering.
#
# Usage:
#   ensemble-config-get <key> [--legacy <old-key>]... [--default <value>]
#                             [--allowed <v1,v2,...>] [--strict] [--required]
#                             [--repo-root <dir>] [--home <dir>]
#
# --legacy names a retired spelling of <key>; repeat it for each generation
# (review_peer_* became peer_* in EN16, then the symmetric peer_<thing>_<host>
# names in D104). KEY PRECEDENCE OUTRANKS LAYER PRECEDENCE: <key> is tried
# across both layers first, then each <old-key> in the order given, so an
# operator who set the new name globally is not shadowed by a stale legacy line.
#
# Keys are FLAT (peer_effort_codex, not peer.effort.codex),
# matching every existing key in config.json and the `jq -r '.<key>'` read
# pattern in $SKILL_DIR/scripts/ensemble-detect-host.
#
# FAIL-SOFT BY CONSTRUCTION: a missing file, unreadable file, malformed
# JSON/YAML, absent jq, null/empty value, or a value outside --allowed all
# fall through to the next layer. This never exits non-zero for a config
# problem — a bad config must never take down a review.
#
# TWO OPT-OUTS, for the callers where that is the wrong trade (EN18 U2):
#   --strict    a value that is PRESENT but outside --allowed exits non-zero
#               instead of falling through. An ABSENT key still falls through.
#   --required  resolving to nothing at all (no layer, no --default) exits
#               non-zero.
# Both are off unless asked for, so every existing call site keeps the promise
# above. They exist because fail-soft is right for a model alias and wrong for
# a mode switch: `plan_store: Linear` silently reading as local mode means an
# operator commits a plan they believe was published, and nothing says
# otherwise. Exit 3 for both, distinct from 2 (usage).
#
# Fail-soft is not fail-silent. A config.json that does not parse discards
# EVERY key the operator set, and the default it falls back to can be the
# session's most expensive model. One hand-edited unquoted value did exactly
# that for a whole /en-plan run (2026-09-06). So malformed JSON prints one
# line to stderr naming the file and the parse error, then falls through as
# before; stdout and the exit code are unchanged.

set -u

KEY=""
LEGACY=""
DEFAULT=""
ALLOWED=""
STRICT=false
REQUIRED=false
REPO_ROOT="."
HOME_DIR="${HOME:-}"

usage() {
  echo "usage: ensemble-config-get <key> [--legacy <old-key>]... [--default <value>] [--allowed <v1,v2,...>] [--strict] [--required] [--repo-root <dir>] [--home <dir>]" >&2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --default)   [ $# -ge 2 ] || { usage; exit 2; }; DEFAULT="$2"; shift 2 ;;
    --legacy)    [ $# -ge 2 ] || { usage; exit 2; }; LEGACY="$LEGACY $2"; shift 2 ;;
    --allowed)   [ $# -ge 2 ] || { usage; exit 2; }; ALLOWED="$2"; shift 2 ;;
    --strict)    STRICT=true; shift ;;
    --required)  REQUIRED=true; shift ;;
    --repo-root) [ $# -ge 2 ] || { usage; exit 2; }; REPO_ROOT="$2"; shift 2 ;;
    --home)      [ $# -ge 2 ] || { usage; exit 2; }; HOME_DIR="$2"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    -*)          usage; exit 2 ;;
    *)           [ -z "$KEY" ] || { usage; exit 2; }; KEY="$1"; shift ;;
  esac
done

[ -n "$KEY" ] || { usage; exit 2; }

# --- validity -------------------------------------------------------------
# A value counts as ABSENT when it is empty, whitespace-only, the literal
# JSON null, or (with --allowed) outside the allowed set. Absent values fall
# through to the next layer rather than shadowing it — this is what lets
# `setup` ship the keys present-but-unset without masking the ladder, and
# what stops a typo like `turbo` from ever reaching a CLI.
# Split in two so --strict can distinguish "nobody set this" from "somebody set
# it wrong". is_valid keeps its original meaning: present AND allowed.
is_present() {
  case "$1" in
    ''|'null') return 1 ;;
  esac
  case "$1" in
    *[![:space:]]*) return 0 ;;
  esac
  return 1                  # whitespace-only
}

in_allowed() {
  [ -n "$ALLOWED" ] || return 0
  # Comma-delimited membership without touching IFS: wrapping both sides in
  # commas makes the substring test exact (",lo," does not match ",low,").
  case ",$ALLOWED," in
    *",$1,"*) return 0 ;;
  esac
  return 1
}

is_valid() { is_present "$1" && in_allowed "$1"; }

# A value the operator set that is not one we accept. Under --strict this is
# the end of the run, not a fall-through: the caller asked to be told.
strict_reject() {  # <key> <value>
  printf 'ensemble-config-get: %s is set to "%s", which is not one of: %s\n' \
    "$1" "$2" "$(printf '%s' "$ALLOWED" | tr ',' ' ')" >&2
  exit 3
}

# --- layer 1: repo YAML ---------------------------------------------------
# Supported grammar is deliberately NARROW (a hand-rolled parser cannot do
# general YAML safely): exactly one TOP-LEVEL, NON-INDENTED `key: value` line
# whose value is a plain or quoted scalar. Indented occurrences, nested
# lookalikes under a parent, block/flow collections, and duplicate keys are
# all treated as ABSENT. Unrelated nested sections (e.g. en-sweep's `sweep:`
# block) are ignored.
yaml_raw() {  # <file> <key>
  [ -r "$1" ] || return 0
  awk -v key="$2" '
    /^[[:space:]]/ { next }                 # indented: not top level
    /^[[:space:]]*#/ { next }               # comment line
    {
      i = index($0, ":")
      if (i == 0) next
      k = substr($0, 1, i - 1)
      if (k != key) next
      n++
      val = substr($0, i + 1)
    }
    END { if (n == 1) print val }           # duplicate key -> absent
  ' "$1" 2>/dev/null
}

# Strip an unquoted trailing comment, strip surrounding quotes, trim space.
# A `#` INSIDE quotes is literal; an unquoted " #" starts a comment.
yaml_clean() {
  printf '%s' "$1" | awk '
    {
      s = $0
      sub(/^[[:space:]]+/, "", s)
      if (s ~ /^"/) {
        rest = substr(s, 2); i = index(rest, "\"")
        if (i == 0) { print ""; exit }      # unterminated quote -> absent
        print substr(rest, 1, i - 1); exit
      }
      if (s ~ /^'"'"'/) {
        rest = substr(s, 2); i = index(rest, "'"'"'")
        if (i == 0) { print ""; exit }
        print substr(rest, 1, i - 1); exit
      }
      i = index(s, " #")
      if (i > 0) s = substr(s, 1, i - 1)
      sub(/[[:space:]]+$/, "", s)
      print s
    }'
}

REPO_FILE="$REPO_ROOT/.ensemble/config.local.yaml"

# --- layer 2 preflight: global JSON --------------------------------------
# Non-object roots, malformed JSON, and absent jq all fall through. The parse
# check runs once, before any lookup, so a malformed file warns once however
# many keys (or legacy spellings) this invocation tries.
GLOBAL_FILE="$HOME_DIR/.ensemble/config.json"
GLOBAL_OK=false
if [ -n "$HOME_DIR" ] && [ -r "$GLOBAL_FILE" ] && command -v jq >/dev/null 2>&1; then
  if parse_err=$(jq empty "$GLOBAL_FILE" 2>&1); then
    GLOBAL_OK=true
  else
    printf 'ensemble-config-get: %s is not valid JSON (%s); every key in it is ignored until it parses\n' \
      "$GLOBAL_FILE" "$(printf '%s' "$parse_err" | head -1)" >&2
  fi
fi

# lookup <key>: repo YAML, then global JSON. Prints the first valid value and
# returns 0; returns 1 when neither layer has one.
lookup() {
  local k="$1" raw val
  # --- layer 1: repo YAML ---
  if [ -f "$REPO_FILE" ]; then
    raw=$(yaml_raw "$REPO_FILE" "$k")
    if [ -n "$raw" ]; then
      val=$(yaml_clean "$raw")
      # A collection value (block or flow) is outside the supported grammar.
      case "$val" in
        '['*|'{'*) val="" ;;
      esac
      if is_valid "$val"; then printf '%s\n' "$val"; return 0; fi
      # Strict rejection keys on RAW presence, not on the cleaned value. `raw`
      # being non-empty means the operator wrote the key; `val` can still be
      # blank because the cleaner could not represent what they wrote (a flow
      # collection, an unterminated quote). Testing `val` let all three fall
      # through to the default as though nobody had set the key at all, which
      # is precisely the silent mode-selection failure --strict exists to
      # prevent: `plan_store: [linear]` resolved to `local`, exit 0, no warning.
      if [ "$STRICT" = true ]; then strict_reject "$k" "${val:-$(printf '%s' "$raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')}"; fi
    fi
  fi
  # --- layer 2: global JSON ---
  if [ "$GLOBAL_OK" = true ]; then
    # `// empty` would discard a literal `false` as well as null, because jq's
    # alternative operator treats both as "empty". A boolean key set to false
    # (e.g. skip_peer_on_lightweight) must resolve to "false", not fall through
    # to the next layer. Test membership explicitly and drop only null.
    val=$(jq -r --arg k "$k" '
            if type == "object" and has($k)
            then (.[$k] | if . == null then empty else . end)
            else empty end
          ' "$GLOBAL_FILE" 2>/dev/null) || val=""
    if is_valid "$val"; then printf '%s\n' "$val"; return 0; fi
    if [ "$STRICT" = true ] && is_present "$val"; then strict_reject "$k" "$val"; fi
  fi
  return 1
}

lookup "$KEY" && exit 0
for _old in $LEGACY; do lookup "$_old" && exit 0; done

# --- layer 3: caller default ---------------------------------------------
if [ -n "$DEFAULT" ]; then printf '%s\n' "$DEFAULT"; exit 0; fi

# --- layer 4: empty -------------------------------------------------------
# Nothing resolved. --required makes that the caller's problem to hear about,
# for a key with no sensible default: a Linear mode with no team cannot work,
# and failing here beats failing once a parent issue already exists.
if [ "$REQUIRED" = true ]; then
  printf 'ensemble-config-get: %s is required but is not set in any config layer\n' "$KEY" >&2
  exit 3
fi
exit 0
