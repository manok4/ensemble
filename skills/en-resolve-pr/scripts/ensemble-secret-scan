#!/usr/bin/env bash
# ensemble-secret-scan — look for credentials in the lines a push would ADD.
#
# The skill listed the patterns in a reference and left the scanning to prose, so
# every run hand-rolled a few greps. Hand-rolled greps drift: `grep -E` has no
# portable case-insensitive inline flag, so the (?i) patterns in the reference
# were silently case-sensitive, and the run that prompted this needed a temp file
# to get the pattern list past a git hook. A scan nobody can reproduce is not a
# guard, it is a habit.
#
# IT NEVER PRINTS THE SECRET.  Output carries the pattern name, the path, the
# line number and a masked preview (first four characters, rest starred). A
# scanner whose output is itself a leak has moved the secret from the diff into
# the terminal, the PR body and the transcript.
#
# ADDED LINES ONLY.  A credential already committed is a different problem, and
# one this run cannot fix by refusing to push. Scanning the whole file would
# block every push to a repo with one historical mistake in it, which trains
# people to pass --allow-secrets by reflex.
#
# A PUSH SENDS COMMITS.  --commits and --outgoing read each commit in the range:
# its own patch (a merge contributes only the lines no parent has, so a conflict
# resolution is scanned and its base is not), its message, and the paths its
# tree adds, which is how a binary file's name reaches the filename tier. Every
# finding names the commit that added it.
#
# Four tiers, from references/secret-patterns.md, which stays the source of
# truth for the list:
#   high      a credential shape with almost no false positives -> BLOCK
#   filename  a path that should never be committed at all      -> BLOCK
#   heuristic a shape that is often something else              -> WARN
#   notice    any match in a commit --outgoing finds already on the remote
#             -> NOTICE, never blocks: refusing the push cannot unexpose it,
#             so the remedy is rotating the key
#
# Usage:
#   ensemble-secret-scan [--staged | --working | --range <a>..<b> | --commits <a>..<b>
#                         | --outgoing <base-ref> [--remote <name>]]
#                        [--allow-secrets] [--json]
#
# --range reads one net diff. --commits walks every commit in the range, so a
# credential added in one commit and removed in a later one is still seen.
# --outgoing walks <base-ref>..HEAD and splits it by whether a <remote>
# (default origin) ref already holds each commit.
#
# Exit codes:
#   0  no blocking match (warnings and notices may still be reported)
#   1  a high-confidence pattern or a red-flag filename matched
#   2  usage error, or the scan itself failed: never read as clean or as a match
#
# --allow-secrets downgrades blocking matches to warnings and exits 0. It exists
# for cryptographic test vectors and documentation that shows a key's shape. The
# per-line escape hatch is the pragma, which is narrower and reviewable:
#   AWS_KEY = "AKIAIOSFODNN7EXAMPLE"  # pragma: ensemble-allow-secret

set -u

MODE="staged"; RANGE=""; REMOTE="origin"; REMOTE_SET=0; ALLOW=0; AS_JSON=0
die() { printf '%s\n' "$*" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --staged)        MODE="staged";  shift ;;
    --working)       MODE="working"; shift ;;
    --range)         [ $# -ge 2 ] || die "--range needs <a>..<b>"; MODE="range"; RANGE="$2"; shift 2 ;;
    --commits)       [ $# -ge 2 ] || die "--commits needs <a>..<b>"; MODE="commits"; RANGE="$2"; shift 2 ;;
    --outgoing)      [ $# -ge 2 ] || die "--outgoing needs <base-ref>"; MODE="outgoing"; RANGE="$2"; shift 2 ;;
    --remote)        [ $# -ge 2 ] || die "--remote needs <name>"; REMOTE="$2"; REMOTE_SET=1; shift 2 ;;
    --allow-secrets) ALLOW=1; shift ;;
    --json)          AS_JSON=1; shift ;;
    *) die "ensemble-secret-scan: unknown argument $1" ;;
  esac
done
[ "$REMOTE_SET" = 0 ] || [ "$MODE" = outgoing ] || die "ensemble-secret-scan: --remote applies only to --outgoing"
case "$RANGE$REMOTE" in -*) die "ensemble-secret-scan: a range or remote cannot start with '-'" ;; esac

git rev-parse --git-dir >/dev/null 2>&1 || die "ensemble-secret-scan: not a git repository"

# The diff goes through a file, not stdin: the scanner is a python heredoc, so
# stdin is already the program. It also keeps a large diff off the argument list.
DIFF_FILE=$(mktemp) || die "ensemble-secret-scan: cannot create a temp file"
trap 'rm -f "$DIFF_FILE"' EXIT
# The parser reads git's text, so git's rendering is pinned: no user or system
# config (color.ui=always, diff.noprefix, an external diff driver, rename
# detection) may change what it sees. These are diff options, so they follow
# the subcommand. --no-renames turns a rename into a delete plus an add, which
# puts the new name on a `+++` line where the filename tier reads it.
#
# Attributes are read from the empty tree, with --text besides: a pushed
# `*.txt -diff` or `binary` would otherwise turn a text file into "Binary files
# differ" and hide every line it adds, and --cc ignores --text. Replace refs
# are ignored, so the scan reads the objects the push sends. GIT_PINS are `-c`
# settings, which outrank every config file: diff.relative would drop paths
# outside the caller's directory, and a non-UTF-8 i18n.logOutputEncoding would
# re-encode a commit message past every pattern.
export GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1 GIT_NO_REPLACE_OBJECTS=1 GIT_PAGER=cat
GIT_ATTR_SOURCE=$(git hash-object -t tree /dev/null) || die "ensemble-secret-scan: cannot name the empty tree"
export GIT_ATTR_SOURCE
# GIT_ATTR_SOURCE needs git 2.40; an older git ignores it silently. Then a
# merge's combined diff that reports "Binary files" cannot be trusted, and the
# walk exits 2 on it rather than calling the merge clean. The override exists
# only so the test suite can exercise the old-git path on a new git.
ver=$(command git version | sed -n 's/^git version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
maj=${ver%% *}; min=${ver##* }
if [ -n "$ver" ] && { [ "$maj" -gt 2 ] || { [ "$maj" -eq 2 ] && [ "$min" -ge 40 ]; }; } \
   && [ "${ENSEMBLE_SECRET_SCAN_ASSUME_OLD_GIT:-0}" != 1 ]; then
  ENSEMBLE_ATTR_PINNED=1
else
  ENSEMBLE_ATTR_PINNED=0
  # Simulate the old git honestly: it would not apply the pin at all.
  [ "${ENSEMBLE_SECRET_SCAN_ASSUME_OLD_GIT:-0}" = 1 ] && unset GIT_ATTR_SOURCE
fi
export ENSEMBLE_ATTR_PINNED
GIT_PINS="-c core.attributesFile=/dev/null -c diff.relative=false -c i18n.logOutputEncoding=UTF-8 -c log.showSignature=false"
GIT_DIFF_FLAGS="--no-color --no-ext-diff --no-textconv --text --src-prefix=a/ --dst-prefix=b/ --no-renames"
# shellcheck disable=SC2086  # GIT_PINS is split on purpose
git() { command git $GIT_PINS "$@"; }
# --commits and --outgoing walk commits inside the Python below. A git that
# fails here is exit 2: an empty diff from a corrupt index is not a clean scan.
# shellcheck disable=SC2086  # GIT_DIFF_FLAGS is split on purpose
case "$MODE" in
  staged)  git diff $GIT_DIFF_FLAGS --cached > "$DIFF_FILE" || die "ensemble-secret-scan: git diff --cached failed" ;;
  working) { git diff $GIT_DIFF_FLAGS && git diff $GIT_DIFF_FLAGS --cached; } > "$DIFF_FILE" || die "ensemble-secret-scan: git diff failed" ;;
  range)   git diff $GIT_DIFF_FLAGS "$RANGE" > "$DIFF_FILE" || die "ensemble-secret-scan: bad range '$RANGE'" ;;
esac

# Exit 2 is "could not scan". An uncaught Python exception exits 1, which reads
# exactly like a credential, so every exit other than 0 or 1 becomes 2 and the
# body below turns its own exceptions into 2 before they get that far.
MODE="$MODE" RANGE="$RANGE" REMOTE="$REMOTE" GIT_DIFF_FLAGS="$GIT_DIFF_FLAGS" GIT_PINS="$GIT_PINS" \
ALLOW="$ALLOW" AS_JSON="$AS_JSON" DIFF_FILE="$DIFF_FILE" python3 - <<'PY'
import json, os, re, subprocess, sys

PRAGMA = "pragma: ensemble-allow-secret"

# Kept in the same order as references/secret-patterns.md so a reader can diff
# the two by eye, and tests/lint/ensemble-secret-scan.test.sh fails when the
# reference names a pattern this file does not implement.
HIGH = [
    ("aws-access-key-id",     r"AKIA[0-9A-Z]{16}"),
    ("aws-secret-access-key", r"(?i)aws_secret_access_key\s*=\s*[\"']?[A-Za-z0-9/+=]{40}"),
    ("github-pat",            r"ghp_[A-Za-z0-9_]{36,}"),
    ("github-oauth",          r"gho_[A-Za-z0-9_]{36,}"),
    ("github-user-token",     r"ghu_[A-Za-z0-9_]{36,}"),
    ("github-server-token",   r"ghs_[A-Za-z0-9_]{36,}"),
    ("slack-token",           r"xox[bpoa]-[0-9]+-[0-9]+-[0-9]+-[a-z0-9]{32}"),
    ("anthropic-api-key",     r"sk-ant-[A-Za-z0-9_-]{40,}"),
    ("openai-style-api-key",  r"sk-[A-Za-z0-9]{20,}"),
    ("private-key-block",     r"-----BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY-----"),
    ("bearer-token",          r"(?i)bearer\s+[A-Za-z0-9_\-\.=]{40,}"),
]
FILENAME = [
    ("dotenv-file",         r"(^|/)\.env(\.|$)"),
    ("ssh-private-key",     r"(^|/)id_(rsa|ed25519)$"),
    ("cert-or-key-file",    r"\.(pem|key)$"),
    ("secrets-config",      r"(^|/)secrets?\.(json|ya?ml|toml)$"),
    ("gcp-service-account", r"service-account.*\.json$"),
    ("credentials-dump",    r"(^|/)credentials\.(json|ya?ml)$"),
]
HEURISTIC = [
    ("hardcoded-password", r"(?i)password\s*=\s*[\"'][^\"']{6,}[\"']"),
    ("api-key-assignment", r"(?i)api[_-]?key\s*=\s*[\"'][^\"']{16,}[\"']"),
    ("secret-assignment",  r"(?i)secret\s*=\s*[\"'][^\"']{16,}[\"']"),
    ("long-hex-string",    r"\b[A-Fa-f0-9]{40,64}\b"),
]

# A hex value whose key ENDS in a digest word (`peer_review_plan_hash:`,
# `sha256:`, `"commit": "..."`) is a hash, not a key. Every plan's frontmatter
# carries one, so without this a scan of a plan branch's commits warns on every
# ship, and `git revert` and `cherry-pick -x` write "commit <sha>" into a
# message. The word must be the key's last segment: `shared_secret`,
# `hmac_sha256_key` and `commit_signing_key` merely contain one and still warn.
DIGEST_LABEL = re.compile(r"(?i)(?<![A-Za-z0-9])(hash|sha(1|224|256|384|512)?|digest|checksum|commit)[\"']?(\s*[:=]\s*[\"']?|\s+)$")

MESSAGE_PATH = "<commit-message>"
DIFF_FLAGS = os.environ["GIT_DIFF_FLAGS"].split()
GIT_PINS = os.environ["GIT_PINS"].split()


class ScanError(Exception):
    """Git could not answer a question the scan depends on: exit 2."""


def text(raw):
    # Diffs carry whatever bytes the files hold. Undecodable bytes are replaced,
    # never fatal: a Latin-1 file is not a reason to stop a push.
    return raw.decode("utf-8", errors="replace")


def git(*args):
    # An argument list, never a shell string, so no path or ref is re-parsed.
    r = subprocess.run(["git", *GIT_PINS, *args], capture_output=True)
    if r.returncode != 0:
        raise ScanError("git {}: {}".format(args[0], text(r.stderr).strip() or "exit {}".format(r.returncode)))
    return r.stdout


def nul_paths(raw):
    return {text(p) for p in raw.split(b"\0") if p}


C_ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "v": 11, "f": 12, "r": 13, '"': 34, "\\": 92}


def c_unquote(s):
    """git C-quotes a path holding unusual bytes: `"b/dir\\tx/.env"`. Undo it,
    so a matcher only ever sees the real path, never its display form."""
    if len(s) < 2 or s[0] != '"' or s[-1] != '"':
        return s
    out, i, end = bytearray(), 1, len(s) - 1
    while i < end:
        if s[i] == "\\" and re.match(r"[0-7]{3}", s[i + 1:i + 4]):
            out.append(int(s[i + 1:i + 4], 8)); i += 4
        elif s[i] == "\\" and i + 1 < end and s[i + 1] in C_ESCAPES:
            out.append(C_ESCAPES[s[i + 1]]); i += 2
        else:
            out += s[i].encode("utf-8"); i += 1
    return text(bytes(out))


def printable(value):
    """A decoded path is for matching. Printed raw, a crafted name holding a
    newline, an escape sequence, a bidi override or a Unicode line separator
    could forge or hide report lines in the terminal and the PR body, so every
    non-printable character, and backslash, prints as an escape."""
    def esc(c):
        if c != "\\" and c.isprintable():
            return c
        return "\\x{:02x}".format(ord(c)) if ord(c) < 0x100 else "\\u{:04x}".format(ord(c))
    return "".join(esc(c) for c in value)


def mask(value):
    """Never emit the credential. Four characters is enough to recognise the
    shape and not enough to use."""
    t = value.strip()
    if len(t) <= 4:
        return "*" * len(t)
    return t[:4] + "*" * min(len(t) - 4, 28)


class Scan:
    def __init__(self):
        self.findings, self.warnings, self.notices = [], [], []
        self.suppressed = 0
        self.named = set()

    def add(self, tier, pattern, path, line, preview, commit):
        f = {"tier": tier, "pattern": pattern, "path": path, "line": line, "preview": preview}
        if commit:
            f["commit"] = commit
        (self.warnings if tier == "heuristic" else self.findings).append(f)

    def check_path(self, path, commit):
        # A path can arrive from the patch and from the added-path listing.
        if (commit, path) in self.named:
            return
        self.named.add((commit, path))
        for pattern, rx in FILENAME:
            if re.search(rx, path):
                self.add("filename", pattern, path, 0, "", commit)

    def check_line(self, line, path, lineno, commit):
        if PRAGMA in line:
            self.suppressed += 1
            return
        for pattern, rx in HIGH:
            m = re.search(rx, line)
            if m:
                self.add("high", pattern, path, lineno, mask(m.group(0)), commit)
                return
        for pattern, rx in HEURISTIC:
            # Every match, not the first: a labelled commit SHA must not hide an
            # unlabelled hex value later on the same line.
            m = next((x for x in re.finditer(rx, line)
                      if not (pattern == "long-hex-string" and DIGEST_LABEL.search(line[:x.start()]))), None)
            if m:
                self.add("heuristic", pattern, path, lineno, mask(m.group(0)), commit)
                return

    def patch(self, diff, commit=None):
        """Scan the lines a patch adds. A combined (merge) hunk has one marker
        column per parent; a line counts as added only when every column is `+`,
        meaning no parent had it. A line one parent had is that parent's to
        answer for, and its own commit is scanned or already on the base."""
        path, cols, new_line, in_hunk, combined = None, 1, 0, False, False
        for raw in diff.split("\n"):
            if raw.startswith(("diff --git ", "diff --cc ", "diff --combined ")):
                path, in_hunk = None, False
                combined = not raw.startswith("diff --git ")
                continue
            if (combined and not in_hunk and raw.startswith("Binary files")
                    and os.environ.get("ENSEMBLE_ATTR_PINNED") != "1"):
                raise ScanError("a merge diff reports a binary file, and this git (before 2.40) "
                                "cannot pin attributes to show it; cannot scan")
            if raw.startswith("@@"):  # a hunk body line never starts with "@@"
                in_hunk = True
                cols = len(raw) - len(raw.lstrip("@")) - 1
                m = re.search(r"\+(\d+)", raw)
                new_line = int(m.group(1)) if m else 0
                continue
            if not in_hunk:
                if raw.startswith("+++ "):
                    # git pads a name holding a space with a tab, and quotes one
                    # holding unusual bytes.
                    shown = c_unquote(raw[4:].rstrip("\t"))
                    path = shown[2:] if shown.startswith("b/") else None
                    if path:
                        self.check_path(path, commit)
                continue
            if raw.startswith("\\"):  # "\ No newline at end of file"
                continue
            markers = raw[:cols]
            if "-" in markers:
                continue
            if markers == "+" * cols:
                self.check_line(raw[cols:], path or "?", new_line, commit)
            new_line += 1

    def message(self, msg, commit):
        for n, line in enumerate(msg.split("\n"), 1):
            self.check_line(line, MESSAGE_PATH, n, commit)

    def demote(self, since_f, since_w):
        """Everything found since the marks becomes a notice."""
        for f in self.findings[since_f:] + self.warnings[since_w:]:
            f["tier"] = "notice"
            self.notices.append(f)
        del self.findings[since_f:]
        del self.warnings[since_w:]


def added_paths(sha, parents):
    """Paths the commit's tree has and none of its parents' trees have. This is
    how a binary file (no `+++` line) and a file only a merge introduced reach
    the filename tier."""
    if not parents:
        return nul_paths(git("diff-tree", "-z", "--root", "-r", "--no-commit-id", "--name-only",
                             "--no-renames", "--diff-filter=A", sha))
    return set.intersection(*(nul_paths(git("diff", "-z", "--no-renames", "--name-only",
                                            "--diff-filter=A", p, sha)) for p in parents))


def walk(scan, rng, unpushed=None):
    """Scan every commit in rng. With unpushed given, a commit outside it is
    already on the remote and its findings become notices."""
    try:
        commits = [line.split() for line in text(git("rev-list", "--reverse", "--parents", rng)).splitlines()]
    except ScanError as exc:
        raise ScanError("ensemble-secret-scan: bad range '{}' ({})".format(rng, exc))
    for sha, *parents in commits:
        short = sha[:7]
        marks = (len(scan.findings), len(scan.warnings))
        # --root: log.showRoot=false would otherwise hide a root commit's patch.
        scan.patch(text(git("log", *DIFF_FLAGS, "--no-show-signature", "--root", "-1", "-p", "--cc",
                            "--format=", sha)), short)
        scan.message(text(git("log", "--no-show-signature", "-1", "-z", "--format=%B", sha)).rstrip("\0"), short)
        for path in sorted(added_paths(sha, parents)):
            scan.check_path(path, short)
        if unpushed is not None and sha not in unpushed:
            scan.demote(*marks)


def main():
    mode, rng, remote = os.environ["MODE"], os.environ["RANGE"], os.environ["REMOTE"]
    allow = os.environ["ALLOW"] == "1"
    as_json = os.environ["AS_JSON"] == "1"
    scan = Scan()

    if mode == "commits":
        walk(scan, rng)
    elif mode == "outgoing":
        try:
            git("rev-parse", "--verify", "--quiet", rng + "^{commit}")
        except ScanError:
            raise ScanError("ensemble-secret-scan: unknown base ref '{}'".format(rng))
        span = rng + "..HEAD"
        # With no <remote> refs at all nothing is excluded, so every commit
        # counts as unpushed, which is the right answer for a branch never fetched.
        unpushed = set(text(git("rev-list", span, "--not", "--remotes=" + remote)).split())
        walk(scan, span, unpushed)
    elif mode in ("staged", "working", "range"):
        with open(os.environ["DIFF_FILE"], "rb") as fh:
            scan.patch(text(fh.read()))
    else:
        raise ScanError("ensemble-secret-scan: no scanner for mode '{}'".format(mode))

    findings, warnings, notices = scan.findings, scan.warnings, scan.notices
    blocking = bool(findings) and not allow
    if allow:
        warnings = findings + warnings
        findings = []

    result = {
        "blocking": blocking,
        "findings": findings,
        "warnings": warnings,
        "notices": notices,
        "suppressed_by_pragma": scan.suppressed,
        "allow_secrets": allow,
    }

    if as_json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        def render(label, f):
            # A filename finding is about the whole path, so it carries line 0.
            where = f["path"] if not f["line"] else "{path}:{line}".format(**f)
            parts = [f["pattern"], printable(where)] + ([printable(f["preview"])] if f["preview"] else [])
            parts += ["commit " + f["commit"]] if "commit" in f else []
            print("{}  {}".format(label, "  ".join(parts)))
        for f in findings:
            render("BLOCK ", f)
        for w in warnings:
            render("WARN  ", w)
        for n in notices:
            render("NOTICE", n)
        if scan.suppressed:
            print("note: {} line(s) suppressed by '{}'".format(scan.suppressed, PRAGMA))
        if not (findings or warnings or notices):
            print("secret-scan: clean")

    return 1 if blocking else 0


try:
    sys.exit(main())
except ScanError as exc:
    sys.stderr.write("{}\n".format(exc))
    sys.exit(2)
except Exception as exc:  # SystemExit is not an Exception, so 0 and 1 pass through
    sys.stderr.write("ensemble-secret-scan: internal error: {}\n".format(type(exc).__name__))
    sys.exit(2)
PY
rc=$?
case "$rc" in 0|1) exit "$rc" ;; *) exit 2 ;; esac
