#!/usr/bin/env bash
# ensemble-cli-smoke — shared CLI smoke-probe + failure classifier (EN10).
#
# Sourced by ./setup AND tests/lint/en-codex-flag-drift.test.sh so the test
# exercises the REAL classifier rather than a copy that could drift. Pure
# functions, no top-level side effects, safe to source under `set -eu`.

# Classify a probe result from its stderr + exit code.
#   $1 = captured stderr text   $2 = exit code
#   prints one of: ok | flagdrift | auth | unknown
ensemble_smoke_classify() {
  if [ "${2:-1}" -eq 0 ]; then echo ok; return 0; fi
  if printf '%s' "${1:-}" | grep -qiE 'unexpected argument|unrecognized (option|argument|subcommand)|invalid (option|value)|USAGE:|error: unknown'; then
    echo flagdrift; return 0
  fi
  if printf '%s' "${1:-}" | grep -qiE 'not logged in|unauthorized|authentication|not authenticated|please (run )?login|setup-token|sign in'; then
    echo auth; return 0
  fi
  echo unknown
}

# Run a probe command and print one classified, human-readable line.
#   $1 = label   $2.. = command to run
# Errexit-safe: the `if err=$(...)` form captures a non-zero exit without
# tripping `set -e` (a bare `err=$(...); rc=$?` would abort under errexit).
ensemble_smoke_probe() {
  _smoke_label="$1"; shift
  if _smoke_err=$("$@" </dev/null 2>&1 >/dev/null); then _smoke_rc=0; else _smoke_rc=$?; fi
  _smoke_class=$(ensemble_smoke_classify "$_smoke_err" "$_smoke_rc")
  case "$_smoke_class" in
    ok)        printf '  %s: ✓ flags accepted\n' "$_smoke_label" ;;
    flagdrift) printf '  %s: ⚠ flag drift — the installed CLI rejected a flag; check references/cli-wrappers.md\n' "$_smoke_label" ;;
    auth)      printf '  %s: ⚠ not authenticated — sign in first (Claude: `claude` / `claude setup-token`; Codex: `codex login`), then re-run\n' "$_smoke_label" ;;
    *)         printf '  %s: ⚠ probe failed — %s\n' "$_smoke_label" "$(printf '%s' "$_smoke_err" | head -n1)" ;;
  esac
}
