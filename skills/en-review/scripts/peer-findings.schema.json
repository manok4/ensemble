{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ensemble peer review findings",
  "description": "The object ensemble-build-peer-prompt asks the peer for. Passed to the peer CLI as its output schema so a malformed answer is refused at the source instead of recovered after the fact (D81). STRICT on purpose: Codex's --output-schema (OpenAI structured outputs) requires additionalProperties:false on every object and every property listed in required, so optional fields are nullable rather than absent (2026-09-08, Codex CLI 0.153.2 returned invalid_json_schema without it). Field semantics: references/peer-contract.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "peer_mode",
    "summary",
    "findings",
    "coverage"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "reject"
      ]
    },
    "peer_mode": {
      "type": "string",
      "enum": [
        "cross-agent",
        "single-agent-fallback"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "confidence",
          "title",
          "location",
          "why_it_matters",
          "suggested_fix",
          "u_id",
          "autofix_class",
          "covers_requirement"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9]+-[0-9]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "suggested_fix": {
            "type": "string"
          },
          "u_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "U<N> when the finding is about a plan unit, else null"
          },
          "autofix_class": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "safe_auto",
              "gated_auto",
              "manual",
              "advisory",
              null
            ]
          },
          "covers_requirement": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "reviewed",
        "not_reviewed"
      ],
      "properties": {
        "reviewed": {
          "type": "string"
        },
        "not_reviewed": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
