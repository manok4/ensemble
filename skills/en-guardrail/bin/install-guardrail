#!/usr/bin/env bash
# install-guardrail — manage the en-guardrail PreToolUse hook in settings.json.
#
# Commands:
#   status                       Report whether the hook is installed (project + global).
#   install-project              Merge into <cwd>/.claude/settings.json.   Agent-safe.
#   install-global               Print the one-liner for the user to run from a real shell.
#   install-global --apply       Actually merge into ~/.claude/settings.json. Run this
#                                from your terminal — agents are blocked from editing
#                                their own global config.
#   uninstall-project            Remove the hook from <cwd>/.claude/settings.json.
#
# Env: GUARDRAIL_SETTINGS_FILE=PATH overrides the target file (used by tests).
#
# All mutations back up the existing file first as <file>.bak.<unix-ts>.

set -euo pipefail

CMD="${1:-help}"

# The hook command names THIS checkout's check-guardrail.sh by absolute path,
# resolved from where this installer sits. It used to write a literal
# ${ENSEMBLE_HOME:-$HOME/CodeRepo/ensemble}/... default, one developer's
# machine path, so on any other machine the hook command pointed at nothing
# and a failing hook is a non-blocking error: the guardrail was silently off
# (D93). If the checkout moves, re-run the installer.
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
HOOK_SCRIPT="$SELF_DIR/check-guardrail.sh"
[ -f "$HOOK_SCRIPT" ] || { echo "error: $HOOK_SCRIPT not found beside the installer" >&2; exit 1; }

require_python() {
  command -v python3 >/dev/null 2>&1 || { echo "error: python3 required" >&2; exit 1; }
}

# Single source of truth for the hook block. Echoed verbatim into the merge step.
read -r -d '' HOOK_PY <<'PY' || true
import json, os, sys

path = sys.argv[1]
mode = sys.argv[2]  # install | uninstall | status
hook_script = sys.argv[3]

try:
    with open(path) as f:
        data = json.load(f)
except FileNotFoundError:
    data = {}
except json.JSONDecodeError as e:
    print(f"error: {path} is not valid JSON: {e}", file=sys.stderr)
    sys.exit(2)

hooks = data.get("hooks", {}).get("PreToolUse", [])

def is_guardrail_command(cmd):
    return "en-guardrail" in cmd and "check-guardrail.sh" in cmd

HOOK_CMD = 'bash "%s"' % hook_script
# EN09 U4/B2: a second matcher routes DB-writing MCP tools to the same hook.
# Action-specific families are server-agnostic (run_sql, apply_migration, ...);
# the ambiguous generic-named tools (query/execute) are server-QUALIFIED so the
# matcher doesn't intercept unrelated MCP tools (F15). The hook's adapter
# registry makes the precise ask/allow decision.
MCP_MATCHER = (r"mcp__.*__(run_sql|run_sql_transaction|execute_sql|"
               r"apply_migration|prepare_database_migration)|"
               r"mcp__Postgres__(query|execute)")

def matcher_installed(matcher):
    for entry in hooks:
        if entry.get("matcher") != matcher:
            continue
        for h in entry.get("hooks", []):
            if is_guardrail_command(h.get("command", "")):
                return True
    return False

def registered_script_path():
    # The path inside: bash "<path>"  -- expand $HOME/${HOME} for the check only.
    for entry in hooks:
        for h in entry.get("hooks", []):
            cmd = h.get("command", "")
            if is_guardrail_command(cmd) and '"' in cmd:
                p = cmd.split('"')[1]
                return os.path.expandvars(p.replace("${ENSEMBLE_HOME:-$HOME/CodeRepo/ensemble}", os.environ.get("ENSEMBLE_HOME", os.path.expanduser("~/CodeRepo/ensemble"))))
    return None

def already_installed():
    # "Installed" for status purposes = the primary Bash matcher is present.
    return matcher_installed("Bash")

def make_hook(matcher, msg):
    return {
        "matcher": matcher,
        "hooks": [{"type": "command", "command": HOOK_CMD, "statusMessage": msg}],
    }

if mode == "status":
    if not already_installed():
        print("no")
    else:
        p = registered_script_path()
        print("yes" if p and os.path.isfile(p) else "broken")
    sys.exit(0)

if mode == "install":
    added = False
    pre = data.setdefault("hooks", {}).setdefault("PreToolUse", [])
    if not matcher_installed("Bash"):
        pre.append(make_hook("Bash", "Checking for destructive commands..."))
        added = True
    if not matcher_installed(MCP_MATCHER):
        pre.append(make_hook(MCP_MATCHER, "Checking MCP DB tool for destructive statements..."))
        added = True
    if not added:
        print("noop")
        sys.exit(0)

elif mode == "uninstall":
    pre = data.get("hooks", {}).get("PreToolUse", [])
    new_pre = []
    for entry in pre:
        # Strip guardrail commands from ANY matcher (Bash or the MCP matcher).
        kept = [h for h in entry.get("hooks", []) if not is_guardrail_command(h.get("command", ""))]
        if kept:
            entry["hooks"] = kept
            new_pre.append(entry)
        elif not entry.get("hooks"):
            # entry had no hooks list at all; preserve as-is
            new_pre.append(entry)
    if new_pre:
        data["hooks"]["PreToolUse"] = new_pre
    else:
        data.get("hooks", {}).pop("PreToolUse", None)
        if not data.get("hooks"):
            data.pop("hooks", None)

else:
    print(f"error: unknown mode {mode}", file=sys.stderr)
    sys.exit(2)

tmp = path + ".tmp"
os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
with open(tmp, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
print("ok")
PY

run_py() {
  local file="$1" mode="$2"
  require_python
  python3 -c "$HOOK_PY" "$file" "$mode" "$HOOK_SCRIPT"
}

backup_if_exists() {
  local file="$1"
  if [ -f "$file" ]; then
    cp "$file" "${file}.bak.$(date +%s)"
  fi
}

project_settings_path() {
  printf '%s' "${GUARDRAIL_SETTINGS_FILE:-./.claude/settings.json}"
}

global_settings_path() {
  printf '%s' "${HOME}/.claude/settings.json"
}

case "$CMD" in
  status)
    proj=$(project_settings_path)
    glob=$(global_settings_path)
    p="no"; g="no"
    [ -f "$proj" ] && p=$(run_py "$proj" status 2>/dev/null || echo "no")
    [ -f "$glob" ] && g=$(run_py "$glob" status 2>/dev/null || echo "no")
    echo "guardrail status:"
    echo "  project (${proj}): ${p}"
    echo "  global  (${glob}): ${g}"
    [ "$p" = "broken" ] || [ "$g" = "broken" ] && echo "  broken = registered, but the command points at a check-guardrail.sh that does not exist; re-run the installer"
    if [ "$p" = "yes" ] || [ "$g" = "yes" ]; then exit 0; else exit 1; fi
    ;;

  install-project)
    file=$(project_settings_path)
    backup_if_exists "$file"
    result=$(run_py "$file" install)
    if [ "$result" = "noop" ]; then
      echo "guardrail: already installed at $file (no change)"
    else
      echo "guardrail: installed at $file"
    fi
    ;;

  install-global)
    apply="${2:-}"
    if [ "$apply" = "--apply" ]; then
      file=$(global_settings_path)
      backup_if_exists "$file"
      result=$(run_py "$file" install)
      if [ "$result" = "noop" ]; then
        echo "guardrail: already installed at $file (no change)"
      else
        echo "guardrail: installed at $file"
      fi
    else
      sed -e "s|__INSTALLER__|$SELF_DIR/install-guardrail|" -e "s|__HOOK__|$HOOK_SCRIPT|" <<'EOF'
The agent cannot modify ~/.claude/settings.json directly (self-modification guardrail).
To install the guardrail hook globally, run this from your terminal:

  bash "__INSTALLER__" install-global --apply

It registers both matchers (Bash and the DB-writing MCP tools) and points them at
__HOOK__ by absolute path. If you move the checkout, run it again.
EOF
    fi
    ;;

  uninstall-project)
    file=$(project_settings_path)
    [ -f "$file" ] || { echo "no settings file at $file"; exit 0; }
    backup_if_exists "$file"
    run_py "$file" uninstall >/dev/null
    echo "guardrail: uninstalled from $file"
    ;;

  help|--help|-h)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    echo "unknown command: $CMD" >&2
    echo "run '$0 help' for usage" >&2
    exit 1
    ;;
esac
