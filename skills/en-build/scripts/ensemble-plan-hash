#!/usr/bin/env bash
# ensemble-plan-hash — the single implementation of `peer_review_plan_hash`.
#
# /en-plan writes this value at promotion; /en-build adopts it as the build's
# baseline and re-computes at every phase boundary, refusing to advance on
# mismatch (SKILL.md, step 4a and the phase-boundary check).
#
# It exists because the contract was previously prose only
# (rationale in the Ensemble repo's scope-aware-slicing spec, which does not ship
# with the skill). Two agents each canonicalizing from
# that prose cannot be expected to agree — and no model can compute sha256 in
# the first place, so each run would shell out with its own ad-hoc
# canonicalization. A hash whose producer and consumer disagree does not detect
# tampering; it just refuses a legitimate build at the first phase boundary and
# blames the user for editing the plan. One implementation, called by both.
#
# Usage:
#   ensemble-plan-hash <plan-path>          # print the hash
#   ensemble-plan-hash --canon <plan-path>  # print the canonical form (debugging)
#   ensemble-plan-hash --full <plan-path>   # the full-mapping digest (Linear mode)
#
# Covered (immutable plan inputs): per unit, in U-ID order as written —
#   Goal, Files, Approach, Risk, Category, Gated, Dependencies
# plus plan-level `depth` and `data_scale`.
#
# Excluded (mutable, managed by /en-build): the iteration log, per-unit status,
# and peer_review_resolutions. Editing any of those must NOT change the hash.
#
# --full widens the per-unit set to EVERY `- **Label:**` bullet in the unit,
# in the order written, label included: Test scenarios, Verification,
# Interfaces and the rest. Per-unit Status stays excluded, as above. It also
# covers the text before the first `## ` heading (the title and any preamble)
# and every plan-level `## ` section, the iteration log included,
# whitespace-collapsed: an edit in Linear to Out of scope changes what gets
# built as surely as an edit to a unit, and a section the digest skipped was
# a channel into the build nothing checked. It is a second value, never a
# replacement. The default hash is the phase-boundary baseline every open plan already records,
# so widening it would refuse those plans at their next boundary. Linear mode
# records the --full digest at publish and compares it at materialization,
# because a Linear description can be edited by anyone with team access and
# the default hash would let an edit to Test scenarios through.

set -u

CANON_ONLY="false"
FULL="false"
PLAN=""
while [ $# -gt 0 ]; do
  case "$1" in
    --canon) CANON_ONLY="true"; shift ;;
    --full)  FULL="true"; shift ;;
    -h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "ensemble-plan-hash: unknown flag: $1" >&2; exit 2 ;;
    *) PLAN="$1"; shift ;;
  esac
done

if [ -z "$PLAN" ]; then
  echo "ensemble-plan-hash: a plan path is required" >&2
  exit 2
fi
if [ ! -f "$PLAN" ]; then
  echo "ensemble-plan-hash: no such plan: $PLAN" >&2
  exit 2
fi

# Canonicalization, kept deliberately dull so it is reproducible by inspection:
#   - a `U:<U-ID>` line per unit, then one `<label>:<length>:<value>` line per
#     field: the seven hashed fields in fixed order, or under --full every
#     labelled field in the order written
#   - field values have runs of whitespace collapsed to one space and are trimmed
#   - a field absent from a unit contributes an empty string, never a skipped field
#   - units appear in the order they occur in the file
#   - under --full, one `S:<heading>:<length>:<text>` line for the preamble
#     (`S:(preamble)`) and for each plan-level `## ` section
#   - final `depth:` and `data_scale:` lines
# Whitespace collapsing is what lets a reflow of a hashed field not read as a
# semantic edit; anything beyond that is a real change and must move the hash.
_canon() {
  awk -v full="$FULL" '
    # A field value is its label line PLUS every continuation line up to the
    # next field, unit, or section. Capturing only the label line let a
    # multi-paragraph Approach be rewritten without moving the hash, which is
    # exactly the tampering this value exists to detect.
    #
    # Fields are emitted length-prefixed rather than pipe-joined. Concatenating
    # with a bare delimiter lets pipe characters move across a field boundary
    # and produce identical canonical bytes for two different plans.
    function put(k, v) {
      gsub(/[[:space:]]+/, " ", v); gsub(/^ | $/, "", v)
      printf "%s:%d:%s\n", k, length(v), v
    }
    function close_field() {
      if (cur != "") {
        if (full == "true") { if (cur != "Status") { nf++; fl[nf] = cur; fv[nf] = buf } }
        else if (!(cur in f)) f[cur] = buf
        cur = ""; buf = ""
      }
    }
    function flush(   i, order, n) {
      close_field()
      if (uid == "") return
      printf "U:%s\n", uid
      if (full == "true") {
        for (i = 1; i <= nf; i++) put(fl[i], fv[i])
      } else {
        n = split("Goal,Files,Approach,Risk,Category,Gated,Dependencies", order, ",")
        for (i = 1; i <= n; i++) put(order[i], (order[i] in f) ? f[order[i]] : "")
      }
      uid = ""; nf = 0
      for (i in f) delete f[i]
    }
    function close_sec() {
      if (sec != "") { ns++; sl[ns] = sec; sv[ns] = sbuf }
      sec = ""; sbuf = ""
    }
    # The title and any preamble: body text before the first `## ` heading.
    full == "true" && dashes >= 2 && !seen_h2 && uid == "" && sec == "" && !/^---[[:space:]]*$/ && !/^## / && !/^### U[0-9]+\./ {
      pbuf = pbuf " " $0; next
    }
    /^---[[:space:]]*$/ { dashes++; next }
    dashes == 1 && /^depth:/      { depth = $2; next }
    dashes == 1 && /^data_scale:/ { scale = $2; next }
    /^### U[0-9]+\./ {
      flush()
      if (full == "true") close_sec()
      match($0, /U[0-9]+/); uid = substr($0, RSTART, RLENGTH)
      next
    }
    # A level-2 heading ends the units section, so trailing prose using the same
    # bullet labels (the template prescribes "- **Risk:**" under "## Decisions,
    # assumptions & risks") cannot bleed into the last unit.
    /^## / {
      seen_h2 = 1
      flush()
      if (full == "true") {
        close_sec()
        sec = substr($0, 4); sub(/[[:space:]]+$/, "", sec)
      }
      next
    }
    full == "true" && uid == "" && sec != "" { sbuf = sbuf " " $0; next }
    uid != "" && (full == "true" ? /^- \*\*[A-Za-z ]+:\*\*/ : /^- \*\*(Goal|Files|Approach|Risk|Category|Gated|Dependencies):\*\*/) {
      close_field()
      match($0, /\*\*[A-Za-z ]+:/)
      cur = substr($0, RSTART + 2, RLENGTH - 3)
      line = $0
      sub(/^- \*\*[A-Za-z ]+:\*\*[[:space:]]*/, "", line)
      buf = line
      next
    }
    # Any other "- **Label:**" bullet closes the current field without starting
    # a new one, so an unhashed field cannot be absorbed as continuation.
    uid != "" && /^- \*\*[A-Za-z ]+:\*\*/ { close_field(); next }
    uid != "" && cur != "" { buf = buf " " $0; next }
    END {
      flush()
      if (full == "true") {
        close_sec(); put("S:(preamble)", pbuf)
        for (i = 1; i <= ns; i++) put("S:" sl[i], sv[i])
      }
      put("depth", depth); put("data_scale", scale)
    }
  ' "$PLAN"
}

if [ "$CANON_ONLY" = "true" ]; then
  _canon
  exit 0
fi

if command -v shasum >/dev/null 2>&1; then
  _canon | shasum -a 256 | awk '{print $1}'
elif command -v sha256sum >/dev/null 2>&1; then
  _canon | sha256sum | awk '{print $1}'
else
  echo "ensemble-plan-hash: need shasum or sha256sum on PATH" >&2
  exit 3
fi
