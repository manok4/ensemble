#!/usr/bin/env python3
# ensemble-linear-plan — the one implementation of the Linear plan transforms.
#
# EN18 left every transform to the model: turning a plan into issue payloads,
# turning read-back issues into a plan, and comparing the two. None of those
# could carry a negative control, and the plan-level sections (Context, Out of
# scope, Technical design, Decisions) never reached Linear at all. This script
# owns the transforms; the model still makes every Linear call over MCP (D119).
# It never talks to Linear and needs no credential.
#
# Usage:
#   ensemble-linear-plan render <plan> [--repo <id>]
#       Print the publish payload as JSON: plan_id, repo, the parent's title and
#       description (the plan with its unit blocks removed, then a Verification
#       Contract), and one entry per unit with title, description, blocked_by.
#   ensemble-linear-plan materialize <readback.json> [--out <path>]
#       Rebuild the plan file from saved get_issue results:
#       {"parent": {...}, "sub_issues": [{...}, ...]}. Prints to stdout unless
#       --out is given.
#   ensemble-linear-plan verify <plan> <readback.json>
#       Exit 0 when the read-back materializes to the same plan: both digests,
#       the frontmatter, every plan-level section and every unit, with
#       `## Iteration log` excepted everywhere. Else exit 3 with a unified diff
#       of the first difference.
#
# Exit codes: 0 ok, 2 usage, 3 refused or mismatched (the reason on stderr).
#
# Rules, each measured against a live workspace or stated as unmeasured in
# references/linear-plan-format.md:
#   - Linear rewrites list markers `- ` to `* `. materialize puts them back,
#     outside code fences, including inside blockquotes.
#   - list_issues truncates descriptions. A description still carrying the
#     truncation marker is refused, never taken as content.
#   - Units are ordered by the (U<N>) title suffix, never by Linear's order.
#   - A canceled sub-issue is not a unit. That is how an amend removes one.

import difflib
import json
import os
import re
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.abspath(__file__))
PLAN_HASH = os.path.join(HERE, "ensemble-plan-hash")
TRUNCATION = "(truncated, use get_issue for full description)"
CONTRACT = "## Verification Contract"
UNITS_HEADING = "## Implementation units"
EXCLUDED_SECTION = "Iteration log"
ADDED_KEYS = ("plan_full_hash", "repo")
UNIT_RE = re.compile(r"^### (U\d+)\.\s*(.*)$")
SUFFIX_RE = re.compile(r"\((U\d+)\)\s*$")
FENCE_RE = re.compile(r"^\s*(```|~~~)")


class Refusal(Exception):
    pass


# --- plan parsing ---------------------------------------------------------

def split_frontmatter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        raise Refusal("plan has no frontmatter")
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            return lines[1:i], "\n".join(lines[i + 1:])
    raise Refusal("plan frontmatter is not closed")


def fm_value(fm_lines, key):
    for line in fm_lines:
        if line.startswith(key + ":"):
            return line[len(key) + 1:].strip()
    return ""


def outside_fences(lines):
    """Yield (index, line, in_fence) so headings inside code blocks are ignored."""
    fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            yield i, line, True
            fence = not fence
            continue
        yield i, line, fence


def parse_body(body):
    """Split a plan body into (skeleton_lines, units).

    skeleton is the body with every unit block removed and the position of the
    units recorded as the end of the `## Implementation units` preamble. units
    is a list of (u_id, title, block_lines) in file order.
    """
    lines = body.split("\n")
    units_start = None
    units_end = len(lines)
    for i, line, fence in outside_fences(lines):
        if fence:
            continue
        if units_start is None and line.strip() == UNITS_HEADING:
            units_start = i
        elif units_start is not None and line.startswith("## "):
            units_end = i
            break
    if units_start is None:
        raise Refusal("plan has no `## Implementation units` section")

    first_unit = None
    units = []
    cur = None
    for i in range(units_start + 1, units_end):
        m = UNIT_RE.match(lines[i])
        if m:
            if first_unit is None:
                first_unit = i
            cur = [m.group(1), m.group(2).strip(), []]
            units.append(cur)
        elif cur is not None:
            cur[2].append(lines[i])
    if not units:
        raise Refusal("plan has no units")
    for uid, title, _ in units:
        if not title:
            raise Refusal(f"{uid} has no title")
    seen = set()
    for uid, _, _ in units:
        if uid in seen:
            raise Refusal(f"two units claim {uid}")
        seen.add(uid)

    skeleton = lines[:first_unit] + ["<<UNITS>>"] + lines[units_end:]
    return skeleton, [(u, t, trim(b)) for u, t, b in units]


def trim(block):
    while block and not block[0].strip():
        block = block[1:]
    while block and not block[-1].strip():
        block = block[:-1]
    return block


def sections(body):
    """Return [(heading, text)] for every `## ` section, units removed."""
    skeleton, _ = parse_body(body)
    out = []
    cur_head, cur = None, []
    for _, line, fence in outside_fences(skeleton):
        if not fence and line.startswith("## "):
            if cur_head is not None:
                out.append((cur_head, cur))
            cur_head, cur = line[3:].strip(), []
        elif cur_head is not None and line != "<<UNITS>>":
            cur.append(line)
    if cur_head is not None:
        out.append((cur_head, cur))
    return [(h, "\n".join(trim(t))) for h, t in out if h != EXCLUDED_SECTION]


def collapse(text):
    return " ".join(text.split())


# --- repo identity --------------------------------------------------------

def repo_identity(start_dir):
    try:
        url = subprocess.run(["git", "-C", start_dir, "remote", "get-url", "origin"],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        raise Refusal("no `origin` remote: linear mode needs a repo identity no other repo can claim")
    return normalize_repo(url)


def normalize_repo(url):
    u = url.strip()
    u = re.sub(r"^[a-z][a-z0-9+.-]*://", "", u)   # scheme
    u = re.sub(r"^[^@/]+@", "", u)                 # userinfo
    u = re.sub(r"^([^/:]+):(?!\d+/)", r"\1/", u)   # scp-style host:path
    u = re.sub(r"\.git/?$", "", u).rstrip("/")
    return u.lower()


# --- hashing --------------------------------------------------------------

def plan_hash(path, full=False):
    cmd = ["bash", PLAN_HASH] + (["--full"] if full else []) + [path]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise Refusal(f"ensemble-plan-hash failed: {r.stderr.strip()}")
    return r.stdout.strip()


# --- render ---------------------------------------------------------------

def render(plan_path, repo):
    text = open(plan_path, encoding="utf-8").read()
    fm, body = split_frontmatter(text)
    skeleton, units = parse_body(body)
    plan_id = fm_value(fm, "plan_id")
    title = fm_value(fm, "title")
    if not plan_id:
        raise Refusal("frontmatter has no plan_id")
    if repo is None:
        repo = repo_identity(os.path.dirname(os.path.abspath(plan_path)) or ".")

    contract = [l for l in fm if not l.startswith(ADDED_KEYS)]
    contract += [f"plan_full_hash: {plan_hash(plan_path, full=True)}", f"repo: {repo}"]
    skeleton_text = "\n".join(l for l in skeleton if l != "<<UNITS>>").rstrip()
    description = f"{skeleton_text}\n\n{CONTRACT}\n\n```yaml\n" + "\n".join(contract) + "\n```\n"

    out_units = []
    for uid, utitle, block in units:
        deps = []
        for line in block:
            m = re.match(r"^- \*\*Dependencies:\*\*\s*(.*)$", line)
            if m:
                deps = re.findall(r"U\d+", m.group(1))
                break
        out_units.append({"u_id": uid, "title": f"{utitle} ({uid})",
                          "description": "\n".join(block) + "\n", "blocked_by": deps})
    return {"plan_id": plan_id, "repo": repo,
            "parent": {"title": f"{title} ({plan_id})", "description": description},
            "units": out_units}


# --- materialize ----------------------------------------------------------

MARKER_RE = re.compile(r"^(\s*(?:>\s*)*)\* ")


def normalize_markers(text, inside_fences=False):
    out = []
    for _, line, fence in outside_fences(text.split("\n")):
        if (not fence or inside_fences) and not FENCE_RE.match(line):
            line = MARKER_RE.sub(r"\1- ", line)
        out.append(line)
    return "\n".join(out)


def is_canceled(issue):
    for key in ("status", "statusType", "state", "stateType"):
        v = issue.get(key)
        if isinstance(v, dict):
            v = v.get("type") or v.get("name")
        if isinstance(v, str) and v.lower() in ("canceled", "cancelled"):
            return True
    return False


def ident(issue):
    return issue.get("identifier") or issue.get("id") or "?"


def materialize(readback):
    parent = readback.get("parent") or {}
    desc = parent.get("description")
    if not isinstance(desc, str) or not desc.strip():
        raise Refusal(f"parent {ident(parent)} has no description")
    if TRUNCATION in desc:
        raise Refusal(f"parent {ident(parent)} description is truncated; fetch it with get_issue")

    idx = desc.rfind("\n" + CONTRACT)
    if idx < 0 and desc.startswith(CONTRACT):
        idx = -1
    elif idx < 0:
        raise Refusal(f"parent {ident(parent)} has no `{CONTRACT}` block")
    skeleton_text, contract_text = desc[:idx + 1], desc[idx + 1:]
    m = re.search(r"```ya?ml\n(.*?)\n```", contract_text, re.S)
    if not m:
        raise Refusal(f"parent {ident(parent)}'s `{CONTRACT}` has no fenced yaml block")
    fm_text = normalize_markers(m.group(1), inside_fences=True)

    live = {}
    for issue in readback.get("sub_issues") or []:
        title = issue.get("title") or ""
        sm = SUFFIX_RE.search(title)
        if not sm:
            raise Refusal(f"sub-issue {ident(issue)} title has no (U<N>) suffix: {title!r}")
        if is_canceled(issue):
            continue
        uid = sm.group(1)
        if uid in live:
            raise Refusal(f"two live sub-issues claim {uid}: {ident(live[uid])} and {ident(issue)}")
        d = issue.get("description")
        if not isinstance(d, str):
            raise Refusal(f"sub-issue {ident(issue)} ({uid}) has no description")
        if TRUNCATION in d:
            raise Refusal(f"sub-issue {ident(issue)} ({uid}) description is truncated; fetch it with get_issue")
        live[uid] = issue
    if not live:
        raise Refusal("read-back has no live sub-issues")

    blocks = []
    for uid in sorted(live, key=lambda u: int(u[1:])):
        issue = live[uid]
        utitle = SUFFIX_RE.sub("", issue["title"]).rstrip()
        body = trim(normalize_markers(issue["description"]).split("\n"))
        blocks.append(f"### {uid}. {utitle}\n\n" + "\n".join(body))

    skeleton = normalize_markers(skeleton_text.rstrip()).split("\n")
    out, placed, in_units = [], False, False
    for _, line, fence in outside_fences(skeleton):
        if not fence and line.startswith("## "):
            if in_units and not placed:
                out = trim_tail(out) + [""] + ["\n\n".join(blocks), ""]
                placed = True
            in_units = line.strip() == UNITS_HEADING
        out.append(line)
    if not placed:
        if not in_units:
            raise Refusal(f"parent description has no `{UNITS_HEADING}` section")
        out = trim_tail(out) + [""] + ["\n\n".join(blocks)]
    return "---\n" + fm_text + "\n---\n" + "\n".join(out).rstrip() + "\n"


def trim_tail(lines):
    while lines and not lines[-1].strip():
        lines = lines[:-1]
    return lines


# --- verify ---------------------------------------------------------------

def comparable(text):
    fm, body = split_frontmatter(text)
    fm = [l for l in fm if not l.startswith(ADDED_KEYS)]
    _, units = parse_body(body)
    parts = [("frontmatter", "\n".join(fm))]
    parts += [(f"## {h}", t) for h, t in sections(body)]
    parts += [(f"### {u}. {t}", "\n".join(b)) for u, t, b in units]
    return parts


def verify(plan_path, readback):
    source = open(plan_path, encoding="utf-8").read()
    rebuilt = materialize(readback)
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8") as f:
        f.write(rebuilt)
        tmp = f.name
    try:
        problems = []
        if plan_hash(plan_path) != plan_hash(tmp):
            problems.append("the default plan hash differs")
        src_full = plan_hash(plan_path, full=True)
        if src_full != plan_hash(tmp, full=True):
            problems.append("the --full plan hash differs")
        fm, _ = split_frontmatter(rebuilt)
        recorded = fm_value(fm, "plan_full_hash")
        if recorded and recorded != src_full:
            problems.append(f"plan_full_hash in the read-back ({recorded[:12]}…) is not the source's ({src_full[:12]}…)")
    finally:
        os.unlink(tmp)

    a, b = comparable(source), comparable(rebuilt)
    ah, bh = [h for h, _ in a], [h for h, _ in b]
    diff = None
    if ah != bh:
        diff = difflib.unified_diff(ah, bh, "source sections", "read-back sections", lineterm="")
        problems.append("the section or unit list differs")
    else:
        for (h, x), (_, y) in zip(a, b):
            if collapse(x) != collapse(y):
                diff = difflib.unified_diff(x.split("\n"), y.split("\n"), f"source: {h}",
                                            f"read-back: {h}", lineterm="")
                problems.append(f"`{h}` differs")
                break
    if problems:
        msg = "verify: " + "; ".join(problems)
        if diff is not None:
            msg += "\n" + "\n".join(diff)
        raise Refusal(msg)


# --- entry point ----------------------------------------------------------

def usage():
    sys.stderr.write("usage: ensemble-linear-plan render <plan> [--repo <id>]\n"
                     "       ensemble-linear-plan materialize <readback.json> [--out <path>]\n"
                     "       ensemble-linear-plan verify <plan> <readback.json>\n")
    return 2


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError) as e:
        raise Refusal(f"cannot read {path}: {e}")


def main(argv):
    if not argv:
        return usage()
    cmd, rest = argv[0], argv[1:]
    opts, pos = {}, []
    i = 0
    while i < len(rest):
        if rest[i] in ("--repo", "--out"):
            if i + 1 >= len(rest):
                return usage()
            opts[rest[i]] = rest[i + 1]
            i += 2
        elif rest[i].startswith("-"):
            return usage()
        else:
            pos.append(rest[i])
            i += 1
    try:
        if cmd == "render" and len(pos) == 1:
            print(json.dumps(render(pos[0], opts.get("--repo")), indent=2, ensure_ascii=False))
        elif cmd == "materialize" and len(pos) == 1:
            text = materialize(load_json(pos[0]))
            if "--out" in opts:
                os.makedirs(os.path.dirname(os.path.abspath(opts["--out"])), exist_ok=True)
                with open(opts["--out"], "w", encoding="utf-8") as f:
                    f.write(text)
            else:
                sys.stdout.write(text)
        elif cmd == "verify" and len(pos) == 2:
            verify(pos[0], load_json(pos[1]))
        else:
            return usage()
    except Refusal as e:
        sys.stderr.write(f"ensemble-linear-plan: {e}\n")
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
