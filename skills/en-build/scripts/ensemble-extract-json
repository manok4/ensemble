#!/usr/bin/env bash
# ensemble-extract-json — recover the JSON envelope from a reviewer response.
#
# Models wrap structured output in markdown fences and prose far more often than
# they truncate it. Every consumer in Ensemble handed the raw response straight
# to a parser and, on failure, burned a whole retry round asking for "valid JSON
# only". This recovers the common cases locally instead.
#
# Scans for the first BALANCED top-level {...} object, ignoring everything
# outside it. Fences need no special handling: ```json carries no brace, so the
# scan skips it, and the trailing fence falls after the closing brace.
#
# TRANSPORT FRAMES. `codex exec --json` does not emit one object: it emits a
# JSONL event stream whose FIRST line is {"type":"thread.started",...}. The
# first-balanced-object rule returns that line, and a parseability guard cannot
# catch it, because a transport frame is perfectly valid JSON. The payload lives
# in the `agent_message` item, so the stream is unwrapped before scanning, and a
# recovered object that is itself a transport frame is rejected outright. A
# guard that only asks "does this parse" cannot tell the right object from the
# wrong one; this one asks what the object IS.
#
# String-aware: braces inside string literals do not affect depth, and
# backslash escapes are honoured, so {"a": "}"} and {"a": "\""} both survive.
#
# Sourceable (pure function, no top-level side effects, safe under set -eu) and
# directly executable. Same convention as bin/ensemble-peer-invoke.
#
# Usage:
#   ensemble_extract_json < raw_response          # -> stdout, exit 0
#   ensemble_extract_json raw_file                # -> stdout, exit 0
# Exit 1 when no balanced object is present, or when jq is available and the
# recovered text is not valid JSON. Callers keep their existing retry as the
# fallback for genuinely broken responses.

# Known codex transport event types. An object carrying one of these as its
# top-level "type" is a stream frame, never a reviewer payload.
_eej_is_transport_frame() {
  printf '%s' "$1" | awk '
    { data = data $0 }
    END {
      if (match(data, /"type"[[:space:]]*:[[:space:]]*"(thread\.started|thread\.finished|turn\.started|turn\.completed|turn\.failed|item\.started|item\.updated|item\.completed)"/)) exit 0
      exit 1
    }'
}

# Unwrap a JSONL event stream to the agent's message text. Emits nothing when
# the input is not such a stream, so the caller falls through to the plain scan.
_eej_unwrap_stream() {
  local _f="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import json,sys
last=""
for ln in open(sys.argv[1], encoding="utf-8", errors="replace"):
    ln=ln.strip()
    if not ln.startswith("{"): continue
    try: d=json.loads(ln)
    except ValueError: continue
    it=d.get("item")
    if isinstance(it,dict) and it.get("type")=="agent_message" and it.get("text"):
        last=it["text"]
sys.stdout.write(last)
' "$_f" 2>/dev/null
  elif command -v jq >/dev/null 2>&1; then
    jq -r -s 'map(select(.item?.type == "agent_message") | .item.text) | last // ""' "$_f" 2>/dev/null
  fi
}

ensemble_extract_json() {
  local _src="${1:-/dev/stdin}" _out _tmp _unwrapped

  # Materialise stdin so the stream can be inspected and then rescanned.
  if [ "$_src" = "/dev/stdin" ]; then
    _tmp=$(mktemp) || return 1
    cat > "$_tmp"
    _src="$_tmp"
  fi

  # A JSONL event stream carries its payload inside an agent_message item.
  # Scanning the raw stream would return the first transport frame instead.
  _unwrapped=$(_eej_unwrap_stream "$_src")
  if [ -n "$_unwrapped" ]; then
    _tmp="${_tmp:-$(mktemp)}"
    printf '%s' "$_unwrapped" > "$_tmp"
    _src="$_tmp"
  fi

  _out=$(awk '
    { data = data $0 "\n" }
    END {
      n = length(data); depth = 0; instr = 0; esc = 0; start = 0
      for (i = 1; i <= n; i++) {
        c = substr(data, i, 1)
        if (depth == 0) {
          # Outside the object: prose, fences and stray quotes are all noise.
          if (c == "{") { start = i; depth = 1 }
          continue
        }
        if (instr) {
          if (esc)            { esc = 0 }
          else if (c == "\\") { esc = 1 }
          else if (c == "\"") { instr = 0 }
          continue
        }
        if (c == "\"")      { instr = 1 }
        else if (c == "{")  { depth++ }
        else if (c == "}")  {
          depth--
          if (depth == 0) { printf "%s", substr(data, start, i - start + 1); exit 0 }
        }
      }
      exit 1
    }
  ' "$_src") || return 1

  [ -n "$_out" ] || { [ -n "${_tmp:-}" ] && rm -f "$_tmp"; return 1; }
  [ -n "${_tmp:-}" ] && rm -f "$_tmp"

  # A transport frame is valid JSON, so parseability cannot reject it. Ask what
  # the object is, not merely whether it parses.
  if _eej_is_transport_frame "$_out"; then
    return 1
  fi

  # When jq is present, only hand back text that actually parses. Balanced but
  # invalid (a trailing comma, say) should fall through to the caller's retry
  # rather than be reported as a successful recovery.
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$_out" | jq -e . >/dev/null 2>&1 || return 1
  fi

  printf '%s' "$_out"
}

# Direct execution: behave as a filter. Sourcing must not run it.
#
# The bash test (BASH_SOURCE[0] == $0) cannot be reused under zsh, where $0 is
# the sourced file in BOTH cases and the naive fallback would run the filter on
# every source. zsh instead appends ":file" to ZSH_EVAL_CONTEXT when sourcing,
# so each shell is asked the question it can actually answer.
if [ -n "${ZSH_EVAL_CONTEXT:-}" ]; then
  case "$ZSH_EVAL_CONTEXT" in
    *:file*) : ;;
    *) ensemble_extract_json "$@" ;;
  esac
elif [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  ensemble_extract_json "$@"
fi
