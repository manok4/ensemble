#!/usr/bin/env bash
# ensemble-secret-scan — look for credentials in the lines a push would ADD.
#
# The skill listed the patterns in a reference and left the scanning to prose, so
# every run hand-rolled a few greps. Hand-rolled greps drift: `grep -E` has no
# portable case-insensitive inline flag, so the (?i) patterns in the reference
# were silently case-sensitive, and the run that prompted this needed a temp file
# to get the pattern list past a git hook. A scan nobody can reproduce is not a
# guard, it is a habit.
#
# IT NEVER PRINTS THE SECRET.  Output carries the pattern name, the path, the
# line number and a masked preview (first four characters, rest starred). A
# scanner whose output is itself a leak has moved the secret from the diff into
# the terminal, the PR body and the transcript.
#
# ADDED LINES ONLY.  A credential already committed is a different problem, and
# one this run cannot fix by refusing to push. Scanning the whole file would
# block every push to a repo with one historical mistake in it, which trains
# people to pass --allow-secrets by reflex.
#
# Three tiers, from references/secret-patterns.md, which stays the source of
# truth for the list:
#   high      a credential shape with almost no false positives -> BLOCK
#   filename  a path that should never be committed at all      -> BLOCK
#   heuristic a shape that is often something else              -> WARN
#
# Usage:
#   ensemble-secret-scan [--staged | --working | --range <a>..<b>]
#                        [--allow-secrets] [--json]
#
# Exit codes:
#   0  no blocking match (warnings may still be reported)
#   1  a high-confidence pattern or a red-flag filename matched
#   2  usage error
#
# --allow-secrets downgrades blocking matches to warnings and exits 0. It exists
# for cryptographic test vectors and documentation that shows a key's shape. The
# per-line escape hatch is the pragma, which is narrower and reviewable:
#   AWS_KEY = "AKIAIOSFODNN7EXAMPLE"  # pragma: ensemble-allow-secret

set -u

MODE="staged"; RANGE=""; ALLOW=0; AS_JSON=0
die() { printf '%s\n' "$*" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --staged)        MODE="staged";  shift ;;
    --working)       MODE="working"; shift ;;
    --range)         [ $# -ge 2 ] || die "--range needs <a>..<b>"; MODE="range"; RANGE="$2"; shift 2 ;;
    --allow-secrets) ALLOW=1; shift ;;
    --json)          AS_JSON=1; shift ;;
    *) die "ensemble-secret-scan: unknown argument $1" ;;
  esac
done

git rev-parse --git-dir >/dev/null 2>&1 || die "ensemble-secret-scan: not a git repository"

# The diff goes through a file, not stdin: the scanner is a python heredoc, so
# stdin is already the program. It also keeps a large diff off the argument list.
DIFF_FILE=$(mktemp) || die "ensemble-secret-scan: cannot create a temp file"
trap 'rm -f "$DIFF_FILE"' EXIT
case "$MODE" in
  staged)  git diff --cached > "$DIFF_FILE" ;;
  working) { git diff; git diff --cached; } > "$DIFF_FILE" ;;
  range)   git diff "$RANGE" > "$DIFF_FILE" || die "ensemble-secret-scan: bad range '$RANGE'" ;;
esac

ALLOW="$ALLOW" AS_JSON="$AS_JSON" DIFF_FILE="$DIFF_FILE" python3 - <<'PY'
import json, os, re, sys

allow  = os.environ["ALLOW"] == "1"
as_json = os.environ["AS_JSON"] == "1"
with open(os.environ["DIFF_FILE"]) as fh:
    diff = fh.read()

PRAGMA = "pragma: ensemble-allow-secret"

# Kept in the same order as references/secret-patterns.md so a reader can diff
# the two by eye, and tests/lint/ensemble-secret-scan.test.sh fails when the
# reference names a pattern this file does not implement.
HIGH = [
    ("aws-access-key-id",     r"AKIA[0-9A-Z]{16}"),
    ("aws-secret-access-key", r"(?i)aws_secret_access_key\s*=\s*[\"']?[A-Za-z0-9/+=]{40}"),
    ("github-pat",            r"ghp_[A-Za-z0-9_]{36,}"),
    ("github-oauth",          r"gho_[A-Za-z0-9_]{36,}"),
    ("github-user-token",     r"ghu_[A-Za-z0-9_]{36,}"),
    ("github-server-token",   r"ghs_[A-Za-z0-9_]{36,}"),
    ("slack-token",           r"xox[bpoa]-[0-9]+-[0-9]+-[0-9]+-[a-z0-9]{32}"),
    ("anthropic-api-key",     r"sk-ant-[A-Za-z0-9_-]{40,}"),
    ("openai-style-api-key",  r"sk-[A-Za-z0-9]{20,}"),
    ("private-key-block",     r"-----BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY-----"),
    ("bearer-token",          r"(?i)bearer\s+[A-Za-z0-9_\-\.=]{40,}"),
]
FILENAME = [
    ("dotenv-file",         r"(^|/)\.env(\.|$)"),
    ("ssh-private-key",     r"(^|/)id_(rsa|ed25519)$"),
    ("cert-or-key-file",    r"\.(pem|key)$"),
    ("secrets-config",      r"(^|/)secrets?\.(json|ya?ml|toml)$"),
    ("gcp-service-account", r"service-account.*\.json$"),
    ("credentials-dump",    r"(^|/)credentials\.(json|ya?ml)$"),
]
HEURISTIC = [
    ("hardcoded-password", r"(?i)password\s*=\s*[\"'][^\"']{6,}[\"']"),
    ("api-key-assignment", r"(?i)api[_-]?key\s*=\s*[\"'][^\"']{16,}[\"']"),
    ("secret-assignment",  r"(?i)secret\s*=\s*[\"'][^\"']{16,}[\"']"),
    ("long-hex-string",    r"\b[A-Fa-f0-9]{40,64}\b"),
]

def mask(text):
    """Never emit the credential. Four characters is enough to recognise the
    shape and not enough to use."""
    t = text.strip()
    if len(t) <= 4:
        return "*" * len(t)
    return t[:4] + "*" * min(len(t) - 4, 28)

findings, warnings = [], []
suppressed = 0
path = None
new_line = 0

for raw in diff.splitlines():
    if raw.startswith("+++ b/"):
        path = raw[6:]
        for name, pat in FILENAME:
            if re.search(pat, path):
                findings.append({"tier": "filename", "pattern": name,
                                 "path": path, "line": 0, "preview": ""})
        continue
    if raw.startswith("--- ") or raw.startswith("+++ "):
        continue
    if raw.startswith("@@"):
        m = re.search(r"\+(\d+)", raw)
        new_line = int(m.group(1)) if m else 0
        continue
    if raw.startswith("-"):
        continue
    if not raw.startswith("+"):
        new_line += 1
        continue

    line = raw[1:]
    lineno = new_line
    new_line += 1
    if PRAGMA in line:
        suppressed += 1
        continue
    for name, pat in HIGH:
        m = re.search(pat, line)
        if m:
            findings.append({"tier": "high", "pattern": name, "path": path or "?",
                             "line": lineno, "preview": mask(m.group(0))})
            break
    else:
        for name, pat in HEURISTIC:
            m = re.search(pat, line)
            if m:
                warnings.append({"tier": "heuristic", "pattern": name, "path": path or "?",
                                 "line": lineno, "preview": mask(m.group(0))})
                break

blocking = findings and not allow
if allow:
    warnings = findings + warnings
    findings = []

result = {
    "blocking": bool(blocking),
    "findings": findings,
    "warnings": warnings,
    "suppressed_by_pragma": suppressed,
    "allow_secrets": allow,
}

if as_json:
    print(json.dumps(result, indent=2, sort_keys=True))
else:
    def render(label, f):
        # A filename finding is about the whole path, so it carries no line.
        where = f["path"] if f["tier"] == "filename" else "{path}:{line}".format(**f)
        print("{}  {}  {}  {}".format(label, f["pattern"], where, f["preview"]).rstrip())
    for f in findings:
        render("BLOCK ", f)
    for w in warnings:
        render("WARN  ", w)
    if suppressed:
        print("note: {} line(s) suppressed by '{}'".format(suppressed, PRAGMA))
    if not findings and not warnings:
        print("secret-scan: clean")

sys.exit(1 if blocking else 0)
PY
