#!/usr/bin/env bash
# ensemble-sweep-activity-check — decide whether scheduled /en-sweep should
# run this cycle, based on whether any non-sweep commits have landed on the
# default branch since the last sweep-authored commit.
#
# Output: prints "should-run=true" or "should-run=false" plus a one-line
# reason on stdout in GITHUB_OUTPUT format. Always exits 0.
#
# Usage:
#   ensemble-sweep-activity-check [--branch <ref>] [--manual]
#
# Flags:
#   --branch <ref>  Branch to check (default: origin/main)
#   --manual        Force should-run=true (manual workflow_dispatch override)
#
# Example (in GitHub Actions):
#   - id: gate
#     run: |
#       bin/ensemble-sweep-activity-check \
#         ${{ github.event_name == 'workflow_dispatch' && '--manual' || '' }} \
#         >> "$GITHUB_OUTPUT"

set -eu

BRANCH="origin/main"
MANUAL="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --manual) MANUAL="true"; shift ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "Unknown flag: $1" >&2; exit 1 ;;
  esac
done

if [ "$MANUAL" = "true" ]; then
  echo "should-run=true"
  echo "reason=manual trigger (workflow_dispatch)"
  exit 0
fi

# Sweep's commit-message patterns. These are the same patterns Guard 1 in the
# old event-driven workflow used to identify sweep-authored commits.
SWEEP_PATTERN='^chore\((sweep|arch|plans|learnings|maps|docs)\):'

if ! command -v git >/dev/null 2>&1; then
  echo "should-run=true"
  echo "reason=git not available; defaulting to run"
  exit 0
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "should-run=true"
  echo "reason=not a git repo; defaulting to run"
  exit 0
fi

# Find the most recent sweep-authored commit on the target branch.
LAST_SWEEP_SHA=$(git log -E --grep="$SWEEP_PATTERN" --pretty=format:'%H' -1 "$BRANCH" 2>/dev/null || echo "")

if [ -z "$LAST_SWEEP_SHA" ]; then
  echo "should-run=true"
  echo "reason=no prior sweep-authored commit on $BRANCH (first run after install)"
  exit 0
fi

# Count non-sweep commits since LAST_SWEEP_SHA on the target branch.
NEW_COMMITS=$(git log -E "$LAST_SWEEP_SHA..$BRANCH" --invert-grep --grep="$SWEEP_PATTERN" --pretty=format:'%H' 2>/dev/null | grep -c . || echo 0)

if [ "$NEW_COMMITS" -eq 0 ]; then
  SHORT_SHA=$(echo "$LAST_SWEEP_SHA" | cut -c1-7)
  echo "should-run=false"
  echo "reason=no non-sweep commits on $BRANCH since last sweep ($SHORT_SHA)"
else
  echo "should-run=true"
  echo "reason=$NEW_COMMITS new commit(s) on $BRANCH since last sweep"
fi
