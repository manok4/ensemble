#!/usr/bin/env bash
# ensemble-peer-flags — translate a resolved effort tier into per-CLI flags (EN11).
#
# PURE TRANSLATOR. This script reads NO config and consults NO ladder: it takes
# an ALREADY-RESOLVED tier and alias and maps them onto the detected peer's
# syntax. All precedence lives in /en-review (references/peer-model-policy.md
# section (b)), so there is exactly one place precedence can be wrong, and it is
# testable there.
#
# Usage:
#   ensemble-peer-flags --effort <low|medium|high>
#                       [--peer-cmd <cmd>] [--model-alias <alias>]
#
# Emits two shell-escaped, eval-able lines using the same contract as
# bin/ensemble-detect-host:
#
#   claude peer:  PEER_MODEL='--model sonnet'
#                 PEER_EFFORT='--effort medium'
#
#   codex peer:   PEER_MODEL=''
#                 PEER_EFFORT='-c model_reasoning_effort="medium"'
#
# Codex gets NO -m on purpose: `codex exec -m` takes a concrete model ID, and
# concrete IDs go stale every vendor release, so the peer inherits the
# operator's ~/.codex/config.toml model and Ensemble overrides only the
# reasoning effort. No concrete model ID may ever live in Ensemble.

set -u

EFFORT=""
PEER_CMD_IN=""
MODEL_ALIAS=""

# The default Claude tier alias. An ALIAS (not a dated model ID) so it
# auto-resolves to the latest model of that tier and never goes stale.
DEFAULT_CLAUDE_ALIAS="sonnet"

usage() {
  echo "usage: ensemble-peer-flags --effort <low|medium|high> [--peer-cmd <cmd>] [--model-alias <alias>]" >&2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --effort)      [ $# -ge 2 ] || { usage; exit 2; }; EFFORT="$2"; shift 2 ;;
    --peer-cmd)    [ $# -ge 2 ] || { usage; exit 2; }; PEER_CMD_IN="$2"; shift 2 ;;
    --model-alias) [ $# -ge 2 ] || { usage; exit 2; }; MODEL_ALIAS="$2"; shift 2 ;;
    -h|--help)     usage; exit 0 ;;
    *)             usage; exit 2 ;;
  esac
done

# Validate BEFORE emitting anything, so an invalid tier never produces partial
# output that a caller might eval.
case "$EFFORT" in
  low|medium|high) ;;
  "") echo "ensemble-peer-flags: --effort is required" >&2; usage; exit 2 ;;
  *)  echo "ensemble-peer-flags: invalid effort '$EFFORT' (expected low|medium|high)" >&2; exit 2 ;;
esac

# Resolve the peer command if the caller did not supply one.
if [ -z "$PEER_CMD_IN" ]; then
  PEER_CMD_IN="${PEER_CMD:-}"
fi
if [ -z "$PEER_CMD_IN" ]; then
  _self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -x "$_self_dir/ensemble-detect-host" ]; then
    PEER_CMD_IN=$("$_self_dir/ensemble-detect-host" 2>/dev/null \
                    | sed -n "s/^PEER_CMD=//p" | sed "s/^'//; s/'$//") || PEER_CMD_IN=""
  fi
fi

# Same shell-escape contract as bin/ensemble-detect-host, so consumers can
# `eval` both emissions identically.
shellesc() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\"'\"'/g")"
}

PEER_MODEL=""
PEER_EFFORT=""

case "$PEER_CMD_IN" in
  claude*)
    alias_to_use="$MODEL_ALIAS"
    [ -n "$alias_to_use" ] || alias_to_use="$DEFAULT_CLAUDE_ALIAS"
    PEER_MODEL="--model $alias_to_use"
    PEER_EFFORT="--effort $EFFORT"
    ;;
  codex*)
    # No -m: inherit the operator's configured model, override effort only.
    PEER_MODEL=""
    PEER_EFFORT="-c model_reasoning_effort=\"$EFFORT\""
    ;;
  *)
    # Unrecognized or absent peer CLI: emit nothing and succeed, so a future
    # CLI degrades to inherit-everything rather than breaking review.
    PEER_MODEL=""
    PEER_EFFORT=""
    ;;
esac

printf 'PEER_MODEL=%s\n'  "$(shellesc "$PEER_MODEL")"
printf 'PEER_EFFORT=%s\n' "$(shellesc "$PEER_EFFORT")"
