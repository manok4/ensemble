#!/usr/bin/env bash
# en-ship-watch-ci - wrapper used by .github/workflows/en-ship-watch.yml.
#
# CI-hosted self-heal for hands-off /en-ship (EN04). The workflow fires on a
# failed CI `workflow_run` and runs THIS wrapper from a TRUSTED default-branch
# checkout (never PR-head code), so the security-sensitive gating runs trusted.
# The wrapper:
#   - binds to the EXACT failed head SHA (ignores stale/advanced PRs);
#   - rejects fork / cross-repository PRs via the GitHub API BEFORE fetching any
#     PR branch (untrusted fork code never executes here);
#   - gates on the `en-ship-watch` label, a trigger token, a CLI, and a
#     3-attempt cap counted from PR-comment markers (NOT git history);
#   - fetches the same-repo PR branch and drives /en-resolve-pr headless.
#
# /en-resolve-pr OWNS commit + push (its SKILL step 9). The watcher therefore
# does NOT commit, amend, or push — doing so would rewrite an already-pushed
# commit and fail as a non-fast-forward. The watcher only gates, drives, counts
# (via comments), and escalates.
#
# Auth: the fix agent reuses en-sweep's secrets. The push/gh token must TRIGGER
# workflows (EN_SHIP_WATCH_TOKEN, a PAT/App token) - GITHUB_TOKEN pushes do not
# retrigger Actions CI. The Ensemble plugin/skill must be resolvable in the
# runner (ENSEMBLE_PLUGIN_DIR or an installed plugin); if not, the wrapper
# escalates rather than going green-but-inert (same requirement as en-sweep).

set -euo pipefail

WATCH_LABEL="en-ship-watch"
MAX_ATTEMPTS="${EN_SHIP_WATCH_MAX_ATTEMPTS:-3}"
ATTEMPT_MARKER="<!-- en-ship-watch-attempt -->"

# ---------------------------------------------------------------------------
# Pure, testable decision guards (no side effects - safe to source in tests).
# ---------------------------------------------------------------------------

# has_watch_label <newline-separated labels> - 0 if the watch label is present.
has_watch_label() {
  printf '%s\n' "${1:-}" | grep -qx "$WATCH_LABEL"
}

# under_attempt_cap <count> <cap> - 0 while attempts remain (count < cap).
under_attempt_cap() {
  [ "${1:-0}" -lt "${2:-3}" ]
}

# is_cross_repository <isCrossRepository flag> - 0 (true) when the PR head is in
# a DIFFERENT repo (a fork). Fork PRs are refused: their code is untrusted.
is_cross_repository() {
  [ "${1:-}" = "true" ]
}

# head_matches <pr-head-oid> <failed-run-head-sha> - 0 only on an exact,
# non-empty match. Binds the run to the SHA that actually failed CI.
head_matches() {
  [ -n "${1:-}" ] && [ "${1:-}" = "${2:-}" ]
}

# assert_branch_safe <target-branch> <default-branch> - refuse (non-zero) when
# the push target is empty or is the default branch. Branch-only writes.
assert_branch_safe() {
  local target="${1:-}" default="${2:-}"
  if [ -z "$target" ] || [ "$target" = "$default" ]; then
    echo "REFUSED: en-ship-watch will not write to '$target' (default: '$default'); branch-only." >&2
    return 1
  fi
  return 0
}

# skill_resolved <cli-output> - non-zero when the CLI reports the en-resolve-pr
# skill was not registered (green-but-inert). Mirrors en-sweep-ci's guard.
skill_resolved() {
  ! printf '%s' "${1:-}" | grep -qi 'unknown command'
}

# ---------------------------------------------------------------------------
# Side-effecting helpers (thin wrappers over gh/git; skipped under tests).
# ---------------------------------------------------------------------------

# count_attempts <pr> - prior watcher attempts, counted from PR-comment markers
# (NOT git history, which /en-resolve-pr owns).
count_attempts() {
  gh pr view "$1" --json comments \
    --jq "[.comments[] | select(.body | contains(\"$ATTEMPT_MARKER\"))] | length" 2>/dev/null || echo 0
}

post_attempt_marker() {
  gh pr comment "$1" --body "${ATTEMPT_MARKER} en-ship-watch self-heal attempt ${2}/${MAX_ATTEMPTS}." >/dev/null 2>&1 || true
}

# drop_label_and_escalate <pr> <reason> - remove the label + comment. HARDENED:
# returns non-zero if the label could not actually be removed, so the caller
# fails the run visibly instead of exiting 0 while the PR stays armed.
drop_label_and_escalate() {
  local pr="$1" reason="$2" removed=0
  if gh pr edit "$pr" --remove-label "$WATCH_LABEL" >/dev/null 2>&1; then
    removed=1
  fi
  gh pr comment "$pr" --body "🛑 en-ship-watch stopped self-healing this PR: ${reason}. $( [ "$removed" = 1 ] && echo "Removed the \`${WATCH_LABEL}\` label" || echo "COULD NOT remove the \`${WATCH_LABEL}\` label - remove it manually" ) - a human decision is needed." >/dev/null 2>&1 || true
  if [ "$removed" = 1 ]; then
    echo "en-ship-watch: escalated PR #${pr} (${reason})"
    return 0
  fi
  echo "en-ship-watch: FAILED to disarm PR #${pr} (label still set) - ${reason}" >&2
  return 1
}

# drive_resolve_pr <pr> - invoke /en-resolve-pr headless. It commits + pushes.
# --plugin-dir on BOTH paths so the skill resolves. Returns 2 if the skill is
# unregistered, 1 on CLI error.
drive_resolve_pr() {
  local pr="$1" plugin_dir="${ENSEMBLE_PLUGIN_DIR:-}" out
  if command -v claude >/dev/null 2>&1; then
    set -- -p --output-format json --max-turns 50 --skill en-resolve-pr "resolve the failing CI on PR #${pr}"
    [ -n "$plugin_dir" ] && set -- --plugin-dir "$plugin_dir" "$@"
    out="$(claude "$@")" || return 1
  elif [ -n "$plugin_dir" ]; then
    out="$(codex exec --json --plugin-dir "$plugin_dir" --skill en-resolve-pr "resolve the failing CI on PR #${pr}" < /dev/null)" || return 1
  else
    out="$(codex exec --json --skill en-resolve-pr "resolve the failing CI on PR #${pr}" < /dev/null)" || return 1
  fi
  printf '%s\n' "$out"
  skill_resolved "$out" || return 2
  return 0
}

# ---------------------------------------------------------------------------
main() {
  if [ "${EN_SHIP_WATCH_ACTIVE:-0}" = "1" ]; then
    echo "en-ship-watch: already active (recursion guard); exiting."; exit 0
  fi
  export EN_SHIP_WATCH_ACTIVE=1

  local head_sha="${EN_SHIP_WATCH_HEAD_SHA:-${GITHUB_SHA:-}}"
  local default_branch="${EN_SHIP_WATCH_DEFAULT_BRANCH:-$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null || echo main)}"

  # Resolve the open PR whose head is this failing CI run (metadata only).
  local pr labels cross branch oid
  pr="$(gh pr list --state open --search "$head_sha" --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -z "$pr" ]; then
    echo "en-ship-watch: no open PR for ${head_sha}; nothing to do."; exit 0
  fi

  # Gate 0 (BINDING) - the resolved PR's current head must be EXACTLY the SHA
  # that failed. If the PR advanced since the failed run, this run is stale; a
  # newer workflow_run will handle the current head. Prevents acting on / pushing
  # against a head other than the one that actually failed.
  oid="$(gh pr view "$pr" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
  if ! head_matches "$oid" "$head_sha"; then
    echo "en-ship-watch: PR #${pr} head advanced past the failed run (${head_sha}); a newer run handles it."; exit 0
  fi

  labels="$(gh pr view "$pr" --json labels --jq '.labels[].name' 2>/dev/null || true)"

  # Gate 1 - only act on labeled PRs.
  if ! has_watch_label "$labels"; then
    echo "en-ship-watch: PR #${pr} is not labeled '${WATCH_LABEL}'; no-op."; exit 0
  fi

  # Gate 2 (SECURITY) - refuse fork / cross-repository PRs BEFORE any PR fetch.
  cross="$(gh pr view "$pr" --json isCrossRepository --jq '.isCrossRepository' 2>/dev/null || echo true)"
  if is_cross_repository "$cross"; then
    drop_label_and_escalate "$pr" "PR is from a fork / different repository; self-heal only supports same-repo branches" || exit 1
    exit 0
  fi

  # Gate 3 - a fix push needs a token that retriggers CI; GITHUB_TOKEN doesn't.
  if [ "${EN_SHIP_WATCH_HAS_TRIGGER_TOKEN:-false}" != "true" ]; then
    drop_label_and_escalate "$pr" "no EN_SHIP_WATCH_TOKEN configured - a fix push with GITHUB_TOKEN will not retrigger CI" || exit 1
    exit 0
  fi

  # Gate 4 - a fix needs a coding-agent CLI in the runner.
  if ! command -v claude >/dev/null 2>&1 && ! command -v codex >/dev/null 2>&1; then
    drop_label_and_escalate "$pr" "no claude or codex CLI available in the runner" || exit 1
    exit 0
  fi

  branch="$(gh pr view "$pr" --json headRefName --jq '.headRefName' 2>/dev/null || true)"

  # Gate 5 - never write to the default branch.
  if ! assert_branch_safe "$branch" "$default_branch"; then
    drop_label_and_escalate "$pr" "refused to write to a protected branch" || exit 1
    exit 0
  fi

  # Gate 6 - bound fix attempts (counted from PR-comment markers).
  local attempts; attempts="$(count_attempts "$pr")"
  if ! under_attempt_cap "$attempts" "$MAX_ATTEMPTS"; then
    drop_label_and_escalate "$pr" "reached the ${MAX_ATTEMPTS}-attempt fix cap" || exit 1
    exit 0
  fi

  # Same-repo + bound confirmed: fetch + check out the exact failed head. Verify
  # the checked-out tip is still the failed SHA before running the fix agent.
  if ! git fetch origin "$branch" || ! git checkout -B "$branch" "$head_sha"; then
    drop_label_and_escalate "$pr" "could not fetch/checkout the PR branch '${branch}' at ${head_sha}" || exit 1
    exit 0
  fi

  # Record this attempt (PR-visible) BEFORE driving the fix, so the cap advances
  # even if the fix later fails.
  post_attempt_marker "$pr" "$(( attempts + 1 ))"

  # Drive the fix. /en-resolve-pr commits + pushes itself; the watcher does NOT
  # commit, amend, or push (that would rewrite the pushed commit).
  local before after rc=0
  before="$(git rev-parse HEAD)"
  drive_resolve_pr "$pr" || rc=$?
  if [ "$rc" = "2" ]; then
    drop_label_and_escalate "$pr" "the en-resolve-pr skill is not available in the runner - install/register the Ensemble plugin (ENSEMBLE_PLUGIN_DIR)" || exit 1
    exit 0
  fi
  if [ "$rc" != "0" ]; then
    drop_label_and_escalate "$pr" "the fix agent could not resolve the failure" || exit 1
    exit 0
  fi
  after="$(git rev-parse HEAD)"
  if [ "$before" = "$after" ]; then
    drop_label_and_escalate "$pr" "no fix was produced (judgment call)" || exit 1
    exit 0
  fi

  echo "en-ship-watch: /en-resolve-pr pushed fix attempt $(( attempts + 1 )) to ${branch} (PR #${pr}); CI will re-run."
}

# Only run when executed, not when sourced by tests.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  main "$@"
fi
