#!/usr/bin/env bash
# ensemble-verify-peer-evidence — check a commit (or HEAD) for peer-review evidence.
#
# Mechanical gate that /en-build calls before/after each unit commit. The gate
# does NOT trust the agent's procedural memory of "did I run the peer review";
# it inspects git trailers directly. This catches the failure mode where an
# agent skipped peer review and wrote "Peer review approved" as plain text.
#
# Usage:
#   ensemble-verify-peer-evidence [<commit-ref>] [--require-peer-resolution] [--json]
#
# Default <commit-ref>: HEAD.
#
# Flags:
#   --require-peer-resolution   Fail unless at least one `peer-resolution:` trailer
#                               is present. Used for destructive (P4) and
#                               `gated: true` units where peer review is
#                               mandatory and cannot be replaced by `peer-skipped:`.
#   --json                      Emit JSON to stdout for skill consumption:
#                                 {"commit","u_id","peer_resolutions","peer_skipped",
#                                  "skipped_reasons","verdict","detail"}
#                               Without --json, emit human-readable lines.
#
# Exit codes:
#   0  Evidence present (or skipped with valid reason, when --require-peer-resolution
#      is NOT set).
#   1  Missing required evidence — caller should refuse to advance.
#   2  Invalid input (commit doesn't resolve, malformed trailer, etc.).
#
# Trailer schema (consumed by this helper):
#
#   peer-verdict: <single-line JSON>
#       Per-peer-pass overall verdict. Emitted EXACTLY ONCE when the peer
#       actually ran on this unit (whether it found 0 or N findings). This
#       is the primary "the peer reviewed this unit" signal. Required keys:
#         verdict       — "approve" | "revise" | "reject"
#         peer_mode     — "cross-agent" | "single-agent-fallback"
#         iteration     — integer >= 1 (which iteration of the per-unit loop)
#         findings_count — integer >= 0 (must match the count of
#                          peer-resolution: trailers in this commit)
#         summary       — optional 2-3 sentence summary
#
#   peer-resolution: <single-line JSON>
#       Per-finding record (one trailer per finding). Required keys:
#       finding_id, u_id, iteration, severity, status, title. See
#       references/build-handoff.md for the full schema.
#
#   peer-skipped: <reason>
#       Recorded when peer review was deliberately not invoked for this unit.
#       Reason MUST be one of the documented enum values:
#         PEER_AVAILABLE=false
#         --no-peer-per-unit-flag
#         peer-subprocess-failed:<one-line-detail>
#         cap-exhausted-with-applied-findings
#         recursion-guard-active
#         auto-skip:diff-below-threshold
#         auto-skip:lightweight-depth
#
#   peer-skipped is NOT a synonym for "I forgot to run the peer call". Agents
#   that skip peer review without a recorded reason fail this gate.
#
#   review-verdict: <single-line JSON>
#       BRANCH-LEVEL review evidence (the lfg-style model). Emitted once on the
#       post-build review/fix commit when /en-build reviews the whole branch
#       diff in one pass instead of per-unit. Required keys:
#         verdict        — "approve" | "revise" | "reject"
#         reviewer       — e.g. "en-review" | "cross-agent" | "single-agent-fallback"
#         mode           — review mode (e.g. "headless")
#         units_covered  — JSON array of U-IDs this review pass covered (e.g. ["U1","U2"])
#         findings_count — integer >= 0
#       A unit is "covered" when its U-ID appears in some review-verdict's
#       units_covered array on the branch. Use --branch-coverage to enumerate.
#
# Evidence rules:
#   - "ok" requires at least one of: peer-verdict, peer-resolution, peer-skipped,
#     review-verdict.
#   - peer-verdict is the strongest per-unit evidence (always emitted when the
#     per-unit peer ran). review-verdict is the branch-level equivalent.
#   - peer-resolution is indirect evidence (per-finding; peer must have run to
#     have produced findings).
#   - --require-peer-resolution: the unit ran an ACTUAL peer pass, regardless of
#     finding count. Accepts peer-verdict OR peer-resolution; rejects peer-skipped
#     AND review-verdict (a branch-level pass is not a substitute for a dedicated
#     per-unit peer review on destructive / gated:true units).
#   - If both peer-verdict and peer-resolution are present, peer-verdict's
#     findings_count MUST match the peer-resolution count.
#
# Branch-coverage mode:
#   ensemble-verify-peer-evidence --branch-coverage <range> [--json]
#       Scan a commit range (e.g. main..HEAD) for review-verdict trailers and
#       emit the set of U-IDs covered by branch-level review. Used by the
#       end-of-build audit and en-ship's plan-completion checkpoint to confirm
#       every plan unit is covered by either per-unit evidence or a branch-level
#       review pass.

set -u

# Validate a review-verdict JSON payload by VALUE and TYPE, not just key
# presence. Echoes an error string (and returns 1) when invalid; silent + 0
# when valid. Shared by the single-commit path and --branch-coverage so a
# malformed branch-level trailer can never be counted as coverage.
validate_review_verdict() {
  vjson="$1"
  if ! printf '%s' "$vjson" | jq empty 2>/dev/null; then
    echo "malformed review-verdict JSON: $(printf '%s' "$vjson" | head -c 80)"; return 1
  fi
  v=$(printf '%s' "$vjson" | jq -r '.verdict // empty' 2>/dev/null || true)
  case "$v" in approve|revise|reject) ;; *) echo "review-verdict.verdict must be approve|revise|reject, got: ${v:-<missing>}"; return 1 ;; esac
  if ! printf '%s' "$vjson" | jq -e '(.reviewer | type == "string" and (length > 0))' >/dev/null 2>&1; then
    echo "review-verdict.reviewer must be a non-empty string"; return 1
  fi
  if ! printf '%s' "$vjson" | jq -e '(.mode | type == "string" and (length > 0))' >/dev/null 2>&1; then
    echo "review-verdict.mode must be a non-empty string"; return 1
  fi
  if ! printf '%s' "$vjson" | jq -e '(.units_covered | type == "array")' >/dev/null 2>&1; then
    echo "review-verdict.units_covered must be an array"; return 1
  fi
  if ! printf '%s' "$vjson" | jq -e '(.units_covered | all(type == "string"))' >/dev/null 2>&1; then
    echo "review-verdict.units_covered must be an array of strings"; return 1
  fi
  if ! printf '%s' "$vjson" | jq -e '(.findings_count | type == "number" and . >= 0 and (floor == .))' >/dev/null 2>&1; then
    echo "review-verdict.findings_count must be a non-negative integer"; return 1
  fi
  return 0
}

REF="HEAD"
REQUIRE_RESOLUTION="false"
EMIT_JSON="false"
BRANCH_COVERAGE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --require-peer-resolution) REQUIRE_RESOLUTION="true"; shift ;;
    --json) EMIT_JSON="true"; shift ;;
    --branch-coverage) BRANCH_COVERAGE="$2"; shift 2 ;;
    -h|--help)
      sed -n '/^# Usage:/,/^$/p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    --*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) REF="$1"; shift ;;
  esac
done

# --- Branch-coverage mode: enumerate U-IDs covered by branch-level review ---
if [ -n "$BRANCH_COVERAGE" ]; then
  if ! git rev-parse --verify "${BRANCH_COVERAGE%%..*}" >/dev/null 2>&1; then
    echo "ensemble-verify-peer-evidence: cannot resolve range '$BRANCH_COVERAGE'" >&2
    exit 2
  fi
  covered="[]"
  verdict_commits="[]"
  invalid_commits="[]"
  while IFS= read -r sha; do
    [ -z "$sha" ] && continue
    cmsg=$(git log -1 --format=%B "$sha")
    rv=$(printf '%s\n' "$cmsg" | git interpret-trailers --parse | grep '^review-verdict:' | head -n1)
    [ -z "$rv" ] && continue
    rvjson="${rv#review-verdict: }"
    # Fail closed: a malformed review-verdict trailer is NOT counted as coverage
    # (parity with the single-commit `malformed` verdict).
    if [ -n "$(validate_review_verdict "$rvjson" || true)" ]; then
      invalid_commits=$(jq -cn --argjson a "$invalid_commits" --arg s "$sha" '$a + [$s]')
      continue
    fi
    units=$(printf '%s' "$rvjson" | jq -c '.units_covered // []')
    covered=$(jq -cn --argjson a "$covered" --argjson b "$units" '($a + $b) | unique')
    verdict_commits=$(jq -cn --argjson a "$verdict_commits" --arg s "$sha" '$a + [$s]')
  done < <(git rev-list "$BRANCH_COVERAGE" 2>/dev/null)

  if [ "$EMIT_JSON" = "true" ]; then
    jq -n --argjson covered "$covered" --argjson commits "$verdict_commits" --argjson invalid "$invalid_commits" \
      '{covered_units: $covered, review_verdict_commits: $commits, invalid_review_verdict_commits: $invalid}'
  else
    printf 'covered_units: %s\n' "$(printf '%s' "$covered" | jq -r 'join(", ")')"
    printf 'review-verdict commits: %s\n' "$(printf '%s' "$verdict_commits" | jq -r 'length')"
    printf 'invalid review-verdict commits: %s\n' "$(printf '%s' "$invalid_commits" | jq -r 'length')"
  fi
  # Fail closed if any malformed branch-level trailer was found.
  [ "$(printf '%s' "$invalid_commits" | jq -r 'length')" != "0" ] && exit 1
  exit 0
fi

# Resolve commit
if ! commit=$(git rev-parse --verify "$REF" 2>/dev/null); then
  echo "ensemble-verify-peer-evidence: cannot resolve ref '$REF'" >&2
  exit 2
fi

# Pull commit message and parse trailers
msg=$(git log -1 --format=%B "$commit")
trailers=$(printf '%s\n' "$msg" | git interpret-trailers --parse)

# Count trailers
verdict_lines=$(printf '%s\n' "$trailers" | grep '^peer-verdict:' || true)
verdict_count=$(printf '%s\n' "$verdict_lines" | grep -c '^peer-verdict:' || true)
[ -z "$verdict_lines" ] && verdict_count=0

res_count=$(printf '%s\n' "$trailers" | grep -c '^peer-resolution:' || true)

skip_lines=$(printf '%s\n' "$trailers" | grep '^peer-skipped:' || true)
skip_count=$(printf '%s\n' "$skip_lines" | grep -c '^peer-skipped:' || true)
[ -z "$skip_lines" ] && skip_count=0

rv_lines=$(printf '%s\n' "$trailers" | grep '^review-verdict:' || true)
rv_count=$(printf '%s\n' "$rv_lines" | grep -c '^review-verdict:' || true)
[ -z "$rv_lines" ] && rv_count=0

# Extract U-ID from the first peer-resolution trailer (parse via jq for safety)
u_id=""
first_res=$(printf '%s\n' "$trailers" | grep '^peer-resolution:' | head -n 1)
if [ -n "$first_res" ]; then
  json="${first_res#peer-resolution: }"
  u_id=$(printf '%s' "$json" | jq -r '.u_id // empty' 2>/dev/null || true)
fi

# Validate peer-verdict trailers parse as JSON with required fields
verdict_invalid=0
verdict_invalid_detail=""
verdict_findings_count=""
peer_verdict_value=""
if [ "$verdict_count" -gt 0 ]; then
  if [ "$verdict_count" -gt 1 ]; then
    verdict_invalid=$((verdict_invalid + 1))
    verdict_invalid_detail="multiple peer-verdict trailers ($verdict_count); expected exactly one per peer pass"
  else
    json="${verdict_lines#peer-verdict: }"
    if ! printf '%s' "$json" | jq empty 2>/dev/null; then
      verdict_invalid=$((verdict_invalid + 1))
      verdict_invalid_detail="malformed peer-verdict JSON: $(printf '%s' "$json" | head -c 80)"
    else
      for f in verdict peer_mode iteration findings_count; do
        if ! printf '%s' "$json" | jq -e "has(\"$f\")" >/dev/null 2>&1; then
          verdict_invalid=$((verdict_invalid + 1))
          verdict_invalid_detail="peer-verdict missing field '$f'"
          break
        fi
      done
      if [ "$verdict_invalid" = "0" ]; then
        peer_verdict_value=$(printf '%s' "$json" | jq -r '.verdict')
        case "$peer_verdict_value" in
          approve|revise|reject) ;;
          *) verdict_invalid=$((verdict_invalid + 1))
             verdict_invalid_detail="peer-verdict.verdict must be approve|revise|reject, got: $peer_verdict_value" ;;
        esac
        verdict_findings_count=$(printf '%s' "$json" | jq -r '.findings_count')
      fi
    fi
  fi
fi

# Validate peer-resolution trailers parse as JSON with required fields
res_invalid=0
res_invalid_detail=""
if [ "$res_count" -gt 0 ]; then
  while IFS= read -r line; do
    json="${line#peer-resolution: }"
    if ! printf '%s' "$json" | jq empty 2>/dev/null; then
      res_invalid=$((res_invalid + 1))
      res_invalid_detail="malformed JSON: $(printf '%s' "$json" | head -c 80)"
      continue
    fi
    for f in finding_id u_id iteration severity status title; do
      if ! printf '%s' "$json" | jq -e "has(\"$f\")" >/dev/null 2>&1; then
        res_invalid=$((res_invalid + 1))
        res_invalid_detail="missing field $f in: $(printf '%s' "$json" | head -c 80)"
        break
      fi
    done
  done < <(printf '%s\n' "$trailers" | grep '^peer-resolution:')
fi

# Validate review-verdict trailers (branch-level evidence)
rv_invalid=0
rv_invalid_detail=""
if [ "$rv_count" -gt 0 ]; then
  if [ "$rv_count" -gt 1 ]; then
    rv_invalid=$((rv_invalid + 1))
    rv_invalid_detail="multiple review-verdict trailers ($rv_count); expected at most one per commit"
  else
    json="${rv_lines#review-verdict: }"
    rv_err=$(validate_review_verdict "$json" || true)
    if [ -n "$rv_err" ]; then
      rv_invalid=$((rv_invalid + 1))
      rv_invalid_detail="$rv_err"
    fi
  fi
fi

# Validate peer-skipped reasons
skip_invalid=0
skip_reasons=""
if [ "$skip_count" -gt 0 ]; then
  while IFS= read -r line; do
    reason="${line#peer-skipped: }"
    case "$reason" in
      PEER_AVAILABLE=false) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      --no-peer-per-unit-flag) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      peer-subprocess-failed:*) skip_reasons="${skip_reasons}${skip_reasons:+,}peer-subprocess-failed" ;;
      cap-exhausted-with-applied-findings) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      recursion-guard-active) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      auto-skip:diff-below-threshold) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      auto-skip:lightweight-depth) skip_reasons="${skip_reasons}${skip_reasons:+,}$reason" ;;
      *) skip_invalid=$((skip_invalid + 1)); skip_reasons="${skip_reasons}${skip_reasons:+,}INVALID($reason)" ;;
    esac
  done < <(printf '%s\n' "$skip_lines")
fi

# Cross-check peer-verdict.findings_count against peer-resolution count.
mismatch=0
mismatch_detail=""
if [ "$verdict_count" -ge 1 ] && [ -n "$verdict_findings_count" ]; then
  if [ "$verdict_findings_count" != "$res_count" ]; then
    mismatch=1
    mismatch_detail="peer-verdict.findings_count=$verdict_findings_count but commit has $res_count peer-resolution trailer(s)"
  fi
fi

# Apply gate
verdict="ok"
detail=""

if [ "$verdict_invalid" -gt 0 ]; then
  verdict="malformed"
  detail="$verdict_invalid_detail"
elif [ "$res_invalid" -gt 0 ]; then
  verdict="malformed"
  detail="$res_invalid_detail"
elif [ "$rv_invalid" -gt 0 ]; then
  verdict="malformed"
  detail="$rv_invalid_detail"
elif [ "$skip_invalid" -gt 0 ]; then
  verdict="malformed"
  detail="invalid peer-skipped reason — must be one of the documented enum values"
elif [ "$mismatch" -gt 0 ]; then
  verdict="malformed"
  detail="$mismatch_detail"
elif [ "$REQUIRE_RESOLUTION" = "true" ]; then
  # peer ran an actual pass on this unit (peer-verdict OR peer-resolution);
  # peer-skipped AND review-verdict are NOT enough for destructive / gated units
  if [ "$verdict_count" -lt 1 ] && [ "$res_count" -lt 1 ]; then
    verdict="missing-resolution"
    detail="--require-peer-resolution set but commit has no peer-verdict and no peer-resolution; destructive / gated units MUST have a dedicated peer review (peer-skipped and branch-level review-verdict are not sufficient)"
  fi
else
  # Any of the four is sufficient
  if [ "$verdict_count" -lt 1 ] && [ "$res_count" -lt 1 ] && [ "$skip_count" -lt 1 ] && [ "$rv_count" -lt 1 ]; then
    verdict="missing-evidence"
    detail="commit has none of peer-verdict / peer-resolution / peer-skipped / review-verdict trailers; en-build refuses to advance without evidence"
  fi
fi

# Emit
if [ "$EMIT_JSON" = "true" ]; then
  jq -n \
    --arg commit "$commit" \
    --arg u_id "${u_id:-}" \
    --arg peer_verdict "${peer_verdict_value:-}" \
    --argjson verdict_count "$verdict_count" \
    --argjson res_count "$res_count" \
    --argjson skip_count "$skip_count" \
    --argjson rv_count "$rv_count" \
    --arg skip_reasons "$skip_reasons" \
    --arg verdict "$verdict" \
    --arg detail "$detail" \
    '{commit: $commit, u_id: ($u_id | select(length>0) // null), peer_verdict: ($peer_verdict | select(length>0) // null), peer_verdicts: $verdict_count, peer_resolutions: $res_count, peer_skipped: $skip_count, review_verdicts: $rv_count, skipped_reasons: ($skip_reasons | split(",") | map(select(length>0))), verdict: $verdict, detail: ($detail | select(length>0) // null)}'
else
  printf 'commit: %s\n' "$commit"
  printf 'u_id: %s\n' "${u_id:-(none)}"
  printf 'peer-verdict trailers: %d' "$verdict_count"
  [ -n "$peer_verdict_value" ] && printf ' (verdict: %s)' "$peer_verdict_value"
  printf '\n'
  printf 'peer-resolution trailers: %d\n' "$res_count"
  printf 'peer-skipped trailers: %d\n' "$skip_count"
  printf 'review-verdict trailers: %d\n' "$rv_count"
  [ -n "$skip_reasons" ] && printf 'skipped reasons: %s\n' "$skip_reasons"
  printf 'verdict: %s\n' "$verdict"
  [ -n "$detail" ] && printf 'detail: %s\n' "$detail"
fi

case "$verdict" in
  ok) exit 0 ;;
  *) exit 1 ;;
esac
